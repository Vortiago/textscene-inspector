{
  "name": "@textscene/dev-kit",
  "version": "0.9.0",
  "private": true,
  "description": "Dev-only shared test helpers for the TextScene monorepo (never published)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@textscene/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "author": "Vortiago",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
