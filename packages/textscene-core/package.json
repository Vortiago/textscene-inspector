{
  "name": "@textscene/core",
  "version": "0.9.0",
  "private": true,
  "description": "Core library for parsing, linting, and rendering TSCN files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@textscene/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parser": {
      "@textscene/source": "./src/parser/index.ts",
      "types": "./dist/parser/index.d.ts",
      "import": "./dist/parser/index.js"
    },
    "./linter": {
      "@textscene/source": "./src/linter/index.ts",
      "types": "./dist/linter/index.d.ts",
      "import": "./dist/linter/index.js"
    },
    "./godot": {
      "@textscene/source": "./src/godot/index.ts",
      "types": "./dist/godot/index.d.ts",
      "import": "./dist/godot/index.js"
    },
    "./logger": {
      "@textscene/source": "./src/logger.ts",
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./resources/ResourceProvider": {
      "@textscene/source": "./src/resources/ResourceProvider.ts",
      "types": "./dist/resources/ResourceProvider.d.ts",
      "import": "./dist/resources/ResourceProvider.js"
    },
    "./resources/resourceProviderUtils": {
      "@textscene/source": "./src/resources/resourceProviderUtils.ts",
      "types": "./dist/resources/resourceProviderUtils.d.ts",
      "import": "./dist/resources/resourceProviderUtils.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "postbuild": "node scripts/copy-css-modules.mjs",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit --tsBuildInfoFile tsconfig.typecheck.tsbuildinfo",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.typecheck.tsbuildinfo"
  },
  "keywords": [
    "tscn",
    "textscene",
    "text-scene",
    "parser",
    "linter",
    "renderer",
    "three.js",
    "3d",
    "godot"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vortiago/textscene-inspector.git",
    "directory": "packages/textscene-core"
  },
  "homepage": "https://github.com/Vortiago/textscene-inspector#readme",
  "bugs": {
    "url": "https://github.com/Vortiago/textscene-inspector/issues"
  },
  "dependencies": {
    "fastnoise-lite": "catalog:",
    "@react-three/drei": "catalog:",
    "@react-three/fiber": "catalog:",
    "@react-three/postprocessing": "catalog:",
    "postprocessing": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:",
    "three-bvh-csg": "catalog:",
    "three-mesh-bvh": "catalog:"
  },
  "devDependencies": {
    "@react-three/test-renderer": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@textscene/dev-kit": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
