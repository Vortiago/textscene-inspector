; Calibrates Godot's editor preview lighting (ADR-0025). It has no DirectionalLight3D and no WorldEnvironment, so the harness injects both previews under Godot's yield rule.
; With --no-previews it renders black, as the running game does.
; The sphere floats above the plane, so the preview sun's shadow lands in open ground rather than under the caster.
[gd_scene load_steps=3 format=3]

[sub_resource type="PlaneMesh" id="Plane_1"]
size = Vector2(10, 10)

[sub_resource type="SphereMesh" id="Sphere_1"]

[node name="PreviewLighting" type="Node3D"]

[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("Plane_1")

[node name="Ball" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
mesh = SubResource("Sphere_1")
