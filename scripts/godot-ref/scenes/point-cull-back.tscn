; Twelve lit 8 px points of different shader features, then a 40 px unshaded green point at the centre.
; The features queue many pipelines, so the green point's pipeline lands late. While it compiles, Godot draws the
; ubershader, which culls by gl_FrontFacing, true for a point, so a cull-front point is missing from an early capture.
; The same scene with the default cull_mode, which the ubershader draws at once.
[gd_scene format=3]

[sub_resource type="StandardMaterial3D" id="Feature_0"]
emission_enabled = true
use_point_size = true
point_size = 8.0

[sub_resource type="PointMesh" id="Mesh_0"]
