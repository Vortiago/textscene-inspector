; Calibrates the sign of Godot's Decal depth fade, pow(1 - abs(uv_local.y), uv_local.y > 0 ? upper_fade : lower_fade), which no corpus scene separates: every blob shadow's receiver sits below its projector.
; uv_local.y = (receiver_y - decal_y) / (size.y / 2). Identical decals (size.y = 4, upper_fade = 0.0, lower_fade = 4.0) sit over receivers one unit above (left, +0.5) and below (right, -0.5) them.
; Godot renders the left plane saturated red, (1-0.5)^0 = 1.0, and the right almost bare grey, (1-0.5)^4 = 0.0625. Swapped exponents give the mirror image.
; Render with: pnpm ref:godot scripts/godot-ref/scenes/decal-fade-sign.tscn --camera 0,7,7 --look-at 0,0,0 --out /tmp/fade-sign.png
[gd_scene load_steps=5 format=3]

[sub_resource type="Gradient" id="Gradient_red"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 0, 0, 1, 1, 0, 0, 1)

; A flat red GradientTexture2D, not an ExtResource: a scene under scripts/godot-ref/scenes/ has no res:// root to resolve a sibling file against.
[sub_resource type="GradientTexture2D" id="Texture_red"]
gradient = SubResource("Gradient_red")
width = 64
height = 64

[sub_resource type="PlaneMesh" id="Plane_receiver"]
size = Vector2(3, 3)

[sub_resource type="StandardMaterial3D" id="Material_receiver"]
albedo_color = Color(0.35, 0.35, 0.35, 1)
roughness = 1.0

[node name="DecalFadeSign" type="Node3D"]

[node name="AboveReceiver" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.5, 1, 0)
mesh = SubResource("Plane_receiver")
surface_material_override/0 = SubResource("Material_receiver")

[node name="AboveDecal" type="Decal" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.5, 0, 0)
size = Vector3(3, 4, 3)
texture_albedo = SubResource("Texture_red")
albedo_mix = 1.0
upper_fade = 0.0
lower_fade = 4.0

[node name="BelowReceiver" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, -1, 0)
mesh = SubResource("Plane_receiver")
surface_material_override/0 = SubResource("Material_receiver")

[node name="BelowDecal" type="Decal" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, 0, 0)
size = Vector3(3, 4, 3)
texture_albedo = SubResource("Texture_red")
albedo_mix = 1.0
upper_fade = 0.0
lower_fade = 4.0
