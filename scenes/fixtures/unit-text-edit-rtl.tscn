; One variable: `layout_direction = 3` on a TextEdit. Each row is placed by its own shaped width
; (text_edit.cpp:1490-1494), so the three unequal lines fan out from the trailing edge, and the
; current-line highlight moves to the far side at its band width (:1404-1409). Full-width
; TextEdits make the rect mirror (control.cpp:1785) the identity. No other fixture pairs the two.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Ltr" type="TextEdit" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_top = 16.0
offset_bottom = 136.0
text = "Wave rift over quiet stone\nAmber\nSlow light across the shelf"
highlight_current_line = true

[node name="Rtl" type="TextEdit" parent="."]
layout_mode = 1
layout_direction = 3
anchor_right = 1.0
offset_top = 168.0
offset_bottom = 288.0
text = "Wave rift over quiet stone\nAmber\nSlow light across the shelf"
highlight_current_line = true
