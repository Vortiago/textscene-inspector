; One variable: a CanvasModulate over native Controls. Godot multiplies the canvas tint into every
; CanvasItem in the base pass, so the ColorRect, the Panel with a StyleBoxFlat and the Label each
; draw at their colour times the tint. No other golden tints a Control, and there is no light here.

[gd_scene format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.8, 0.6, 0.4, 1)
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 6
border_color = Color(0.9, 0.9, 0.5, 1)
corner_radius_top_left = 20
corner_radius_top_right = 20
corner_radius_bottom_right = 20
corner_radius_bottom_left = 20

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Rect" type="ColorRect" parent="."]
offset_left = 40.0
offset_top = 40.0
offset_right = 340.0
offset_bottom = 240.0
color = Color(0.8, 0.6, 0.4, 1)

[node name="Panel" type="Panel" parent="."]
offset_left = 380.0
offset_top = 40.0
offset_right = 680.0
offset_bottom = 240.0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Label" type="Label" parent="."]
offset_left = 720.0
offset_top = 110.0
offset_right = 1100.0
offset_bottom = 170.0
text = "Tinted label"
theme_override_colors/font_color = Color(0.9, 0.8, 0.7, 1)
theme_override_font_sizes/font_size = 48

[node name="Tint" type="CanvasModulate" parent="."]
color = Color(0.4, 0.6, 0.9, 1)
