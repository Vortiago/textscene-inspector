[gd_scene format=3]

; One variable against unit-sub-viewport-container-camera-2d.tscn: a CanvasLayer inside the
; camera's sub-viewport. Godot draws a layer's canvas through the layer's own transform, never the
; viewport's canvas transform the camera sets (`renderer_viewport.cpp:46-86`), so Badge stays at
; viewport pixels 20..140 x 20..80 while Band and Mark move with the camera. No other scene puts a
; CanvasLayer under a Camera2D.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

[node name="Booth" type="SubViewportContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 400.0
offset_bottom = 280.0
stretch = true

[node name="SubViewport" type="SubViewport" parent="Booth"]
size = Vector2i(200, 150)
render_target_update_mode = 4

[node name="Camera" type="Camera2D" parent="Booth/SubViewport"]
position = Vector2(500, 400)

[node name="Band" type="Polygon2D" parent="Booth/SubViewport"]
color = Color(0.5, 0.5, 0.5, 1)
polygon = PackedVector2Array(350, 300, 650, 300, 650, 340, 350, 340)

[node name="Mark" type="Polygon2D" parent="Booth/SubViewport"]
color = Color(1, 0.4, 0, 1)
polygon = PackedVector2Array(360, 380, 420, 380, 420, 410, 360, 410)

[node name="Hud" type="CanvasLayer" parent="Booth/SubViewport"]

[node name="Badge" type="Polygon2D" parent="Booth/SubViewport/Hud"]
color = Color(0, 0.8, 0.3, 1)
polygon = PackedVector2Array(20, 20, 140, 20, 140, 80, 20, 80)
