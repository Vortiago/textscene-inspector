; One variable: where the current tab sits in a clipped strip. A clipped TabBar scrolls so the
; current tab shows (tab_bar.cpp:1875-1920). The bars vary the current tab, the bar width, the
; alignment and the tab count. Every other tab scene keeps its current tab inside the first
; drawn tabs, so none shows a strip that starts past tab 0.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Cur0" type="TabBar" parent="."]
layout_mode = 0
offset_left = 8.0
offset_top = 8.0
offset_right = 268.0
offset_bottom = 44.0
current_tab = 0
clip_tabs = true
tab_count = 4
tab_0/title = "Inventory"
tab_1/title = "Equipment"
tab_2/title = "Journal"
tab_3/title = "Settings"

