[gd_scene format=3 uid="uid://unitvolfogskyshader"]

; unit-volumetric-fog-sky-ambient with a user's sky shader in place of the procedural sky. Godot's sky
; pass fogs a sky shader that does not set `disable_fog` with the volumetric fog (`sky.cpp:1148-1165`).
; No other golden draws a user's sky shader under volumetric fog.

[sub_resource type="Shader" id="Shader_sky"]
code = "shader_type sky;

uniform vec3 top_color : source_color = vec3(0.1, 0.3, 0.9);
uniform vec3 horizon_color : source_color = vec3(1.0, 0.6, 0.2);
uniform vec3 ground_color : source_color = vec3(0.05, 0.3, 0.1);

void sky() {
	float up = clamp(EYEDIR.y, -1.0, 1.0);
	vec3 sky = mix(horizon_color, top_color, pow(max(up, 0.0), 0.4));
	COLOR = up >= 0.0 ? sky : mix(horizon_color, ground_color, pow(-up, 0.3));
}
"

[sub_resource type="ShaderMaterial" id="Sky_mat"]
shader = SubResource("Shader_sky")

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Environment_1"]
background_mode = 2
sky = SubResource("Sky_1")
volumetric_fog_enabled = true
volumetric_fog_density = 0.05
volumetric_fog_anisotropy = 0.5
volumetric_fog_ambient_inject = 1.0
volumetric_fog_temporal_reprojection_enabled = false

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(2, 2, 2)

[sub_resource type="StandardMaterial3D" id="Material_1"]
shading_mode = 0
albedo_color = Color(0.9, 0.9, 0.9, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Dark" type="DirectionalLight3D" parent="."]
light_energy = 0.0
sky_mode = 1

[node name="BoxNear" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.5, 1, 2)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Material_1")

[node name="BoxFar" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 1, -12)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Material_1")

[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 8)
fov = 70.0
