; One variable: an [img] and an [hr] in a font file that maps no glyph to U+FFFC. Godot gives an
; embedded object a glyph of its own, as wide as the object, outside the HarfBuzz run
; (text_server_adv.cpp:7368-7387), so the text after it starts one object width later in any font.
; The bundled font maps U+FFFC to a glyph one em wide, so only a font file shows the rule.

[gd_scene format=3]

[ext_resource type="FontFile" path="res://fonts/montserrat-semibold-subset.ttf" id="1_font"]
[ext_resource type="Texture2D" path="res://textures/checkerboard-8px.svg" id="2_img"]

