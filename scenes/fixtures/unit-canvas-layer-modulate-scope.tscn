[gd_scene format=3]

; The one variable: whether an ancestor's `modulate` crosses a CanvasLayer. In Godot the layer squares
; stay white and the others go 0.25 grey: CanvasItem::get_parent_item() returns null under a layer.
; The Control walk and the Node2D dispatch publish that scope apart, so both are here.
; unit-canvas-layer tints nothing, and the modulate-cascade fixtures have no layer.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="TintedControl" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
modulate = Color(0.25, 0.25, 0.25, 1)

[node name="ControlOutside" type="ColorRect" parent="TintedControl"]
offset_left = 40.0
offset_top = 40.0
offset_right = 200.0
offset_bottom = 140.0
color = Color(1, 1, 1, 1)

[node name="ControlLayer" type="CanvasLayer" parent="TintedControl"]
layer = 1

[node name="ControlInLayer" type="ColorRect" parent="TintedControl/ControlLayer"]
offset_left = 240.0
offset_top = 40.0
offset_right = 400.0
offset_bottom = 140.0
color = Color(1, 1, 1, 1)

[node name="TintedNode2D" type="Node2D" parent="."]
modulate = Color(0.25, 0.25, 0.25, 1)

[node name="Node2DOutside" type="Polygon2D" parent="TintedNode2D"]
position = Vector2(40, 200)
polygon = PackedVector2Array(0, 0, 160, 0, 160, 100, 0, 100)
color = Color(1, 1, 1, 1)

[node name="Node2DLayer" type="CanvasLayer" parent="TintedNode2D"]
layer = 1

[node name="Node2DInLayer" type="Polygon2D" parent="TintedNode2D/Node2DLayer"]
position = Vector2(240, 200)
polygon = PackedVector2Array(0, 0, 160, 0, 160, 100, 0, 100)
color = Color(1, 1, 1, 1)
