; One variable: wrap_controls grows a centred Window to hold a Control larger than its loaded size.

[gd_scene format=3]

[node name="Root" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Bg" type="ColorRect" parent="."]
offset_right = 1152.0
offset_bottom = 648.0
color = Color(0.2, 0.3, 0.5, 1)

[node name="Win" type="Window" parent="."]
title = "Wrap"
initial_position = 1
size = Vector2i(200, 100)
wrap_controls = true

[node name="Big" type="ColorRect" parent="Win"]
