[gd_scene load_steps=3 format=3 uid="uid://unitgraphtitlenorm"]

; The title Label of a GraphNode or GraphFrame is a Label, so a Theme `normal` box on Label draws under the title, adds
; its margins to the title minimum size and offsets the title text (label.cpp:472-512,757-775,983-996). The Theme on each
; node is the one variable. A plain node and a plain frame sit beside them.

[sub_resource type="StyleBoxFlat" id="Title_normal"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 14.0
content_margin_bottom = 4.0
bg_color = Color(0.5, 0.25, 0.1, 1)

[sub_resource type="Theme" id="Theme_title"]
