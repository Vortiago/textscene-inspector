; One variable against unit-split-container.tscn: which axis VSplitContainer splits. There both
; children carry the same flags on the tested axis, so reading `size_flags_horizontal` or
; `size_flags_vertical` passes alike. Here the children expand vertically, and reading the
; horizontal flags takes the "neither expands" branch, pinning the boundary at split_offset (0).

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; Godot 4.6.3: top 144 | 12 | bottom 144, both expand, split_offset 0. Each column is 120 wide
; and 300 tall.
[node name="Both" type="VSplitContainer" parent="."]
offset_left = 20.0
offset_top = 20.0
offset_right = 140.0
offset_bottom = 320.0

[node name="BothTop" type="ColorRect" parent="Both"]
layout_mode = 2
size_flags_vertical = 3
color = Color(1, 0, 0, 1)

[node name="BothBottom" type="ColorRect" parent="Both"]
layout_mode = 2
size_flags_vertical = 3
color = Color(0, 1, 0, 1)

; Godot 4.6.3: top 194 | 12 | bottom 94, both expand, split_offset 50.
[node name="Offset" type="VSplitContainer" parent="."]
offset_left = 180.0
offset_top = 20.0
offset_right = 300.0
offset_bottom = 320.0
split_offset = 50

[node name="OffsetTop" type="ColorRect" parent="Offset"]
layout_mode = 2
size_flags_vertical = 3
color = Color(1, 0, 0, 1)

[node name="OffsetBottom" type="ColorRect" parent="Offset"]
layout_mode = 2
size_flags_vertical = 3
color = Color(0, 1, 0, 1)
