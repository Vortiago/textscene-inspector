; One variable: scroll_following = true on a RichTextLabel whose text exceeds its rect. The scroll
; value follows the text height (rich_text_label.cpp:3827-3828), which Range clamps to max - page
; (range.cpp:192-194), so the text shows its foot and the grabber sits at the bottom of the bar.
; Fits has text that fits its rect, so it shows the top and no bar. No other scene sets
; scroll_following.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.12, 0.2, 1)

[node name="FollowBox" type="ColorRect" parent="."]
offset_left = 40.0
offset_top = 20.0
offset_right = 200.0
offset_bottom = 60.0
color = Color(0.2, 0.2, 0.32, 1)

[node name="Follow" type="RichTextLabel" parent="."]
offset_left = 40.0
offset_top = 20.0
offset_right = 200.0
offset_bottom = 60.0
text = "Wave rift over quiet stone and amber light"
scroll_following = true

[node name="FitsBox" type="ColorRect" parent="."]
offset_left = 40.0
offset_top = 100.0
offset_right = 200.0
offset_bottom = 180.0
color = Color(0.2, 0.2, 0.32, 1)

[node name="Fits" type="RichTextLabel" parent="."]
offset_left = 40.0
offset_top = 100.0
offset_right = 200.0
offset_bottom = 180.0
text = "Wave rift over quiet stone and amber light"
scroll_following = true

[node name="LongBox" type="ColorRect" parent="."]
offset_left = 240.0
offset_top = 20.0
offset_right = 400.0
offset_bottom = 80.0
color = Color(0.2, 0.2, 0.32, 1)

[node name="Long" type="RichTextLabel" parent="."]
offset_left = 240.0
offset_top = 20.0
offset_right = 400.0
offset_bottom = 80.0
text = "Wave rift over quiet stone and amber light across the sleeping harbour at the end of day, again and again until the lamps go out"
scroll_following = true
