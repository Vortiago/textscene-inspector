; clear_button_enabled is the one variable. The button draws only while the field has text
; (`!using_placeholder && is_editable()`), so this fixture also proves the draw-time gate. No
; other LineEdit fixture sets it, so always or never drawing the icon is invisible elsewhere.

[gd_scene format=3 uid="uid://unitlineeditclearbutton"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="WithText" type="LineEdit" parent="."]
layout_mode = 0
offset_left = 24.0
offset_top = 24.0
offset_right = 224.0
offset_bottom = 48.0
text = "Clearable"
clear_button_enabled = true
