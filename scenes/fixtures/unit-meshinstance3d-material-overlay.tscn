[gd_scene load_steps=5 format=3]

; One variable: whether `material_overlay` draws a second time over the surface material rather
; than replacing it or doing nothing. `_geometry_instance_add_surface` resolves the surface's own
; material chain, then adds a surface for the overlay (`render_forward_clustered.cpp:4228-4241`),
; so the overlay composites over the surface. No corpus scene sets `material_overlay`.

[sub_resource type="BoxMesh" id="BoxMesh_body"]
size = Vector3(1.6, 1.6, 1.6)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_surface"]
albedo_color = Color(0.1, 0.75, 0.2, 1)
roughness = 0.55

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_overlay"]
transparency = 1
albedo_color = Color(0.9, 0.1, 0.05, 0.55)
roughness = 0.3

[node name="MaterialOverlay" type="Node3D"]

; The control, with only its surface material: it keeps a whole-scene tint from reading as success.
[node name="Surface" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.15, 0, 0)
mesh = SubResource("BoxMesh_body")
surface_material_override/0 = SubResource("StandardMaterial3D_surface")

; The same surface material plus a half-transparent red overlay. Green means the overlay never
; drew, opaque red that it replaced the surface, muddied red over green that it composited. An
; opaque overlay looks the same composited or replaced. Its alpha also puts it in the alpha pass,
; where draw order is most likely to regress.
[node name="SurfacePlusOverlay" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.15, 0, 0)
mesh = SubResource("BoxMesh_body")
surface_material_override/0 = SubResource("StandardMaterial3D_surface")
material_overlay = SubResource("StandardMaterial3D_overlay")
