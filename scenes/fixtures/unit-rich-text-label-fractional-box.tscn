; One variable: a fractional control width under an aligned RichTextLabel. `_draw_line` measures
; `get_line_size(line).x` (rich_text_label.cpp:984), the ceiled shaped extent
; (text_server_adv.cpp:7524-7537), and aligns it against `int p_width` (rich_text_label.h:672,678),
; truncated once from the control rect.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.12, 0.2, 1)

; Measuring the raw pen advance is invisible at a whole width, since flooring absorbs the
; fraction, and every other RichTextLabel fixture is whole. "Threat level" at 16px is 91.03125 raw
; and 92 ceiled, so at width 201.5 the RIGHT arm lands on 109, not 110, and CENTER on 54, not 55.
[node name="FractionalRight" type="RichTextLabel" parent="."]
layout_mode = 1
offset_left = 40.0
offset_right = 241.5
offset_top = 40.0
offset_bottom = 80.0
autowrap_mode = 0
horizontal_alignment = 2
text = "Threat level"

; The same variable through the other arm. autowrap is off so the line cannot wrap, and the box
; is tall enough that no scrollbar narrows it.
[node name="FractionalCenter" type="RichTextLabel" parent="."]
layout_mode = 1
offset_left = 40.0
offset_right = 241.5
offset_top = 100.0
offset_bottom = 140.0
autowrap_mode = 0
horizontal_alignment = 1
text = "Threat level"
