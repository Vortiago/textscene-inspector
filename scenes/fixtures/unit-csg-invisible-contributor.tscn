[gd_scene format=3]

; One variable: what an invisible CSG contributor adds to the scene bounds. `_get_brush()`
; skips an invisible child before recursing (`modules/csg/csg_shape.cpp:469`), so its
; `node_aabb` is never written and Godot frames a point at its origin. `--emit-bounds`:
; position (-0.5, -0.5, -0.5), size (8.5, 1, 1).

[node name="InvisibleContributor" type="CSGCombiner3D"]

[node name="Kept" type="CSGBox3D" parent="."]
size = Vector3(1, 1, 1)

; Four times the visible box and far off-axis, so counting its solid moves the framing centre
; from x = 3.75 to x = 4.75. Bounds ignore `visible` elsewhere, because `get_aabb()` reports an
; invisible MeshInstance3D's full box. CSG builds its AABB rather than reading it, so it is the
; one type where hiding changes the answer.
[node name="Hidden" type="CSGBox3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 8, 0, 0)
visible = false
size = Vector3(4, 4, 4)
