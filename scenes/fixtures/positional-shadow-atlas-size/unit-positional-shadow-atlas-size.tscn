; One variable: the project's positional shadow atlas size, 512 in place of 4096. Godot gives the
; root viewport that atlas, so the spot light's shadow map is coarser and its edge steps. Every other
; fixture runs with no project setting, so the root atlas stays at 4096 there.

[gd_scene format=3]

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(1, 1, 1)

[sub_resource type="PlaneMesh" id="PlaneMesh_1"]
size = Vector2(12, 12)

[sub_resource type="StandardMaterial3D" id="Mat_1"]
albedo_color = Color(0.8, 0.8, 0.8, 1)

[node name="Root" type="Node3D"]

[node name="Floor" type="MeshInstance3D" parent="."]
mesh = SubResource("PlaneMesh_1")
surface_material_override/0 = SubResource("Mat_1")

[node name="Box" type="MeshInstance3D" parent="."]
transform = Transform3D(0.707107, 0, 0.707107, 0, 1, 0, -0.707107, 0, 0.707107, 0, 0.5, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Mat_1")

[node name="SpotLight3D" type="SpotLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.5, 0.866025, 0, -0.866025, 0.5, 0, 5, 3)
light_energy = 2.0
shadow_enabled = true
shadow_blur = 0.0
spot_range = 14.0
spot_angle = 50.0
