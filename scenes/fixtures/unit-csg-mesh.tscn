[gd_scene load_steps=4 format=3 uid="uid://unitcsgmesh"]

; CSGMesh3D has no witness in the vendored corpus, so this fixture follows the class reference
; (csg_shape.cpp:1125-1300, CSGMesh3D.xml): `mesh` is any Mesh, and `material` replaces the
; mesh's own surface material (csg_shape.cpp:1167-1172) rather than overriding per surface.
; PlaneMesh and QuadMesh are absent: the property hint excludes them as not manifold (csg_shape.cpp:1298).

[sub_resource type="BoxMesh" id="BoxMesh_csg"]
size = Vector3(1.5, 1, 1.5)

[sub_resource type="CapsuleMesh" id="CapsuleMesh_csg"]
radius = 0.4
height = 1.6

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_csgmesh"]
albedo_color = Color(0.3, 0.6, 0.8, 1)

[node name="CSGMeshRoot" type="Node3D"]

[node name="BoxFromMesh" type="CSGMesh3D" parent="."]
