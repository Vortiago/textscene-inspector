[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; GraphEdit's draw order of its children. `add_child_notify` moves each GraphFrame to index 0 and
; the connection layer to the index after the frames (`graph_edit.cpp:714-717`), so frames draw in reverse
; scene order, the connection over every frame, and GraphNodes over the connection. The children
; are listed GraphNode, frame, GraphNode, frame, so a walk in scene order shows the difference.

[node name="Graph" type="GraphEdit" parent="."]
