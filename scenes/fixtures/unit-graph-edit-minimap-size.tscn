; GraphEdit's minimap at a NON-default size. The minimap is a bottom-right
; anchored panel whose four offsets are rebuilt from the size
; (graph_edit.cpp:2773-2778), so a regression that keeps the constructor's
; 240x160 — or that anchors from the wrong corner — still lands in the right
; corner at the default and is invisible in every other scene. The size also
; drives the minimap's own graph-to-panel letterboxing (:86-99), so the node
; rect inside it moves too.
; Every fixture in this family shares one GraphEdit rect and one GraphNode,
; and `scroll_offset` is deliberately ABSENT from all but
; unit-graph-edit-scroll-offset-clamped.tscn, which exists to move it:
; GraphEdit's own `set_scroll_offset` clamps against min/max bounds no laid-out
; child has widened while a scene's properties are applied (graph_edit.cpp:407),
; so an authored offset moves the grid, the nodes AND the minimap camera at once
; and would mask the one variable each file exists to move.

[gd_scene load_steps=1 format=3 uid="uid://unitgraphedminsize"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Graph" type="GraphEdit" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 408.0
offset_bottom = 328.0
minimap_size = Vector2(120, 90)

[node name="Source" type="GraphNode" parent="Graph"]
offset_right = 120.0
offset_bottom = 64.0
position_offset = Vector2(40, 56)
title = "Add"

[node name="Value" type="Label" parent="Graph/Source"]
layout_mode = 2
text = "Value"
