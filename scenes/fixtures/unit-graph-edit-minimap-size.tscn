; GraphEdit's minimap at a non-default size. The minimap is a bottom-right anchored panel whose
; four offsets derive from the size (graph_edit.cpp:2773-2778), so keeping the constructor's
; 240x160, or anchoring from the wrong corner, is invisible at the default. The size also drives
; the minimap's graph-to-panel letterboxing (:86-99), so the node rect inside it moves too.

[gd_scene load_steps=1 format=3 uid="uid://unitgraphedminsize"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; No `scroll_offset`, as in the whole family: unit-graph-edit-family.md says why.
[node name="Graph" type="GraphEdit" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 408.0
offset_bottom = 328.0
minimap_size = Vector2(120, 90)

[node name="Source" type="GraphNode" parent="Graph"]
offset_right = 120.0
offset_bottom = 64.0
position_offset = Vector2(40, 56)
title = "Add"

[node name="Value" type="Label" parent="Graph/Source"]
layout_mode = 2
text = "Value"
