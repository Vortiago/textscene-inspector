[gd_scene format=3 uid="uid://unit_standard_material_orm_alpha_lit"]

; What it holds: an ORMMaterial3D with toon specular, drawn on a split ORM map (left half metal, right half dielectric), and a
; StandardMaterial3D with alpha 0.5 and specular disabled, over a ground with no material. A shadowed sun and a colour ambient
; light light them. They draw through Godot's generated shader and the lit scene template (?litSurface=nodes). The glass casts no shadow.
; Every other material golden draws the classic path, so only this one shows a regression in these features on the node path.

[ext_resource type="Texture2D" path="res://textures/orm-split.png" id="1_orm_split"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_glass"]
transparency = 1
albedo_color = Color(0.3, 0.6, 0.9, 0.5)
roughness = 0.3
specular_mode = 2

[sub_resource type="ORMMaterial3D" id="ORMMaterial3D_split"]
albedo_color = Color(0.85, 0.85, 0.9, 1)
specular_mode = 1
orm_texture = ExtResource("1_orm_split")

[sub_resource type="SphereMesh" id="SphereMesh_ball"]
radius = 0.5
height = 1.0

[sub_resource type="PlaneMesh" id="PlaneMesh_ground"]
size = Vector2(4, 4)

[sub_resource type="Environment" id="Environment_1"]
