[gd_scene load_steps=5 format=3 uid="uid://unitdecaltriangulation"]

; One variable: the floor's subdivision, 0 on the left (two triangles) and 13 by 7 on the right.
; Godot mixes a decal per fragment, so both floors show the same checkerboard. A decal mixed per
; vertex draws a different footprint on each, since the box edges cross the triangles.

[ext_resource type="Texture2D" path="res://textures/checkerboard.svg" id="1_albedo"]

[sub_resource type="PlaneMesh" id="PlaneMesh_coarse"]
size = Vector2(3.5, 3.5)

[sub_resource type="PlaneMesh" id="PlaneMesh_fine"]
size = Vector2(3.5, 3.5)
subdivide_width = 13
subdivide_depth = 7

[sub_resource type="StandardMaterial3D" id="Material_floor"]
albedo_color = Color(0.5, 0.5, 0.5, 1)

[node name="Scene" type="Node3D"]

[node name="Camera3D" type="Camera3D" parent="."]
