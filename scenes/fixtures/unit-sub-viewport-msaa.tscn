; A SubViewport's own msaa_3d at 8X. Every other golden's viewports run at Godot's default,
; Disabled, so only this one shows a sub-viewport resolving its edge coverage before the container
; draws the target. The reference and the capture both draw 4 samples: lavapipe and SwiftShader
; list no 8, and Godot falls to the closest lower count. One unshaded box, tilted so every
; silhouette edge is diagonal, leaves nothing but the edge ramp to measure.

[gd_scene format=3]

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(1.6, 1.6, 1.6)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_1"]
shading_mode = 0

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Booth" type="SubViewportContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 500.0
offset_bottom = 380.0

[node name="SubViewport" type="SubViewport" parent="Booth"]
size = Vector2i(400, 300)
msaa_3d = 3
render_target_update_mode = 4

[node name="Camera3D" type="Camera3D" parent="Booth/SubViewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 3.5)
current = true

[node name="Box" type="MeshInstance3D" parent="Booth/SubViewport"]
transform = Transform3D(0.866025, -0.25, 0.433013, 0.5, 0.433013, -0.75, 0, 0.866025, 0.5, 0, 0, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("StandardMaterial3D_1")
