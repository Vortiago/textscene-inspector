[gd_scene load_steps=3 format=3]

; One variable: the substituted settle window. This emitter authors no `preprocess`, so the
; previewer substitutes one lifetime, the point a continuous emitter reaches steady state.
; Every other emitter fixture authors `preprocess`, so none of them asks for the substitution.

[ext_resource type="Texture2D" path="res://textures/pong-ball.png" id="1_ball"]

[sub_resource type="Gradient" id="Gradient_spray"]
offsets = PackedFloat32Array(0, 0.6, 1)
colors = PackedColorArray(0.55, 0.85, 1, 1, 0.2, 0.5, 0.95, 1, 0.05, 0.15, 0.5, 0)

[node name="Root" type="Node2D"]

[node name="Backdrop" type="Polygon2D" parent="."]
color = Color(0.08, 0.08, 0.1, 1)
polygon = PackedVector2Array(320, 68, 832, 68, 832, 580, 320, 580)

; The settle is 0.95 s in whole `fixed_fps` frames at `speed_scale` 1, the last one
; overshooting: 28.5 steps at 30 fps become 29, landing at 0.9667 s. The window is not a
; multiple of the step, which is the only way the overshoot shows. Reference render:
; `pnpm ref:godot scenes/fixtures/unit-cpuparticles2d-unpreprocessed.tscn --mode 2d --particles 0.95`
[node name="Spray" type="CPUParticles2D" parent="."]
position = Vector2(576, 300)
amount = 40
texture = ExtResource("1_ball")
; `--particles` hands 0.95 to `request_particles_process`, which Godot spends through the loop
; it spends `preprocess` through, so both sides name the same instant.
lifetime = 0.95
; `use_fixed_seed`, `seed` and `fixed_fps` stop the reference drawing a different plume every
; run. unit-cpuparticles2d-unseeded.tscn owns the substituted seed.
use_fixed_seed = true
seed = 808
fixed_fps = 30
local_coords = true
emission_shape = 1
emission_sphere_radius = 8.0
direction = Vector2(0, 1)
spread = 35.0
gravity = Vector2(0, 120)
initial_velocity_min = 60.0
initial_velocity_max = 140.0
scale_amount_min = 2.0
scale_amount_max = 4.0
color_ramp = SubResource("Gradient_spray")
