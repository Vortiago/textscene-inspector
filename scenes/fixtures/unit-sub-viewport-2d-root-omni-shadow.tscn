; One variable: a 3D SubViewport under a 2D root, lit by an OmniLight3D that casts a shadow. Godot
; draws the shadows of a SubViewport whatever the root is, so the box shadows the floor. The 2D
; canvas's renderer must turn its shadow map on and copy the omni cube into the atlas. No other scene
; shows it: every other SubViewport whose 3D light casts a shadow draws on the 3D canvas.

[gd_scene format=3]

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(1, 1, 1)

[sub_resource type="PlaneMesh" id="PlaneMesh_1"]
size = Vector2(8, 8)

[sub_resource type="StandardMaterial3D" id="Mat_1"]
albedo_color = Color(0.8, 0.8, 0.8, 1)

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Booth" type="SubViewportContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 500.0
offset_bottom = 380.0

[node name="SubViewport" type="SubViewport" parent="Booth"]
size = Vector2i(400, 300)
render_target_update_mode = 4

[node name="Camera3D" type="Camera3D" parent="Booth/SubViewport"]
transform = Transform3D(1, 0, 0, 0, 0.819152, 0.573576, 0, -0.573576, 0.819152, 0, 3, 4)
current = true

[node name="Floor" type="MeshInstance3D" parent="Booth/SubViewport"]
mesh = SubResource("PlaneMesh_1")
surface_material_override/0 = SubResource("Mat_1")

[node name="Box" type="MeshInstance3D" parent="Booth/SubViewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Mat_1")

[node name="OmniLight3D" type="OmniLight3D" parent="Booth/SubViewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, 2.5, 1)
light_energy = 3.0
shadow_enabled = true
omni_range = 10.0
