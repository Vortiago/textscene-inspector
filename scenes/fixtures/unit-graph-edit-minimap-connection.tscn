; GraphEdit whose minimap draws a connection at the default antialiasing. `GraphEditMinimap`
; redraws each connection with `draw_polyline_colors(points, colors, 0.5, lines_antialiased)`
; (graph_edit.cpp:1611), the only reader of `connection_lines_antialiased` (graph_edit.h:254,
; default true).

[gd_scene load_steps=1 format=3 uid="uid://unitgraphedminiconn"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; At width 0.5 the antialiased branch adds a feather of FEATHER_SIZE * width = 0.625px each side
; plus a cap at each end (renderer_canvas_cull.cpp:1030-1163), most of the line's drawn area.
; unit-graph-edit.tscn, the only other scene with a connection, sets the property false, so no
; other fixture draws the feathered branch.
[node name="Graph" type="GraphEdit" parent="."]
; No `scroll_offset`, as in the whole family: unit-graph-edit-family.md says why.
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 408.0
offset_bottom = 328.0
connections = [{ "from_node": &"Source", "from_port": 0, "to_node": &"Sink", "to_port": 0, "keep_alive": true }]

; Two GraphNodes, one right port and one left port, are the minimum a resolvable connection needs.
[node name="Source" type="GraphNode" parent="Graph"]
offset_right = 120.0
offset_bottom = 64.0
position_offset = Vector2(40, 56)
title = "Add"
slot/0/right_enabled = true
slot/0/right_color = Color(0.4, 0.7, 1, 1)

[node name="Value" type="Label" parent="Graph/Source"]
layout_mode = 2
text = "Value"

[node name="Sink" type="GraphNode" parent="Graph"]
offset_right = 120.0
offset_bottom = 64.0
position_offset = Vector2(220, 56)
title = "Print"
slot/0/left_enabled = true
slot/0/left_color = Color(0.4, 0.7, 1, 1)

[node name="Result" type="Label" parent="Graph/Sink"]
layout_mode = 2
text = "Result"
