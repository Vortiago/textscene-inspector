[gd_scene load_steps=4 format=3 uid="uid://edge_mixed_resource_missing"]

; Four MeshInstance3D nodes, each missing a different resource dimension —
; all lint-safe (no rule inspects a StandardMaterial3D's OWN texture
; references, or requires material_override at all):
;   - NoMesh: `mesh` omitted entirely -> magenta wireframe placeholder.
;   - NoMaterial: valid mesh, `material_override` omitted -> default grey
;     material (Godot/renderer parity — no material is a normal, not an
;     error, state).
;   - NoTexture: valid mesh + a material whose `albedo_texture` points at a
;     real (declared) ExtResource path that doesn't exist on disk — the
;     established "missing resource" convention (see unit-external-missing.tscn)
;     — the material falls back to its color, no texture slot resolves.
;   - Baseline: valid mesh + valid material, for visual contrast.

[ext_resource type="Texture2D" path="res://textures/this_texture_does_not_exist.png" id="1_missing_tex"]

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(1, 1, 1)

[sub_resource type="StandardMaterial3D" id="Material_no_texture"]
albedo_color = Color(0.6, 0.2, 0.7, 1)
albedo_texture = ExtResource("1_missing_tex")

[sub_resource type="StandardMaterial3D" id="Material_baseline"]
albedo_color = Color(0.2, 0.7, 0.3, 1)

[node name="Scene" type="Node3D"]

[node name="NoMesh" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3, 0, 0)

[node name="NoMaterial" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1, 0, 0)
mesh = SubResource("BoxMesh_1")

[node name="NoTexture" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1, 0, 0)
mesh = SubResource("BoxMesh_1")
material_override = SubResource("Material_no_texture")

[node name="Baseline" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 0, 0)
mesh = SubResource("BoxMesh_1")
material_override = SubResource("Material_baseline")
