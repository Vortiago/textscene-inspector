; The one variable: `material_override` on a MeshInstance3D with an external ArrayMesh `.tres`.
; Godot puts it ahead of every surface's material (render_forward_clustered.cpp:4206), so both
; right plates read orange: all blue means it missed the ArrayMesh, half orange only surface 0.
; The other override fixtures drive a BoxMesh, and no other ArrayMesh fixture sets it.
[gd_scene load_steps=3 format=3 uid="uid://unitarraymeshmatoverride"]

[ext_resource type="ArrayMesh" path="res://unit-arraymesh-own-material-quad.tres" id="1_quad"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_override"]
resource_name = "override_body"
albedo_color = Color(0.9, 0.45, 0.1, 1)
metallic = 0.0
roughness = 0.5

[node name="Root" type="Node3D"]

[node name="ControlQuads" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.3, 0, 0)
mesh = ExtResource("1_quad")

[node name="OverriddenQuads" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.3, 0, 0)
mesh = ExtResource("1_quad")
material_override = SubResource("StandardMaterial3D_override")

[node name="Title" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.8, 0)
text = "External ArrayMesh: surface materials vs material_override"
pixel_size = 0.006
billboard = 1
modulate = Color(1, 1, 0.7, 1)

[node name="Description" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1.8, 0)
text = "Left plates blue; BOTH right plates orange"
pixel_size = 0.005
billboard = 1
modulate = Color(1, 1, 1, 1)
