; ONE VARIABLE: `material_override` on a MeshInstance3D whose mesh is an
; EXTERNAL ArrayMesh `.tres`.
;
; Both instances share unit-arraymesh-own-material-quad.tres — two blue plates
; carrying their own surface materials, one by ExtResource to a shared file and
; one by a `[sub_resource]` of the mesh's own `.tres`. The LEFT instance is the
; control and keeps them. The RIGHT instance adds `material_override`, which
; Godot takes ahead of the material the surface chose
; (render_forward_clustered.cpp:4206) and applies to EVERY surface — so both of
; its plates must read orange.
;
; The two failure shapes are distinguishable on sight: an all-blue right
; instance is the override never reaching the ArrayMesh branch, a half-orange
; one is it reaching only surface 0.
;
; Nothing else in the bag sees this. `material-override` and
; `surface-material-override` both drive a primitive BoxMesh, whose material
; slots are built from the override map itself, and every other ArrayMesh
; fixture leaves `material_override` unset.
[gd_scene load_steps=3 format=3 uid="uid://unitarraymeshmatoverride"]

[ext_resource type="ArrayMesh" path="res://unit-arraymesh-own-material-quad.tres" id="1_quad"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_override"]
resource_name = "override_body"
albedo_color = Color(0.9, 0.45, 0.1, 1)
metallic = 0.0
roughness = 0.5

[node name="Root" type="Node3D"]

[node name="ControlQuads" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.3, 0, 0)
mesh = ExtResource("1_quad")

[node name="OverriddenQuads" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.3, 0, 0)
mesh = ExtResource("1_quad")
material_override = SubResource("StandardMaterial3D_override")

[node name="Title" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.8, 0)
text = "External ArrayMesh: surface materials vs material_override"
pixel_size = 0.006
billboard = 1
modulate = Color(1, 1, 0.7, 1)

[node name="Description" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1.8, 0)
text = "Left plates blue; BOTH right plates orange"
pixel_size = 0.005
billboard = 1
modulate = Color(1, 1, 1, 1)
