; Direct light, isolated: the fixture that pins `LIGHT_INTENSITY_SCALE`. A white
; DirectionalLight3D at energy 1.0 points straight down at a Lambertian plane, so N·L is 1.
; Godot's diffuse is `albedo · N·L · colour · energy` (energy times PI in `light_storage.cpp`,
; divided by PI again in the Lambert), so the surface renders exactly its own albedo.
[gd_scene load_steps=6 format=3]

[sub_resource type="Environment" id="Env_1"]
background_mode = 1
background_color = Color(0.05, 0.06, 0.08, 1)
ambient_light_source = 1
tonemap_mode = 0

[sub_resource type="PlaneMesh" id="Ground_1"]
size = Vector2(8, 8)

[sub_resource type="PlaneMesh" id="Patch_1"]
size = Vector2(2.5, 2.5)

; `diffuse_mode = 1` (Lambert): Godot's default Burley diverges from three's Lambert at grazing
; angles and would add a view-dependent term to a constant measurement.
[sub_resource type="StandardMaterial3D" id="Lit_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
metallic = 0.0
roughness = 1.0
diffuse_mode = 1

[sub_resource type="StandardMaterial3D" id="Unshaded_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
shading_mode = 0

[node name="LightTransportDirect" type="Node3D"]

; Nothing but the sun contributes: ambient is disabled, the background is a flat colour that
; doubles as an sRGB round-trip check, and the tonemapper is LINEAR, so no curve applies. The
; sun and the WorldEnvironment each suppress one of Godot's editor previews (ADR-0025).
[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

; Basis rows (1,0,0) (0,0,1) (0,-1,0) put the local Z axis at +Y, so the light
; travels along local -Z = straight down and N·L on the ground is exactly 1.
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 0, 5, 0)

[node name="LitGround" type="MeshInstance3D" parent="."]
mesh = SubResource("Ground_1")
surface_material_override/0 = SubResource("Lit_1")

; The albedo, drawn unshaded. When the direct-light scale is right the square is invisible
; against the lit ground. A visible square is a wrong scale, readable without a reference image.
[node name="UnshadedReference" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.01, 0)
mesh = SubResource("Patch_1")
surface_material_override/0 = SubResource("Unshaded_1")
