[gd_scene format=3]

; MyColorPicker draws every row at Godot's defaults (HSV rectangle, RGB mode), so a regression in one
; row shows beside tested rows. Its alpha 0.8 shows the checkerboard. MyColorPickerOkhsl moves
; `color_mode = 3` (OKHSL) with only the slider grid on. `can_add_swatches` and `deferred_mode` are
; non-default for grammar coverage only.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="MyColorPicker" type="ColorPicker" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 408.0
offset_bottom = 708.0
color = Color(0.2, 0.4, 0.6, 0.8)
picker_shape = 0
deferred_mode = true
can_add_swatches = false

[node name="MyColorPickerOkhsl" type="ColorPicker" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 716.0
offset_right = 408.0
offset_bottom = 916.0
color = Color(0.2, 0.4, 0.6, 1.0)
picker_shape = 4
color_mode = 3
sampler_visible = false
color_modes_visible = false
hex_visible = false
presets_visible = false
