; One variable: `layout_direction = 3` on a RichTextLabel. `_draw_line`'s alignment switch
; (rich_text_label.cpp:987-1014) branches on the paragraph direction, `l.text_buf->get_direction()`
; from `_find_direction` (:599,3507-3525), which returns is_layout_rtl() only while
; `text_direction` is inherited. Its default is TEXT_DIRECTION_AUTO (rich_text_label.h:615).
[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.12, 0.2, 1)

; So `layout_direction` alone reaches none of those arms, and each RTL row lands where its LTR
; twin does. Full-width labels make the rect mirror (control.cpp:1785) the identity. No other
; fixture pairs a RichTextLabel with a direction.
[node name="LtrLeft" type="RichTextLabel" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_top = 16.0
offset_bottom = 56.0
bbcode_enabled = true
text = "Wave rift"

[node name="LtrCenter" type="RichTextLabel" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_top = 64.0
offset_bottom = 104.0
bbcode_enabled = true
text = "[center]Wave rift[/center]"

[node name="LtrRight" type="RichTextLabel" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_top = 112.0
offset_bottom = 152.0
bbcode_enabled = true
text = "[right]Wave rift[/right]"

[node name="RtlLeft" type="RichTextLabel" parent="."]
layout_mode = 1
layout_direction = 3
anchor_right = 1.0
offset_top = 200.0
offset_bottom = 240.0
bbcode_enabled = true
text = "Wave rift"

[node name="RtlCenter" type="RichTextLabel" parent="."]
layout_mode = 1
layout_direction = 3
anchor_right = 1.0
offset_top = 248.0
offset_bottom = 288.0
bbcode_enabled = true
text = "[center]Wave rift[/center]"

[node name="RtlRight" type="RichTextLabel" parent="."]
