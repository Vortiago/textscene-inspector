[gd_scene format=3 uid="uid://unitskylightstep"]

; A ProceduralSkyMaterial in Automatic mode, which reads its sun and so bakes Incremental, under a
; mirror ball and a rough ball. The clip turns the Sky Only sun at 0.3 s, and the golden seeks 1.0 s.
; The one variable is the sun in the radiance: the balls show the turned sun, baked again in place.
; No other golden turns a sun after the sky's first bake.

[sub_resource type="ProceduralSkyMaterial" id="SkyMat"]
sun_angle_max = 20.0

[sub_resource type="Sky" id="Sky_main"]
sky_material = SubResource("SkyMat")

[sub_resource type="Environment" id="Environment_stage"]
background_mode = 2
sky = SubResource("Sky_main")
ambient_light_source = 2
ambient_light_color = Color(0.6, 0.6, 0.6, 1)
ambient_light_sky_contribution = 0.0
tonemap_mode = 4

[sub_resource type="SphereMesh" id="SphereMesh_ball"]
radius = 0.9
height = 1.8
radial_segments = 64
rings = 32

[sub_resource type="StandardMaterial3D" id="Mirror"]
albedo_color = Color(0.9, 0.9, 0.9, 1)
metallic = 1.0
roughness = 0.0

[sub_resource type="StandardMaterial3D" id="Rough"]
albedo_color = Color(0.9, 0.9, 0.9, 1)
metallic = 1.0
roughness = 0.5

[sub_resource type="Animation" id="Animation_clock"]
resource_name = "clock"
length = 5.0
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Sun:rotation")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.3),
"transitions": PackedFloat32Array(1, 1),
"update": 1,
"values": [Vector3(-0.6, 0, 0), Vector3(-0.9, 2.0, 0)]
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_clock"]
_data = {
&"clock": SubResource("Animation_clock")
}

[node name="Root" type="Node3D"]

[node name="MirrorBall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1, 0.6, 0)
mesh = SubResource("SphereMesh_ball")
surface_material_override/0 = SubResource("Mirror")

[node name="RoughBall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1, 0.6, 0)
mesh = SubResource("SphereMesh_ball")
surface_material_override/0 = SubResource("Rough")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.825336, 0.564642, 0, -0.564642, 0.825336, 0, 0, 0)
sky_mode = 2
light_color = Color(1, 0.8, 0.6, 1)
light_energy = 1.5
light_angular_distance = 10.0
light_energy = 2.0

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.6, 4.2)

[node name="Clock" type="AnimationPlayer" parent="."]
libraries = {
&"": SubResource("AnimationLibrary_clock")
}
autoplay = &"clock"

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_stage")
