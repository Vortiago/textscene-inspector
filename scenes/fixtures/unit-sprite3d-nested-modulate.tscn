[gd_scene load_steps=2 format=3 uid="uid://unitsprite3dnestmod"]

; One variable: what a Sprite3D's parent adds to its drawn colour,
; `SpriteBase3D::_get_color_accum()` (`scene/3d/sprite_3d.cpp:36-52`). The walk reads only the
; immediate parent (`:75` casts `get_parent()` to SpriteBase3D and stops), so a Sprite3D under a
; Node3D accumulates from white, as a renderer ignoring the rule draws. Nothing else nests sprites.

[ext_resource type="Texture2D" path="res://textures/sprite2d-marker.png" id="1_sprite_tex"]

[node name="Scene" type="Node3D"]

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 7)
fov = 70.0

[node name="Title" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.6, 0)
text = "control / nested / via Node3D / via Label3D"
pixel_size = 0.005

; All four columns carry the same child modulate. This control column shows it unaccumulated,
; and only the second may differ from it. The two modulates differ in every channel and alpha and
; neither equals the product, so an RGB-only or skipped accumulation reads as a different picture.
[node name="Control_Parent" type="Sprite3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.6, 1.5, 0)
texture = ExtResource("1_sprite_tex")
pixel_size = 0.01
modulate = Color(1, 1, 1, 1)

[node name="Control_Child" type="Sprite3D" parent="Control_Parent"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1.1, 0)
texture = ExtResource("1_sprite_tex")
pixel_size = 0.01
modulate = Color(0.5, 0.9, 0.6, 0.7)

