; One variable against unit-sub-viewport-container.tscn: `stretch = true`. Measured through
; Godot 4.6.3, the surface fills the container's 300x200, because `recalc_force_viewport_sizes`
; overwrites the child viewport's size with `get_size() / stretch_shrink`. The authored
; `size = Vector2i(200, 150)` is dead.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

[node name="Booth" type="SubViewportContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 400.0
offset_bottom = 280.0
stretch = true

[node name="SubViewport" type="SubViewport" parent="Booth"]
size = Vector2i(200, 150)
render_target_update_mode = 4

; 200x150 no longer covers the surface, so the viewport's clear colour shows in the uncovered band.
[node name="Inner" type="ColorRect" parent="Booth/SubViewport"]
offset_right = 200.0
offset_bottom = 150.0
color = Color(1, 0.6, 0, 1)

; Clipped at 300x200 instead of 200x150, a bigger green rect than in the non-stretch fixture.
[node name="Overflow" type="ColorRect" parent="Booth/SubViewport"]
offset_left = 150.0
offset_top = 100.0
offset_right = 400.0
offset_bottom = 300.0
color = Color(0, 1, 0, 1)
