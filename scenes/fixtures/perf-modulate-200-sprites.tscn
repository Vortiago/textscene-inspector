; A work budget scene: 200 Sprite2D below one Node2D root, three levels deep, in 10 rows of 20, with
; an AnimationPlayer that plays a `modulate` track on the root. Every sprite draws in its own call,
; so a change that batches or drops one shows in the budget.

[gd_scene load_steps=4 format=3]

[ext_resource type="Texture2D" path="res://textures/sprite2d-marker.png" id="1_tex"]

[sub_resource type="Animation" id="Animation_mod"]
resource_name = "pulse"
length = 2.0
loop_mode = 1
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath(".:modulate")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {"times": PackedFloat32Array(0, 1, 2), "transitions": PackedFloat32Array(1, 1, 1), "update": 0, "values": [Color(1, 1, 1, 1), Color(1, 0.4, 0.4, 1), Color(1, 1, 1, 1)]}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_mod"]
_data = {"pulse": SubResource("Animation_mod")}

[node name="Parent" type="Node2D"]

[node name="Pulse" type="AnimationPlayer" parent="."]
libraries = {"": SubResource("AnimationLibrary_mod")}
