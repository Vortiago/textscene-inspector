[gd_scene load_steps=11 format=3 uid="uid://example_missing_resources"]

; A small lit room (floor + two walls + a crate) whose three albedo textures
; point at deliberately-absent res://demo/missing/* paths. The scene renders
; with flat base colours and reports the three textures as MISSING, so the
; shell's Resources tab lists them with per-row upload inputs. Uploading a
; file for each path drives the late-arrival pipeline (provideFile ->
; useResource 'loaded' -> re-render) and the surfaces gain their textures.
; Used by the "missing-upload" showcase clip to keep that flow on film.

[ext_resource type="Texture2D" path="res://demo/missing/floor_albedo.png" id="tex_floor"]
[ext_resource type="Texture2D" path="res://demo/missing/wall_albedo.png" id="tex_wall"]
[ext_resource type="Texture2D" path="res://demo/missing/crate_albedo.png" id="tex_crate"]

[sub_resource type="PlaneMesh" id="mesh_floor"]
size = Vector2(12, 12)

[sub_resource type="BoxMesh" id="mesh_backwall"]
size = Vector3(12, 4, 0.3)

[sub_resource type="BoxMesh" id="mesh_leftwall"]
size = Vector3(0.3, 4, 12)

[sub_resource type="BoxMesh" id="mesh_crate"]
size = Vector3(1.6, 1.6, 1.6)

[sub_resource type="StandardMaterial3D" id="mat_floor"]
albedo_color = Color(0.62, 0.62, 0.64, 1)
albedo_texture = ExtResource("tex_floor")

[sub_resource type="StandardMaterial3D" id="mat_wall"]
albedo_color = Color(0.7, 0.71, 0.73, 1)
albedo_texture = ExtResource("tex_wall")

[sub_resource type="StandardMaterial3D" id="mat_crate"]
albedo_color = Color(0.64, 0.55, 0.43, 1)
albedo_texture = ExtResource("tex_crate")

[node name="MissingResourcesDemo" type="Node3D"]

[node name="Floor" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
mesh = SubResource("mesh_floor")
surface_material_override/0 = SubResource("mat_floor")

[node name="BackWall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, -6)
mesh = SubResource("mesh_backwall")
surface_material_override/0 = SubResource("mat_wall")

[node name="LeftWall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 2, 0)
mesh = SubResource("mesh_leftwall")
surface_material_override/0 = SubResource("mat_wall")

[node name="Crate" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)
mesh = SubResource("mesh_crate")
surface_material_override/0 = SubResource("mat_crate")

[node name="KeyLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.25, 0.433013, 0, 0.866025, 0.5, -0.5, -0.433013, 0.75, 0, 6, 0)
light_energy = 1.1

[node name="FillLight" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 5, 5)
light_energy = 0.7
omni_range = 30.0
