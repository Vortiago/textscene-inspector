; The ONE variable: `layout_direction = 3` on an HSplitContainer. Godot
; inverts the dragger position against the container width
; (split_container.cpp:703-707) and then gives the FIRST child the band above
; it instead of below (`:738-751`), so the pair swaps sides and the boundary
; mirrors. `split_offset = 60` makes the two bands unequal, which is what
; separates a real mirror from a plain child swap; the LTR row above holds the
; unmirrored boundary. unit-split-container.tscn moves the offset branches at
; direction LTR, so a regression in the inversion is invisible there.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

[node name="Ltr" type="HSplitContainer" parent="."]
layout_mode = 1
offset_left = 40.0
offset_top = 40.0
offset_right = 440.0
offset_bottom = 100.0
split_offset = 60

[node name="First" type="ColorRect" parent="Ltr"]
layout_mode = 2
size_flags_horizontal = 3
color = Color(0.9, 0.2, 0.2, 1)

[node name="Second" type="ColorRect" parent="Ltr"]
layout_mode = 2
size_flags_horizontal = 3
color = Color(0.2, 0.7, 0.3, 1)

[node name="Rtl" type="HSplitContainer" parent="."]
layout_mode = 1
layout_direction = 3
offset_left = 40.0
offset_top = 120.0
offset_right = 440.0
offset_bottom = 180.0
split_offset = 60

[node name="First" type="ColorRect" parent="Rtl"]
layout_mode = 2
size_flags_horizontal = 3
color = Color(0.9, 0.2, 0.2, 1)

[node name="Second" type="ColorRect" parent="Rtl"]
layout_mode = 2
size_flags_horizontal = 3
color = Color(0.2, 0.7, 0.3, 1)
