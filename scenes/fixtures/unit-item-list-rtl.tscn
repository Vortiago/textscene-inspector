; One variable: `layout_direction = 3` on a LEFT icon-mode ItemList. Godot mirrors each row's
; icon inside the list width (item_list.cpp:1582-1584), moves the label to its own RTL pen,
; `size.width - rect.width + icon.width - text_ofs.x + h_separation` (:1664-1667), and
; right-aligns it (:1668). That pen is not the LTR mirror, so a plain mirror reads wrong.

[gd_scene load_steps=2 format=3 uid="uid://unit_item_list_rtl"]

[ext_resource type="Texture2D" path="res://textures/checkerboard-8px.svg" id="1_icon"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

