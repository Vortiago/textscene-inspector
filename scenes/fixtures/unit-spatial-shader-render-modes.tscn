[gd_scene format=3 uid="uid://unit_spatial_shader_render_modes"]

; Unshaded spatial shaders with the blend modes (top row) over an orange quad, and the depth modes (bottom
; row): no depth test and an inverted one behind an orange quad, and depth_draw_never through it.

[sub_resource type="Shader" id="Shader_orange"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = vec3(0.9, 0.3, 0.1);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_orange"]
shader = SubResource("Shader_orange")


[sub_resource type="Shader" id="Shader_add"]
code = "shader_type spatial;
render_mode unshaded, blend_add;

void fragment() {
	ALBEDO = vec3(UV * 0.4, 0.3);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_add"]
shader = SubResource("Shader_add")


