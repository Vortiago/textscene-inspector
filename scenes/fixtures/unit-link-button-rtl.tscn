; The ONE variable: `layout_direction = 3` on a LinkButton. Godot draws the
; paragraph at `size.width - text_buf->get_line_width()` instead of 0, and
; runs the underline over the same span (link_button.cpp:289-314). Both
; controls are fixed at 320px, far wider than the label, so the origin the
; direction picks is the only thing that can move the text or the stroke.
; `unit-link-button` is LTR; no other fixture pairs a LinkButton with a
; direction, so a regression in either edge is invisible everywhere else.

[gd_scene format=3 uid="uid://unitlinkbuttonrtl"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Ltr" type="LinkButton" parent="."]
offset_left = 64.0
offset_top = 48.0
offset_right = 384.0
offset_bottom = 72.0
text = "Open the manual"

[node name="Rtl" type="LinkButton" parent="."]
layout_direction = 3
offset_left = 64.0
offset_top = 96.0
offset_right = 384.0
offset_bottom = 120.0
text = "Open the manual"
