[gd_scene format=3]

; One variable, and no other fixture nests a combiner: whether a nested CSGCombiner3D's own
; `operation` applies to its whole fold. The parent folds `child->_get_brush()` to one brush and
; combines it by `child->get_operation()` (`modules/csg/csg_shape.cpp:472,481`). A flat fold has
; no solid to attach the combiner's operation to, so it unions the child: the notch becomes a bump.

[node name="NestedCombinerOp" type="CSGBox3D"]
size = Vector3(2, 2, 2)

[node name="Cutter" type="CSGCombiner3D" parent="."]
operation = 2

[node name="Blade" type="CSGBox3D" parent="Cutter"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.9, 0.9, 0.9)
size = Vector3(1.2, 1.2, 1.2)
