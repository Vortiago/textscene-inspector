[gd_scene format=3 uid="uid://unit_fog_volume_shader_null"]

; unit-fog-volume-shader-material with `shader = null` in place of the spatial .gdshader. The variable
; is a ShaderMaterial whose shader is null, which leaves the material data invalid, so Godot fills
; the volume with its default fog. No other golden holds a ShaderMaterial without a valid shader
; resource on a FogVolume, so a regression that drops its fog shows nowhere else.

[sub_resource type="ShaderMaterial" id="ShaderMaterial_1"]
shader = null

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.05, 0.05, 0.15, 1)
background_energy_multiplier = 1.0
volumetric_fog_enabled = true
volumetric_fog_density = 0.05
volumetric_fog_albedo = Color(0.6, 0.7, 0.9, 1)
volumetric_fog_emission = Color(0, 0, 0, 1)

[sub_resource type="BoxMesh" id="BoxMesh_near"]
size = Vector3(2, 2, 2)

[sub_resource type="BoxMesh" id="BoxMesh_mid"]
size = Vector3(2, 2, 2)

[sub_resource type="BoxMesh" id="BoxMesh_far"]
size = Vector3(2, 2, 2)

[sub_resource type="StandardMaterial3D" id="Material_1"]
albedo_color = Color(1, 0.3, 0.2, 1)
metallic = 0.2
roughness = 0.7

[node name="Root" type="Node3D"]

