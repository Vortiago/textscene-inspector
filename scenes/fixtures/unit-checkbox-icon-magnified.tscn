[gd_scene format=3]

; The one variable: a vendored theme icon magnified (`scale` 16), so bilinear filtering blends texels
; and the blend's colour space shows. At natural size no golden sees the icon loader's tag.
; `checked.svg` has an opaque #1a1a1a glyph over a 0.75 white rect with texel-aligned edges, so each
; ramp's endpoints are known. `text` is unset, so the icon is the only texture.

[node name="Root" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="MagnifiedCheck" type="CheckBox" parent="."]
layout_mode = 0
offset_left = 176.0
offset_top = 132.0
offset_right = 216.0
offset_bottom = 162.0
scale = Vector2(16, 16)
button_pressed = true
