; One variable: `reverse_fill` beside `layout_direction = 3` on a VFlowContainer. On a vertical
; flow Godot XORs the two flips, `(rtl != reverse_fill) && vertical` (flow_container.cpp:248),
; so both together cancel. Three containers: LTR, RTL alone (columns mirrored) and RTL +
; reverse_fill (columns back where LTR has them).

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; The three columns differ in width. An implementation that ORs the two flags, or mirrors
; unconditionally, agrees with the middle container and not the third, which no other fixture
; can tell apart.
[node name="Ltr" type="VFlowContainer" parent="."]
layout_mode = 1
offset_left = 40.0
offset_top = 40.0
offset_right = 280.0
offset_bottom = 120.0
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="A" type="ColorRect" parent="Ltr"]
