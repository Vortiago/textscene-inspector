; One variable: the SubViewportContainer sits inside an embedded Window, whose Control pass draws it.
; Every other container golden sits at the scene root. Regress the Window's lookup of the
; container's viewport and the green rect inside the Window turns empty.

[gd_scene format=3]

[node name="Root" type="Node2D"]

[node name="Panel" type="Window" parent="."]
position = Vector2i(200, 120)
size = Vector2i(500, 380)

[node name="Container" type="SubViewportContainer" parent="Panel"]
offset_left = 20.0
offset_top = 20.0
offset_right = 420.0
offset_bottom = 320.0

[node name="Viewport" type="SubViewport" parent="Panel/Container"]
size = Vector2i(400, 300)
render_target_update_mode = 4

[node name="Back" type="Polygon2D" parent="Panel/Container/Viewport"]
color = Color(0.3, 0.7, 0.4, 1)
polygon = PackedVector2Array(0, 0, 400, 0, 400, 300, 0, 300)
