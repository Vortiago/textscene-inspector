; One variable: FILL over two paragraphs on a Label. Label::_shape counts jst_to_line inside each
; paragraph (label.cpp:304-319), so with autowrap off both single-line paragraphs fit the box.
; unit-label-2d-fill.tscn has one paragraph, so only this scene shows a paragraph skipped as the last.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.12, 0.2, 1)

[node name="FillBox" type="ColorRect" parent="."]
offset_left = 40.0
offset_top = 40.0
offset_right = 340.0
offset_bottom = 120.0
color = Color(0.2, 0.2, 0.32, 1)

[node name="Fill" type="Label" parent="."]
offset_left = 40.0
offset_top = 40.0
offset_right = 340.0
offset_bottom = 120.0
text = "Wave rift over stone\nand amber light"
horizontal_alignment = 3
