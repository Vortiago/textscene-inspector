[sub_resource type="StandardMaterial3D" id="Mat_Billboard"]
shading_mode = 0
albedo_texture = ExtResource("1_tex")
billboard_mode = 1

[sub_resource type="StandardMaterial3D" id="Mat_Fixed"]
shading_mode = 0
albedo_texture = ExtResource("1_tex")
billboard_mode = 0

