[gd_scene format=3 uid="uid://unitfogcolorbg"]

; A colour background under depth fog at fog_sky_affect 0.5, for the one variable no other golden
; moves: the clear colour Godot's fog-only sky pass draws. Godot converts that colour to linear
; twice, so the warm background turns near black wherever fog is on. unit-depth-fog fogs its
; background fully, which hides the clear colour, and the other colour backgrounds have no fog.

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.6, 0.45, 0.3, 1)
fog_enabled = true
fog_light_color = Color(0.6, 0.65, 0.75, 1)
fog_density = 0.05
fog_sky_affect = 0.5

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(2, 2, 2)

[sub_resource type="StandardMaterial3D" id="Material_1"]
albedo_color = Color(1, 0.3, 0.2, 1)
roughness = 0.7

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Box" type="MeshInstance3D" parent="."]
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Material_1")
