[gd_scene format=3 uid="uid://unit_spatial_shader_vertex_id"]

; VERTEX_ID, which Godot counts from 0 in each surface: three triangle surfaces, the first two of one
; material and the third of its own, and two points surfaces at POINT_SIZE 6. No other golden gives
; a translated mesh of several surfaces a shader that reads VERTEX_ID.

[sub_resource type="Shader" id="Shader_tri"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;

varying flat vec3 band;

void vertex() {
	band = vec3(float(VERTEX_ID) / 12.0, 0.5, 0.2);
}

void fragment() {
	ALBEDO = band;
}
"

[sub_resource type="Shader" id="Shader_pts"]
code = "shader_type spatial;
render_mode unshaded;

varying flat vec3 band;

void vertex() {
	band = vec3(float(VERTEX_ID) / 6.0, 0.5, 0.2);
	POINT_SIZE = 6.0;
}

void fragment() {
	ALBEDO = band;
}
"

[sub_resource type="ShaderMaterial" id="Mat_shared"]
shader = SubResource("Shader_tri")

[sub_resource type="ShaderMaterial" id="Mat_own"]
shader = SubResource("Shader_tri")

[sub_resource type="ShaderMaterial" id="Mat_pts"]
shader = SubResource("Shader_pts")

[sub_resource type="ArrayMesh" id="Mesh_tri"]
_surfaces = [{
"aabb": AABB(-0.8, 0.05, 0, 0.5, 0.8, 1e-05),
"format": 34359738369,
"primitive": 3,
"uv_scale": Vector4(0, 0, 0, 0),
