[gd_scene load_steps=6 format=3 uid="uid://unitatlasovertexfile"]

; One variable: where the sheet of an AtlasTexture is saved. Both sprites crop the right half of
; the same red-to-blue GradientTexture2D. The left one's sheet is a sub-resource of the scene and
; the right one's is `unit-texture-file-gradient.tres`, so the two draw the same blue-leaning
; square. A sheet in a file that does not resolve leaves the right sprite a missing placeholder.
; Every other AtlasTexture sheet is an image file, so no other golden shows it.

[ext_resource type="Texture2D" path="res://unit-texture-file-gradient.tres" id="1_gradient"]

[sub_resource type="Gradient" id="Gradient_ramp"]
