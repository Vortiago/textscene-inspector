colors = PackedColorArray(0.9, 0.2, 0.1, 1, 0.1, 0.3, 0.9, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_inline"]
gradient = SubResource("Gradient_ramp")
width = 64
height = 32

[sub_resource type="AtlasTexture" id="AtlasTexture_overInline"]
