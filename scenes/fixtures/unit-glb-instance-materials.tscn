[gd_scene load_steps=4 format=3]

; The one variable: which instance material an override node sets on a mesh inside an instanced
; `.glb`. Left: `material_override`, which draws the cube orange in place of its glTF surface
; (render_forward_clustered.cpp:4206). Right: `material_overlay`, which draws the cube again in
; half-clear orange over its mid-grey default surface (:4228-4241). Two grey cubes mean the GLB
; override dropped both. `glb-surface-material-override` sets only a surface override.

[ext_resource type="PackedScene" uid="uid://ctscnglbmatovr0" path="res://meshes/unit-cube.glb" id="1_glb"]

