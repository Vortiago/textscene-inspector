[gd_scene load_steps=3 format=3 uid="uid://unitcsgpolypath"]

; CSGPolygon3D MODE_PATH sweeps the outline along a Curve3D owned by a different node, which a
; render component cannot reach. The scene-wide pass in r3f/csgPolygonPaths.ts resolves
; `path_node` after parse. Both corpus shapes appear: a sibling (csg.tscn:365, the Road) and a
; child (racetrack_csg.tscn:60). A resolver that assumed either one drops the other's geometry.

; `_data.points` packs nine floats per control point: in.xyz, out.xyz, position.xyz. Every
; handle is zero, so each span is straight. `tilts` is required, one entry per point:
; `Curve3D::_set_data` bails without it and the curve loads with zero points, so the sweep
; vanishes in Godot while the lenient parser still renders it.
[sub_resource type="Curve3D" id="Curve3D_road"]
_data = {
"points": PackedVector3Array(0, 0, 0, 0, 0, 0, -3, 0, -2, 0, 0, 0, 0, 0, 0, 0, 0, -3, 0, 0, 0, 0, 0, 0, 3, 0, -2, 0, 0, 0, 0, 0, 0, 3, 0, 2),
"tilts": PackedFloat32Array(0, 0, 0, 0)
}
point_count = 4

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_road"]
albedo_color = Color(0.35, 0.35, 0.4, 1)

[node name="CSGPolygonPathRoot" type="Node3D"]

; Sibling form, path_node = "../Path3D". The Road witness's property set, minus path_joined
; (this curve is open, not a loop).
[node name="Road" type="Node3D" parent="."]

[node name="RoadTop" type="CSGPolygon3D" parent="Road"]
polygon = PackedVector2Array(-0.6, 0.0, 0.6, 0.0, 0.6, 0.12, -0.6, 0.12)
mode = 2
path_node = NodePath("../Path3D")
path_interval_type = 0
path_interval = 0.25
path_simplify_angle = 4.0
path_rotation = 1
path_rotation_accurate = false
path_local = true
path_continuous_u = true
path_u_distance = 2.0
path_joined = false
smooth_faces = true
material = SubResource("StandardMaterial3D_road")

[node name="Path3D" type="Path3D" parent="Road"]
curve = SubResource("Curve3D_road")

; Child form, path_node = "Path3D", naming a Path3D parented under the polygon. Carries the
; racetrack witness's use_collision and calculate_tangents too. Both are parsed and validated
; but not acted on.
[node name="Rail" type="CSGPolygon3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
calculate_tangents = false
use_collision = true
polygon = PackedVector2Array(-0.08, -0.08, 0.08, -0.08, 0.08, 0.08, -0.08, 0.08)
mode = 2
path_node = NodePath("Path3D")
path_interval_type = 0
path_interval = 0.5
path_rotation = 1
path_local = true
path_joined = false
material = SubResource("StandardMaterial3D_road")

[node name="Path3D" type="Path3D" parent="Rail"]
curve = SubResource("Curve3D_road")
