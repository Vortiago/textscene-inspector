[gd_scene format=3]

; One variable: a ParallaxBackground is a CanvasLayer, so its subtree lays out against the
; viewport, not under its parent's transform. Every other 2D fixture composes transforms the
; ordinary way, so re-attaching a CanvasLayer to its parent chain shows only here.

[node name="Root" type="Node2D"]

; Moves its subtree 300 px right and 200 px down. `Reference` shows where that lands. The
; ParallaxBackground beside it still draws its bar at the canvas origin.
[node name="Displaced" type="Node2D" parent="."]
position = Vector2(300, 200)

[node name="Reference" type="Polygon2D" parent="Displaced"]
color = Color(0.9, 0.3, 0.2, 1)
polygon = PackedVector2Array(0, 0, 120, 0, 120, 40, 0, 40)

; Its own `offset` shifts the bar down 40 px: with `offset` at zero, "ignores the parent" and
; "ignores its own transform" look identical.
[node name="ParallaxBackground" type="ParallaxBackground" parent="Displaced"]
offset = Vector2(0, 40)

[node name="Layer" type="ParallaxLayer" parent="Displaced/ParallaxBackground"]

[node name="Bar" type="Polygon2D" parent="Displaced/ParallaxBackground/Layer"]
color = Color(0.2, 0.6, 0.9, 1)
polygon = PackedVector2Array(0, 0, 240, 0, 240, 40, 0, 40)
