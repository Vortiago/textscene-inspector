"format": "RGBA8",
"height": 2,
"mipmaps": false,
"width": 2
}

[sub_resource type="ImageTexture" id="ImageTexture_overInline"]
image = SubResource("Image_inline")

[sub_resource type="ImageTexture" id="ImageTexture_overFile"]
