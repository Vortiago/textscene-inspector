[gd_scene load_steps=5 format=3 uid="uid://unitimagetexoverimagefile"]

; One variable: where the Image of an ImageTexture is saved. Both sprites draw the same 2 by 2
; image, red and green over blue and yellow, with nearest filtering. The left one's Image is a
; sub-resource of the scene and the right one's is `unit-texture-file-image.tres`, so the two
; draw the same four squares. An Image file that does not resolve leaves the right sprite blank.
; Every other saved Image sits inside the file of its ImageTexture, so no other golden shows it.

[ext_resource type="Image" path="res://unit-texture-file-image.tres" id="1_image"]

[sub_resource type="Image" id="Image_inline"]
