; The one variable: whether a CSGMesh3D's brush is closed. Godot packs each brush into a manifold
; (csg_shape.cpp:367-432), and an open brush gives an empty manifold, so the QuadMesh and the
; CylinderMesh with cap_top off draw nothing, while the BoxMesh beside them draws. The last pair puts
; an open QuadMesh under a CSGBox3D with operation 2, which removes nothing, so the whole box draws.
; No other scene shows it: unit-csg-mesh holds only closed meshes, and each material here sets
; cull_mode to disabled so a face that wrongly drew would show from both sides.
[gd_scene load_steps=5 format=3 uid="uid://unitcsgmeshopenbrush"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_open"]
albedo_color = Color(0.85, 0.25, 0.2, 1)
cull_mode = 2

[sub_resource type="QuadMesh" id="QuadMesh_open"]
size = Vector2(1.2, 1.2)

[sub_resource type="CylinderMesh" id="CylinderMesh_open"]
top_radius = 0.4
bottom_radius = 0.4
height = 1.2
cap_top = false

[sub_resource type="BoxMesh" id="BoxMesh_closed"]
size = Vector3(1, 1, 1)

[node name="CsgMeshOpenBrushRoot" type="Node3D"]

[node name="OpenQuad" type="CSGMesh3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.7, 0, 0)
mesh = SubResource("QuadMesh_open")
material = SubResource("StandardMaterial3D_open")

[node name="OpenCylinder" type="CSGMesh3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.3, 0, 0)
mesh = SubResource("CylinderMesh_open")
material = SubResource("StandardMaterial3D_open")

; The closed control: it draws as before.
[node name="ClosedBox" type="CSGMesh3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.1, 0, 0)
mesh = SubResource("BoxMesh_closed")
material = SubResource("StandardMaterial3D_open")

[node name="BoxMinusOpenQuad" type="CSGBox3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.9, 0, 0)
material = SubResource("StandardMaterial3D_open")

[node name="OpenQuadSubtracted" type="CSGMesh3D" parent="BoxMinusOpenQuad"]
operation = 2
mesh = SubResource("QuadMesh_open")
material = SubResource("StandardMaterial3D_open")
