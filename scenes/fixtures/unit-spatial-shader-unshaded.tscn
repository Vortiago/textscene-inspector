[gd_scene format=3 uid="uid://unit_spatial_shader_unshaded"]

; A user's unshaded spatial shader on three meshes: the UV and the view-space normal as colours,
; one ShaderMaterial shared by two meshes, so each draw writes its own transform and camera.

[sub_resource type="Shader" id="Shader_uv"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = vec3(UV, 0.5);
}
"

[sub_resource type="Shader" id="Shader_normal"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = NORMAL * 0.5 + 0.5;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_uv"]
shader = SubResource("Shader_uv")

[sub_resource type="ShaderMaterial" id="ShaderMaterial_normal"]
shader = SubResource("Shader_normal")

[sub_resource type="BoxMesh" id="BoxMesh_1"]
material = SubResource("ShaderMaterial_uv")

[sub_resource type="SphereMesh" id="SphereMesh_1"]
material = SubResource("ShaderMaterial_normal")

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.1, 0.12, 0.16, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.9659258, 0.2588190, 0, -0.2588190, 0.9659258, 0, 1.2, 4)

[node name="Box" type="MeshInstance3D" parent="."]
transform = Transform3D(0.7071068, 0, 0.7071068, 0, 1, 0, -0.7071068, 0, 0.7071068, -1.2, 0, 0)
mesh = SubResource("BoxMesh_1")

[node name="SecondBox" type="MeshInstance3D" parent="."]
transform = Transform3D(0.5, 0, 0, 0, 0.5, 0, 0, 0, 0.5, 0, -0.6, 1)
mesh = SubResource("BoxMesh_1")

[node name="Sphere" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.2, 0, 0)
mesh = SubResource("SphereMesh_1")
