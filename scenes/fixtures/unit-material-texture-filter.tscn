[gd_scene load_steps=5 format=3 uid="uid://unitmaterialtexfilter"]

; One variable: `texture_filter`, left 0 (NEAREST, no mipmaps), right 3 (LINEAR_WITH_MIPMAPS, Godot's default), on two
; quads that sample one image. The only scene that witnesses per-material texture cloning, as no other fixture pairs one
; image with two filter states: the filter is a material property in Godot but lives on the Texture in three, and the
; loader caches one THREE.Texture per path, so filter state on it renders both quads with the material built last.

[ext_resource type="Texture2D" path="res://textures/checkerboard-8px.svg" id="1_tex"]

; Inline sub-resources, not external .tres: the two material construction paths are independent,
; and this is the larger one by corpus count. texture-filter.integration.test.ts covers the
; external path.
[sub_resource type="QuadMesh" id="QuadMesh_panel"]
size = Vector2(2.6, 2.6)

[sub_resource type="StandardMaterial3D" id="Material_nearest"]
; The 8x8 texture, authored without antialiasing, magnifies about 25x, so magFilter dominates:
; left shows hard 2px-cell blocks, right a smooth gradient. A 256px source would be near 1:1.
albedo_texture = ExtResource("1_tex")
texture_filter = 0
roughness = 1.0

[sub_resource type="StandardMaterial3D" id="Material_linear"]
albedo_texture = ExtResource("1_tex")
texture_filter = 3
roughness = 1.0

; Failure modes: property ignored, both quads soft. Applied at texture load instead of material
; build, both take one filter, non-deterministically. magFilter set without minFilter and
; generateMipmaps, the near quad sharpens and a minified one would not.
[node name="Scene" type="Node3D"]

[node name="Nearest" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.45, 0, 0)
mesh = SubResource("QuadMesh_panel")
surface_material_override/0 = SubResource("Material_nearest")

[node name="Linear" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.45, 0, 0)
mesh = SubResource("QuadMesh_panel")
surface_material_override/0 = SubResource("Material_linear")

[node name="Title" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.9, 0)
text = "texture_filter: NEAREST vs LINEAR"
pixel_size = 0.008
billboard = 1
modulate = Color(1, 1, 0.7, 1)

[node name="Description" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.55, 0)
text = "LEFT hard edges. RIGHT soft. One shared image."
pixel_size = 0.006
billboard = 1
modulate = Color(1, 1, 1, 1)
