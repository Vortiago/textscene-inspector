; One variable: a Line2D that samples a ViewportTexture with 3D content. A 3D target holds what a
; 2D target does not (a linear render that the viewport converts), so this is the one path where
; the Line2D's map multiply could differ from a Sprite2D's. unit-sprite-2d-viewport-texture covers a
; canvas-content target and the twin of this scene for the Polygon2D: unit-polygon2d-viewport-texture-3d.
; The box is unshaded at Color(0.2, 0.5, 0.8): Godot 4.6.3 reads (51, 127, 204) on its face. The
; second copy draws at modulate 0.5, where Godot reads (26, 64, 102).

[gd_scene format=3]

[sub_resource type="StandardMaterial3D" id="Unshaded"]
shading_mode = 0
albedo_color = Color(0.2, 0.5, 0.8, 1)

[sub_resource type="BoxMesh" id="Box"]
material = SubResource("Unshaded")

[sub_resource type="ViewportTexture" id="Vt"]
viewport_path = NodePath("SubViewport")

[node name="Root" type="Node2D"]

[node name="SubViewport" type="SubViewport" parent="."]
size = Vector2i(128, 128)
render_target_update_mode = 4

[node name="Camera" type="Camera3D" parent="SubViewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 2)

[node name="Box" type="MeshInstance3D" parent="SubViewport"]
mesh = SubResource("Box")

[node name="White" type="Line2D" parent="."]
position = Vector2(320, 120)
points = PackedVector2Array(0, 64, 128, 64)
width = 128.0
texture_mode = 2
texture = SubResource("Vt")

[node name="Tinted" type="Line2D" parent="."]
