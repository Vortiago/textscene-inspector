[gd_scene format=3]

; HORIZONTAL_ALIGNMENT_FILL is the one variable, against a Left-aligned sibling with the same
; box and sentence. No other Label fixture sets FILL, so a regression that stops stretching word
; gaps, or stretches a Left/Center/Right label, moves only this scene. The 700px box far exceeds
; the sentence at either size, so the stretch is large rather than a rounding-sized nudge.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="FillSmall" type="Label" parent="."]
anchors_preset = 0
offset_left = 20.0
offset_top = 20.0
offset_right = 720.0
offset_bottom = 46.0
text = "Stretched to fill the box"
horizontal_alignment = 3
theme_override_font_sizes/font_size = 20

[node name="LeftSmall" type="Label" parent="."]
anchors_preset = 0
offset_left = 20.0
offset_top = 60.0
offset_right = 720.0
offset_bottom = 86.0
text = "Stretched to fill the box"
theme_override_font_sizes/font_size = 20
