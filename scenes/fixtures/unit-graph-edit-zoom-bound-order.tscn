; GraphEdit whose zoom-out button is disabled, the only zoom-button state a scene file reaches.
; `set_zoom_custom` clamps `zoom` against the bounds as they stand (graph_edit.cpp:2434), returns
; when the clamp changed nothing (:2435-2437), and only then runs
; `zoom_minus_button->set_disabled(zoom == zoom_min)` (:2445). So `zoom` must move onto a bound.

; Every fixture in this family shares one GraphEdit rect and one GraphNode, and only
; unit-graph-edit-scroll-offset-clamped.tscn authors `scroll_offset`: `set_scroll_offset` clamps
; against bounds no child has widened while properties apply (graph_edit.cpp:407), so an authored
; offset moves the grid, the nodes and the minimap camera together and masks the one variable.
[gd_scene load_steps=1 format=3 uid="uid://unitgraphedzoombnd"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; In graph_edit.cpp, `zoom = 0.5` lands inside the constructor's range (:3175-3177), then
; `zoom_min = 1.0` re-runs `set_zoom(zoom)` (:2487) and drags it up to the new min. The stored
; `zoom` ends at its default, so this draws the family's picture with one difference: the
; zoom-out icon at `icon_disabled_color`'s alpha of 0.4 (default_theme.cpp:169) instead of 1.
[node name="Graph" type="GraphEdit" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 408.0
offset_bottom = 328.0
zoom = 0.5
zoom_min = 1.0

; Reading `zoom` as authored draws the whole graph at 0.5. Ignoring the order leaves the icon
; opaque. No other fixture writes a zoom bound, and the one that writes `zoom` sits inside both.
[node name="Source" type="GraphNode" parent="Graph"]
offset_right = 120.0
offset_bottom = 64.0
position_offset = Vector2(40, 56)
title = "Add"

[node name="Value" type="Label" parent="Graph/Source"]
layout_mode = 2
text = "Value"
