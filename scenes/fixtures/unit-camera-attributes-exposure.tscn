; One variable: CameraAttributesPractical.exposure_multiplier = 2. Godot multiplies a light's
; energy, an emission and a colour background by it, and a flat ambient not at all, so one frame
; shows the four consumers apart: the background and the lit top and the emissive box brighten,
; while the front of the grey box, which only the flat ambient lights, stays. Every other scene
; draws with no CameraAttributes, so none of them shows a regression in the factor.
[gd_scene load_steps=8 format=3]

[sub_resource type="CameraAttributesPractical" id="Camera_attributes_1"]
exposure_multiplier = 2.0

[sub_resource type="Environment" id="Env_1"]
background_mode = 1
background_color = Color(0.2, 0.2, 0.2, 1)
ambient_light_source = 2
ambient_light_color = Color(0.3, 0.3, 0.3, 1)

[sub_resource type="BoxMesh" id="Box_1"]

[sub_resource type="StandardMaterial3D" id="Grey_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
roughness = 1.0
metallic_specular = 0.0

[sub_resource type="StandardMaterial3D" id="Emissive_1"]
albedo_color = Color(0, 0, 0, 1)
roughness = 1.0
metallic_specular = 0.0
emission_enabled = true
emission = Color(0.4, 0.1, 0.1, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")
camera_attributes = SubResource("Camera_attributes_1")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 0, 3, 0)
light_energy = 0.5

[node name="GreyBox" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.2, 0, 0)
mesh = SubResource("Box_1")
surface_material_override/0 = SubResource("Grey_1")

[node name="EmissiveBox" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.2, 0, 0)
mesh = SubResource("Box_1")
surface_material_override/0 = SubResource("Emissive_1")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.894427, 0.447214, 0, -0.447214, 0.894427, 0, 2, 4)
fov = 70.0
