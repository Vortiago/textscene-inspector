[gd_scene load_steps=5 format=3 uid="uid://unitglowbloomfloor"]

; glow_bloom above zero floors the bright-pass feedback: it is a `max()` on the feedback, not a
; lowered threshold, so every pixel enters the glow buffer and the dim albedo-only ground blooms
; as much as the emissive sphere. This fixture also pins the composer-mount rule: a scene can
; need the pass with nothing bright enough to cross the threshold.

[sub_resource type="ProceduralSkyMaterial" id="Sky_dim"]
sky_top_color = Color(0.1, 0.12, 0.16, 1)
sky_horizon_color = Color(0.14, 0.14, 0.16, 1)
ground_bottom_color = Color(0.12, 0.1, 0.08, 1)
ground_horizon_color = Color(0.14, 0.14, 0.16, 1)

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("Sky_dim")

[sub_resource type="Environment" id="Env_glow"]
background_mode = 2
sky = SubResource("Sky_1")
tonemap_mode = 2
glow_enabled = true
glow_bloom = 0.35

[sub_resource type="SphereMesh" id="SphereMesh_1"]
radius = 0.6
height = 1.2
radial_segments = 32
rings = 16

[sub_resource type="StandardMaterial3D" id="Mat_plain"]
albedo_color = Color(0.75, 0.7, 0.35, 1)
roughness = 0.5

[node name="GlowBloomFloorRoot" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_glow")

[node name="PlainSphere" type="MeshInstance3D" parent="."]
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Mat_plain")
