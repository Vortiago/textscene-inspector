[gd_scene load_steps=5 format=3 uid="uid://test_anisotropy_flowmap"]

; One variable: `anisotropy_flowmap` present or absent. Both spheres carry the same anisotropic
; material under the same light, and only the right one has the flowmap. No other fixture sets
; `anisotropy_flowmap`: they set the scalar only, which is the left sphere.

[ext_resource type="Texture2D" path="res://textures/anisotropy-flowmap-split.png" id="1_flowmap"]

[sub_resource type="SphereMesh" id="SphereMesh_1"]
radius = 1.3
height = 2.6
radial_segments = 48
rings = 24

[sub_resource type="StandardMaterial3D" id="Material_flowmap"]
albedo_color = Color(0.62, 0.63, 0.66, 1)
metallic = 0.6
roughness = 0.35
anisotropy_enabled = true
anisotropy = 1.0
; textures/anisotropy-flowmap-split.png (64x64 RGBA) is constant R=255 G=128 (a +X derivative,
; neutral Y) with blue 0, and alpha, Godot's per-pixel strength, in four quarter-width bands of 0
; and 255. Every camera-facing part shows both regimes, so the flowmapped sphere shows the streak
; banded on and off while the scalar-only sphere is streaked all round.
anisotropy_flowmap = ExtResource("1_flowmap")

[sub_resource type="StandardMaterial3D" id="Material_scalar_only"]
albedo_color = Color(0.62, 0.63, 0.66, 1)
metallic = 0.6
roughness = 0.35
anisotropy_enabled = true
anisotropy = 1.0

[node name="Scene" type="Node3D"]

; three.js needs a channel repack (Godot strength = alpha, three.js reads blue) fed by a canvas
; readback of the decoded PNG. A lost readback makes this sphere a copy of the uniform one. A
; dropped repack zeroes the strength from the blue-0 texture and flattens its highlight.
[node name="SphereWithFlowmap" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, 0, 0)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Material_flowmap")

[node name="SphereScalarOnly" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.5, 0, 0)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Material_scalar_only")

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.707107, 0.707107, 0, -0.707107, 0.707107, 0, 4, 4)
light_energy = 2.0
