; One variable: `localize_numeral_system` on a RichTextLabel [ol]. `_get_prefix` writes a LIST_NUMBERS segment through
; `format_number(segment, _find_language(item))` while the property is on (rich_text_label.cpp:255-258), and a
; letter or roman segment as it is. The property defaults to true (control.h:293). A [lang] tag overrides the label
; language. The cell Off sets the property false. No other scene sets a language on a list.

[gd_scene load_steps=3 format=3]

[ext_resource type="FontFile" path="res://fonts/dejavu-sans-numerals-subset.ttf" id="1_font"]

[sub_resource type="Theme" id="Theme_1"]
default_font = ExtResource("1_font")
default_font_size = 20

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme = SubResource("Theme_1")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.12, 0.2, 1)

[node name="ArabicBox" type="ColorRect" parent="."]
