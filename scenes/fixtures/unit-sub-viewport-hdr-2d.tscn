; One variable: the SubViewport's use_hdr_2d. With it on, the viewport draws its canvas in linear
; colour into a half-float target that keeps values above 1, and the container multiplies the
; stored linear numbers as if they were sRGB bytes. No other scene sets use_hdr_2d, so only this
; scene shows a regression in the linear canvas. The left viewport is HDR and the right one is not,
; each with the same three squares. The bottom viewport is HDR under a container modulate of 0.5,
; which shows that a value above 1 survives into the consumer's arithmetic.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

[node name="HdrBooth" type="SubViewportContainer" parent="."]
offset_left = 100.0
offset_top = 100.0
offset_right = 400.0
offset_bottom = 200.0

[node name="SubViewport" type="SubViewport" parent="HdrBooth"]
use_hdr_2d = true
size = Vector2i(300, 100)
render_target_update_mode = 4

; 0.5 grey is 0.214 linear: the container shows byte 54, where the sRGB viewport shows 127.
[node name="Grey" type="Polygon2D" parent="HdrBooth/SubViewport"]
color = Color(0.5, 0.5, 0.5, 1)
polygon = PackedVector2Array(10, 10, 90, 10, 90, 90, 10, 90)

; Red at alpha 0.5 over green blends in linear numbers in the HDR viewport.
[node name="Green" type="Polygon2D" parent="HdrBooth/SubViewport"]
color = Color(0, 1, 0, 1)
polygon = PackedVector2Array(110, 10, 190, 10, 190, 90, 110, 90)

[node name="Red" type="Polygon2D" parent="HdrBooth/SubViewport"]
color = Color(1, 0, 0, 0.5)
polygon = PackedVector2Array(110, 10, 190, 10, 190, 90, 110, 90)

; modulate 4 takes red and green above 1, which the half-float target keeps.
[node name="Hot" type="Polygon2D" parent="HdrBooth/SubViewport"]
modulate = Color(4, 4, 4, 1)
color = Color(0.5, 0.25, 0.1, 1)
polygon = PackedVector2Array(210, 10, 290, 10, 290, 90, 210, 90)

[node name="SrgbBooth" type="SubViewportContainer" parent="."]
offset_left = 500.0
offset_top = 100.0
offset_right = 800.0
offset_bottom = 200.0

[node name="SubViewport" type="SubViewport" parent="SrgbBooth"]
size = Vector2i(300, 100)
render_target_update_mode = 4

[node name="Grey" type="Polygon2D" parent="SrgbBooth/SubViewport"]
color = Color(0.5, 0.5, 0.5, 1)
polygon = PackedVector2Array(10, 10, 90, 10, 90, 90, 10, 90)

[node name="Green" type="Polygon2D" parent="SrgbBooth/SubViewport"]
color = Color(0, 1, 0, 1)
polygon = PackedVector2Array(110, 10, 190, 10, 190, 90, 110, 90)

[node name="Red" type="Polygon2D" parent="SrgbBooth/SubViewport"]
color = Color(1, 0, 0, 0.5)
polygon = PackedVector2Array(110, 10, 190, 10, 190, 90, 110, 90)

[node name="Hot" type="Polygon2D" parent="SrgbBooth/SubViewport"]
modulate = Color(4, 4, 4, 1)
color = Color(0.5, 0.25, 0.1, 1)
polygon = PackedVector2Array(210, 10, 290, 10, 290, 90, 210, 90)

; The uncovered strip at x 300..310 shows the clear colour, 0.3 grey stored linear.
[node name="DimHdrBooth" type="SubViewportContainer" parent="."]
modulate = Color(0.5, 0.5, 0.5, 1)
offset_left = 100.0
offset_top = 300.0
offset_right = 420.0
offset_bottom = 400.0

[node name="SubViewport" type="SubViewport" parent="DimHdrBooth"]
use_hdr_2d = true
size = Vector2i(320, 100)
render_target_update_mode = 4

[node name="Grey" type="Polygon2D" parent="DimHdrBooth/SubViewport"]
color = Color(0.5, 0.5, 0.5, 1)
polygon = PackedVector2Array(10, 10, 90, 10, 90, 90, 10, 90)

[node name="Hot" type="Polygon2D" parent="DimHdrBooth/SubViewport"]
modulate = Color(4, 4, 4, 1)
color = Color(0.5, 0.25, 0.1, 1)
polygon = PackedVector2Array(210, 10, 290, 10, 290, 90, 210, 90)
