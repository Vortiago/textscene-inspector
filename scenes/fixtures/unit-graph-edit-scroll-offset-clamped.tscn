; GraphEdit with a negative authored `scroll_offset`, the one branch of the load-time clamp no
; other fixture reaches: `scroll_offset = p_offset.clamp(min_scroll_offset, max_scroll_offset -
; get_size())` (graph_edit.cpp:407). `CLAMP` tests the min first (typedefs.h:139-141), so a
; negative offset lands on (0, 0) and every non-negative one, (0, 0) included, lands on `-size`.

[gd_scene load_steps=1 format=3 uid="uid://unitgraphedscrclamp"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; Both bounds are still (0, 0) at load: properties apply before parenting (packed_scene.cpp:492
; sets, :541 parents), so `NOTIFICATION_RESIZED` never fires and no earlier `zoom` write calls
; `_update_scrollbars` (:2448). A max-only or symmetric clamp draws unit-graph-edit.tscn's
; (32, 16) picture exactly, but slides this grid, both nodes and the minimap camera by (-64, -48).
