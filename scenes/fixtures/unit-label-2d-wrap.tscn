; One variable: Label's line box, where autowrap breaks and how far apart the lines sit. One
; sentence in `autowrap_mode = 3` fills a 2x2 matrix of box width (320 / 560) and font size
; (20 / 28). Across a row only the break points may move. Down a column the break points and
; the baseline pitch move together.

[gd_scene format=3]

; Measured against Godot 4.6.3 at `--mode 2d`: same break points, line count and pitch, each right
; edge within 2 px. Per-line ink is within about 3%. The stems' edge pixels differ because the
; glyphs come from an MSDF atlas, so this scene guards the line box rather than the coverage.
[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; The only golden with shaped, wrapped text: Label3D fixtures are out of the set, the button
; golden sets one unwrapped word per box, and other 2D scenes are untyped geometry. A breaker
; that never breaks, or breaks mid-word, moves nothing else.
[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.08, 0.09, 0.12, 1)

; With one row a too-small pitch looks like a too-small font, and with one column a wrapper that
; ignores the box still draws four plausible blocks. Each grey plate is exactly its Label's rect,
; so an overrun or a wrong first baseline reads against the plate edge.
[node name="NarrowSmallPlate" type="ColorRect" parent="."]
anchors_preset = 0
offset_left = 64.0
offset_top = 48.0
offset_right = 384.0
offset_bottom = 296.0
color = Color(0.18, 0.2, 0.26, 1)

[node name="WideSmallPlate" type="ColorRect" parent="."]
