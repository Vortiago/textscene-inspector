position = Vector2(100, 100)
clip_children = 2
color = Color(0, 1, 0, 1)
polygon = PackedVector2Array(0, 0, 100, 0, 100, 100, 0, 100)

[node name="Child" type="Polygon2D" parent="Clipped"]
