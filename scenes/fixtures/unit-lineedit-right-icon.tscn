; right_icon, the one variable no other LineEdit fixture sets, at each of its three
; icon_expand_mode values with one icon resource. A content inset that ignores the icon's width
; lets the text overlap the icon, and a wrong icon_expand_mode formula sizes the icon wrong while
; the text still clips right by coincidence.

[gd_scene load_steps=2 format=3 uid="uid://unitlineeditrighticon"]

[ext_resource type="Texture2D" path="res://textures/sprite2d-marker.png" id="1_icon"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Fields" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
theme_override_constants/separation = 12

[node name="OriginalSize" type="LineEdit" parent="Fields"]
layout_mode = 2
text = "Original size icon"
right_icon = ExtResource("1_icon")
icon_expand_mode = 0

[node name="FitToText" type="LineEdit" parent="Fields"]
layout_mode = 2
text = "Fit to text icon"
right_icon = ExtResource("1_icon")
icon_expand_mode = 1

; The taller rect and right_icon_scale make FIT_TO_LINE_EDIT's height-driven sizing legible. They
; are not a second variable.
[node name="FitToLineEdit" type="LineEdit" parent="Fields"]
layout_mode = 2
custom_minimum_size = Vector2(0, 64)
text = "Fit to LineEdit icon"
right_icon = ExtResource("1_icon")
icon_expand_mode = 2
right_icon_scale = 0.75
