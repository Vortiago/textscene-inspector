; LineEdit's right_icon — the ONE variable no other LineEdit fixture sets — at
; each of its three icon_expand_mode values, the SAME icon resource in every
; row. A content-rect inset that forgets to account for the icon's resolved
; width is invisible everywhere else: the text would overlap the icon instead
; of stopping short of it, and a wrong icon_expand_mode formula would size the
; icon itself wrong while the text still happened to clip correctly by
; coincidence. The third row's taller rect and right_icon_scale exist only to
; make FIT_TO_LINE_EDIT's own height-driven sizing legible, not a second
; variable this fixture means to isolate.

[gd_scene load_steps=2 format=3 uid="uid://unitlineeditrighticon"]

[ext_resource type="Texture2D" path="res://textures/sprite2d-marker.png" id="1_icon"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Fields" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
theme_override_constants/separation = 12

[node name="OriginalSize" type="LineEdit" parent="Fields"]
layout_mode = 2
text = "Original size icon"
right_icon = ExtResource("1_icon")
icon_expand_mode = 0

[node name="FitToText" type="LineEdit" parent="Fields"]
layout_mode = 2
text = "Fit to text icon"
right_icon = ExtResource("1_icon")
icon_expand_mode = 1

[node name="FitToLineEdit" type="LineEdit" parent="Fields"]
layout_mode = 2
custom_minimum_size = Vector2(0, 64)
text = "Fit to LineEdit icon"
right_icon = ExtResource("1_icon")
icon_expand_mode = 2
right_icon_scale = 0.75
