; One variable: `layout_direction = 3` on a TOP icon-mode ItemList. TOP takes other RTL branches
; than LEFT: the icon mirror centres the icon in its row first (item_list.cpp:1553), and the
; label keeps HORIZONTAL_ALIGNMENT_CENTER while its box mirrors (:1639-1641), where LEFT
; re-derives the pen and swaps to RIGHT.

[gd_scene load_steps=2 format=3 uid="uid://unit_item_list_rtl_icon_top"]

[ext_resource type="Texture2D" path="res://textures/checkerboard-8px.svg" id="1_icon"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; Both lists match in width and rows, each row far narrower than the list, so an unmirrored box
; sits at the opposite edge. unit-item-list-rtl.tscn covers LEFT mode and unit-item-list.tscn is
; TOP at the default direction, so the TOP-mode mirror is invisible in both.
