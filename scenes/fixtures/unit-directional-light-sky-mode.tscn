[gd_scene format=3 uid="uid://unitdirlightskymode"]

; Moves DirectionalLight3D.sky_mode. The warm sun is Sky Only: Godot draws its disc in the sky and
; lights no surface with it. The cool sun is Light Only: Godot lights the ground and draws no disc.
; Every other scene keeps the default sky mode, so a light that ignores it looks right there. Here
; such a light draws a second sun, tints the ground warm and casts a second shadow.

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_1"]
sky_top_color = Color(0.1, 0.15, 0.3, 1)
sky_horizon_color = Color(0.5, 0.6, 0.7, 1)

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("ProceduralSkyMaterial_1")

[sub_resource type="Environment" id="Environment_1"]
background_mode = 2
sky = SubResource("Sky_1")
ambient_light_source = 2
ambient_light_color = Color(0.2, 0.2, 0.2, 1)

[sub_resource type="PlaneMesh" id="PlaneMesh_1"]
size = Vector2(40, 40)

