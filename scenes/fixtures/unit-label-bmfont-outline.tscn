[gd_scene load_steps=2 format=3]

; The one variable: the outline of a BMFont (`fonts/bmfont-outline.fnt`, a red glyph channel and a
; green outline channel). Godot draws the font's outline set, at the glyph's own rectangle, for any
; outline_size above 0. The rows are no outline, outline_size 4 at 16 px, at 32 px, and a half-alpha
; outline_color under a font colour.

