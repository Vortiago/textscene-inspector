[gd_scene format=3 uid="uid://unitvolfogspotbias"]

; The volumetric fog's spot shadow bias: a SpotLight3D pointing down with shadow_bias 3 lights the
; fog under a small box. Godot pushes each fog cell away from the light by the bias, where a surface's
; bias pulls it towards the light, so the whole cone of fog darkens. No other golden sets a spot
; shadow_bias in volumetric fog. The zero-energy sun keeps the editor's preview sun out (ADR-0025).

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.1, 0.12, 0.2, 1)
volumetric_fog_enabled = true
volumetric_fog_density = 0.1

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(0.6, 0.2, 0.6)

[sub_resource type="StandardMaterial3D" id="Material_1"]
albedo_color = Color(0.8, 0.5, 0.3, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Box" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 3, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Material_1")

[node name="Spot" type="SpotLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 0, 4, 0)
light_energy = 4.0
shadow_enabled = true
shadow_bias = 3.0
spot_range = 8.0
spot_angle = 35.0

[node name="Dark" type="DirectionalLight3D" parent="."]
light_energy = 0.0

[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 7)
fov = 70.0
