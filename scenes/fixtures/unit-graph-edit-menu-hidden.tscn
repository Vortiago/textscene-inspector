; GraphEdit with its whole toolbar hidden. `show_menu` hides `menu_panel` itself
; (graph_edit.cpp:2812-2815) and its background box with it, while the other five `show_*` flags
; hide only widgets inside that box. Every other fixture draws the panel, so none can catch a
; renderer that hides the items but keeps the panel.

; Every fixture in this family shares one GraphEdit rect and one GraphNode, and only
; unit-graph-edit-scroll-offset-clamped.tscn authors `scroll_offset`: `set_scroll_offset` clamps
; against bounds no child has widened while properties apply (graph_edit.cpp:407), so an authored
; offset moves the grid, the nodes and the minimap camera together and masks the one variable.

[gd_scene load_steps=1 format=3 uid="uid://unitgraphedmenuoff"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Graph" type="GraphEdit" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 408.0
offset_bottom = 328.0
show_menu = false

[node name="Source" type="GraphNode" parent="Graph"]
