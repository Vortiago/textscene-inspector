; One variable: the height an autowrapped Label reports to the container that set its width.
; `Label::get_minimum_size` returns `Size2(1, height)`: the container decides the width, and the
; height is the text as wrapped at that width (`Label::_shape` breaks at
; `int width = get_size().width`, and `_update_visible` sums the lines that come out).

[gd_scene load_steps=2 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_plate"]
bg_color = Color(0.12, 0.14, 0.19, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.45, 0.72, 0.85, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 12.0
content_margin_top = 12.0
content_margin_right = 12.0
content_margin_bottom = 12.0

; Measured against Godot 4.6.3 at `--mode 2d` (1152x648 project viewport), reading
; `Control.get_rect()` after the reference harness's 6-frame settle. Nothing here is animated,
; textured or timed.
[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; unit-label-2d-wrap.tscn is the only other wrapping scene, and its Labels are anchor-driven, so
; nothing asks them for a height. unit-vbox-container-pitch.tscn and unit-panel-styleboxes.tscn
; ask children for heights, but no child wraps. Only a wrapping Label inside a container shows
; this, and no other unit scene has that pair.
[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.06, 0.08, 1)

; The witness: `offset_bottom == offset_top`, so the rect has no height of its own and the plate
; draws exactly the minimum size the Label hands up through the VBoxContainer. A one-line answer
; paints the plate 52px short, the last two lines hanging below it and the border crossing the
; glyphs. Godot: rect (64, 64, 400, 130), combined minimum size (189, 130).
[node name="Card" type="PanelContainer" parent="."]
anchors_preset = 0
offset_left = 64.0
offset_top = 64.0
offset_right = 464.0
offset_bottom = 64.0
theme_override_styles/panel = SubResource("StyleBoxFlat_plate")

; Godot: rect (12, 12, 376, 106), combined minimum size (165, 106). The heading makes the card's
; height a sum (heading + separation + wrapped body + the plate's content margins) rather than a
; passthrough, which is the arithmetic a container gets wrong.
[node name="Column" type="VBoxContainer" parent="Card"]
layout_mode = 2
theme_override_constants/separation = 8

; Godot: rect (0, 0, 376, 23), combined minimum size (165, 23), one line.
[node name="Heading" type="Label" parent="Card/Column"]
layout_mode = 2
text = "Container-sized wrap"

; Godot: rect (0, 31, 376, 75), combined minimum size (1, 75), three lines: 3 * 26 - 3, since
; Label's `line_spacing` adds no trailing gap. One line would make it 23 and the card 78 tall
; instead of 130, 52px of paragraph outside its plate.
[node name="Body" type="Label" parent="Card/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.68, 0.74, 1)
text = "This paragraph has no width of its own. The container decides how wide it is, and only then can it say how tall it needs to be."
autowrap_mode = 3
