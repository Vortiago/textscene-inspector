[gd_scene load_steps=4 format=3]

; One variable: whether `surface_material_override/0` as an inline `[sub_resource]` reaches a
; mesh inside an instanced `.glb`. `MeshInstance3D::set_surface_override_material` takes a
; `Ref<Material>` whatever its source, so a GLB mesh honours a sub-resource as it honours an
; ExtResource `.tres`. Resolving only the path form drops this one silently.

; `unit-cube.glb` carries no glTF material, so a dropped override shows Godot's default 3D
; surface (mid-grey) and an applied one this scene's orange. Neither looks like a missing mesh:
; a dropped override still draws the cube.
[ext_resource type="PackedScene" uid="uid://ctscnglbmatovr0" path="res://meshes/unit-cube.glb" id="1_glb"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_paint"]
albedo_color = Color(0.95, 0.45, 0.05, 1)
roughness = 0.4
metallic = 0.1

[node name="GlbMaterialOverride" type="Node3D"]

[node name="Cube" parent="." instance=ExtResource("1_glb")]

; Type-less with `parent="Cube"`: Godot's form for "override the node already at this path", the
; only shape that reaches the GLB override path. A typed node adds a new child instead.
[node name="Cube" parent="Cube" index="0"]
surface_material_override/0 = SubResource("StandardMaterial3D_paint")
