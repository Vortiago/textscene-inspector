[gd_scene load_steps=4 format=3]

; The one variable: `FontVariation.variation_embolden` over one scene font, at 0, 1.2 and 2.0. Godot
; grows the outline by `embolden * size / 16` px, anchored left and bottom, and widens each advance
; by `embolden * size / 64` px. The 0 row is the unemboldened floor.

[ext_resource type="FontFile" path="res://fonts/montserrat-extra-bold.otf" id="1"]

[sub_resource type="FontVariation" id="FontVariation_none"]
base_font = ExtResource("1")

[sub_resource type="FontVariation" id="FontVariation_1_2"]
base_font = ExtResource("1")
variation_embolden = 1.2

[sub_resource type="FontVariation" id="FontVariation_2_0"]
base_font = ExtResource("1")
variation_embolden = 2.0

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="NoEmbolden" type="Label" parent="."]
layout_mode = 0
offset_left = 40.0
offset_top = 30.0
offset_right = 1100.0
offset_bottom = 110.0
theme_override_fonts/font = SubResource("FontVariation_none")
theme_override_font_sizes/font_size = 56
text = "Hog Wave 123 0"

[node name="Embolden12" type="Label" parent="."]
layout_mode = 0
offset_left = 40.0
offset_top = 130.0
offset_right = 1100.0
offset_bottom = 210.0
theme_override_fonts/font = SubResource("FontVariation_1_2")
theme_override_font_sizes/font_size = 56
text = "Hog Wave 123 1.2"

[node name="Embolden20" type="Label" parent="."]
layout_mode = 0
offset_left = 40.0
