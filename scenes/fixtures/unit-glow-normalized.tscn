[gd_scene load_steps=5 format=3 uid="uid://unitglownormalized"]

; glow_normalized over weights that do not sum to 1. Godot sums the seven mip levels
; unnormalised, and glow_normalized divides each weight by their total. These weights sum to
; 3.5, so ignoring the flag renders the halo 3.5x too bright.

