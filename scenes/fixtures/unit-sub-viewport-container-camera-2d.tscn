; One variable against unit-sub-viewport-container-stretch-2d-content.tscn: a Camera2D inside a
; stretching sub-viewport. Container geometry, authored `size = Vector2i(200, 150)`, the forced
; 300x200 rect and Backdrop are identical. The content sits elsewhere only because the camera
; moved the view: that displacement is the variable.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; This is the only fixture with a Camera2D, so every other sub-viewport fixture pins the
; whole-rect fallback. camera2DView and orthoFrameForCamera2D have unit tests that never render
; through the view rect, and no golden covers it: this fixture has no entry in
; `scripts/visual/scenes.mjs`.
[node name="Booth" type="SubViewportContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 400.0
offset_bottom = 280.0
stretch = true

[node name="SubViewport" type="SubViewport" parent="Booth"]
size = Vector2i(200, 150)
render_target_update_mode = 4

; Godot renders a viewport's canvas through the Camera2D that claimed it (`camera_2d.cpp`,
; NOTIFICATION_ENTER_TREE: `enabled && !viewport->get_camera_2d()`), and the view is
; `size / zoom` centred on the camera. With the forced rect 300x200 and the camera at (500, 400)
; the view is world x 350..650, y 300..500, so screen = world - (350, 300).
[node name="Camera" type="Camera2D" parent="Booth/SubViewport"]
position = Vector2(500, 400)

; Asymmetric both ways, like the siblings, because the readback is bottom-up and a canvas
; top-down: Band covers rows 0..39 at full width, which a vertical flip moves to rows 160..199.
; It keeps the siblings' Color(0.5, 0.5, 0.5), so the linear-to-sRGB encode stays pinned. The
; bottom-right corner stays uncovered for the clear colour.
[node name="Band" type="Polygon2D" parent="Booth/SubViewport"]
color = Color(0.5, 0.5, 0.5, 1)
polygon = PackedVector2Array(350, 300, 650, 300, 650, 340, 350, 340)

; Rows 80..109, cols 10..69. A horizontal flip moves it to cols 230..289.
[node name="Mark" type="Polygon2D" parent="Booth/SubViewport"]
color = Color(1, 0.4, 0, 1)
polygon = PackedVector2Array(360, 380, 420, 380, 420, 410, 360, 410)

; World x 20..140, y 20..80: outside the camera's view and inside the whole-rect view
; (x 0..300, y 0..200) the pass falls back to without a current camera. Band and Mark are the
; other way round, so the surface shows Band and Mark or Decoy, never a scaled mix. Both in
; horizontal bands is a paint that covered only part of its canvas.
[node name="Decoy" type="Polygon2D" parent="Booth/SubViewport"]
color = Color(1, 0, 0, 1)
polygon = PackedVector2Array(20, 20, 140, 20, 140, 80, 20, 80)
