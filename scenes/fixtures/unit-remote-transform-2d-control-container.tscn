[gd_scene format=3]

; Moves one variable: a Container lays out the Control above the relay. The relay pushes the pose that
; includes the rect the Container gave, so the green square stands at the relay. No other golden has a
; relay below a Control in a Container.

[node name="Root" type="Node2D"]

[node name="Box" type="VBoxContainer" parent="."]
offset_left = 50.0
offset_top = 40.0
offset_right = 250.0
offset_bottom = 240.0

[node name="A" type="ColorRect" parent="Box"]
custom_minimum_size = Vector2(80, 50)

[node name="B" type="Control" parent="Box"]
custom_minimum_size = Vector2(80, 60)

[node name="Relay" type="RemoteTransform2D" parent="Box/B"]
position = Vector2(40, 10)
remote_path = NodePath("../../../Held")

[node name="Held" type="Polygon2D" parent="."]
color = Color(0.3, 0.8, 0.4, 1)
polygon = PackedVector2Array(-15, -15, 15, -15, 15, 15, -15, 15)
