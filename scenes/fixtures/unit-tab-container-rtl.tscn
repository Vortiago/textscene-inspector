; One variable: `layout_direction = 3` on the lower TabContainer. `_update_margins` swaps the
; tabbar style's left and right margin under RTL (tab_container.cpp:412), and `Control::_size_changed`
; mirrors the strip (control.cpp:1785-1787), so the authored margins keep their sides and
; `side_margin` moves to the other edge. The tabs in the strip mirror too.

[gd_scene load_steps=3 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_tabbar"]
content_margin_left = 4.0
content_margin_top = 6.0
content_margin_right = 28.0
content_margin_bottom = 2.0
bg_color = Color(0.25, 0.18, 0.3, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 6.0
content_margin_top = 3.0
content_margin_right = 26.0
content_margin_bottom = 3.0
bg_color = Color(0.45, 0.4, 0.2, 1)

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
