[gd_scene format=3 uid="uid://unit_spatial_shader_parameters"]

; A user's unshaded spatial shader reading its parameters: a colour the material sets, a float left
; at its default, and a gradient texture sampled nearest. A material_override draws it on a box too.

[sub_resource type="Gradient" id="Gradient_1"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(1, 0.9, 0.2, 1, 0.1, 0.8, 0.3, 1, 0.9, 0.1, 0.6, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_1"]
gradient = SubResource("Gradient_1")
width = 8
height = 8
fill_to = Vector2(1, 1)

[sub_resource type="Shader" id="Shader_1"]
code = "shader_type spatial;
render_mode unshaded;

uniform vec4 tint : source_color = vec4(1.0, 0.0, 0.0, 1.0);
uniform float mixer = 0.35;
uniform sampler2D checker : source_color, filter_nearest;

void fragment() {
	ALBEDO = mix(texture(checker, UV * 2.0).rgb, tint.rgb, mixer);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_1"]
shader = SubResource("Shader_1")
shader_parameter/tint = Color(0.2, 0.6, 1, 1)
shader_parameter/checker = SubResource("GradientTexture2D_1")

[sub_resource type="PlaneMesh" id="PlaneMesh_1"]
size = Vector2(2.5, 2.5)
material = SubResource("ShaderMaterial_1")

[sub_resource type="BoxMesh" id="BoxMesh_1"]

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.1, 0.12, 0.16, 1)

[node name="Root" type="Node3D"]

