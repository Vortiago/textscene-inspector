[gd_scene load_steps=3 format=3 uid="uid://unitsprite2dgradtextres"]

[ext_resource type="Gradient" path="res://textures/ramp-three-stop.tres" id="1_ramp"]

; One variable: a GradientTexture2D whose `gradient` is an ExtResource to a saved Gradient (.tres)
; instead of an inline sub-resource. unit-sprite2d-gradienttexture inlines its Gradient, and
; nothing else saves one as a file. Losing the file route leaves a texture without a gradient, so
; the sprite draws nothing over the backdrop. Three stops with the middle at 0.4 show that the
; file's offsets, not an even spread, place the colours.

