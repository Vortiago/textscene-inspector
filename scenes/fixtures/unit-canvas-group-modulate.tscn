; One variable against unit-canvas-group-self-modulate.tscn: the group's `modulate`, alpha 0.5, in
; place of its `self_modulate`. It reaches the squares and the composite rect, so its alpha applies
; twice. The plain Node2D beside it is the same. No other scene modulates a CanvasGroup.

[gd_scene format=3]

[node name="Root" type="Node2D"]

[node name="Group" type="CanvasGroup" parent="."]
position = Vector2(100, 100)
modulate = Color(1, 1, 1, 0.5)

[node name="Red" type="Polygon2D" parent="Group"]
color = Color(1, 0, 0, 1)
polygon = PackedVector2Array(0, 0, 100, 0, 100, 100, 0, 100)

[node name="Blue" type="Polygon2D" parent="Group"]
position = Vector2(50, 50)
color = Color(0, 0, 1, 1)
polygon = PackedVector2Array(0, 0, 100, 0, 100, 100, 0, 100)

[node name="Plain" type="Node2D" parent="."]
position = Vector2(400, 100)
modulate = Color(1, 1, 1, 0.5)

[node name="Red" type="Polygon2D" parent="Plain"]
color = Color(1, 0, 0, 1)
polygon = PackedVector2Array(0, 0, 100, 0, 100, 100, 0, 100)

[node name="Blue" type="Polygon2D" parent="Plain"]
position = Vector2(50, 50)
color = Color(0, 0, 1, 1)
polygon = PackedVector2Array(0, 0, 100, 0, 100, 100, 0, 100)
