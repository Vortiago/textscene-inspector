; One variable: a clip_children group C, after a plain sibling P, splits the frame between an inert owner O and
; the inert owner I that O draws behind. Godot draws I's behind child B before I's regular child X, so green covers red.
; No other scene puts a clip_children group between two nested inert owners, so none shows the order across it.

[gd_scene format=3]

[node name="Root" type="Node2D"]

[node name="O" type="Node2D" parent="."]
position = Vector2(100, 100)
clip_children = 1

[node name="P" type="Polygon2D" parent="O"]
position = Vector2(300, 0)
color = Color(0.9, 0.9, 0.2, 1)
polygon = PackedVector2Array(0, 0, 40, 0, 40, 40, 0, 40)

[node name="C" type="Polygon2D" parent="O"]
position = Vector2(200, 0)
clip_children = 2
color = Color(0.5, 0.5, 0.5, 1)
polygon = PackedVector2Array(0, 0, 60, 0, 60, 60, 0, 60)

[node name="I" type="Node2D" parent="O"]
show_behind_parent = true
clip_children = 1

[node name="X" type="Polygon2D" parent="O/I"]
position = Vector2(40, 40)
color = Color(0, 1, 0, 1)
polygon = PackedVector2Array(0, 0, 100, 0, 100, 100, 0, 100)

[node name="B" type="Polygon2D" parent="O/I"]
show_behind_parent = true
color = Color(1, 0, 0, 1)
polygon = PackedVector2Array(0, 0, 100, 0, 100, 100, 0, 100)
