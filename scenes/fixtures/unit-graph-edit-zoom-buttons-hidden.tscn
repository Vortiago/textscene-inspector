; GraphEdit with its three zoom buttons hidden. `show_zoom_buttons` hides zoom-out, zoom-reset
; and zoom-in together (graph_edit.cpp:2830-2836), narrowing the toolbar by three button widths
; and shifting every later widget. Hiding the wrong button, or keeping the row width, is
; invisible wherever all the buttons show.

; Every fixture in this family shares one GraphEdit rect and one GraphNode, and only
; unit-graph-edit-scroll-offset-clamped.tscn authors `scroll_offset`: `set_scroll_offset` clamps
; against bounds no child has widened while properties apply (graph_edit.cpp:407), so an authored
; offset moves the grid, the nodes and the minimap camera together and masks the one variable.

[gd_scene load_steps=1 format=3 uid="uid://unitgraphedzoombtn"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Graph" type="GraphEdit" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 408.0
offset_bottom = 328.0
show_zoom_buttons = false

