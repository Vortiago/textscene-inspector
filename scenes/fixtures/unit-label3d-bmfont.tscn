[gd_scene load_steps=4 format=3]

; The one variable: a BMFont (`fonts/bmfont-blocks.fnt`, 16 px, one RGBA page of solid blocks) as the
; font of a TextMesh and of a Label3D. The TextMesh on the left draws nothing, as a font with no
; FreeType face has no contours. The Label3D on the right draws each glyph over its page image and
; skips the 2 px wide `i`. The Label3D below it draws the outline set of `fonts/bmfont-outline.fnt`.

[ext_resource type="FontFile" path="res://fonts/bmfont-blocks.fnt" id="1_blocks"]
[ext_resource type="FontFile" path="res://fonts/bmfont-outline.fnt" id="2_outline"]

[sub_resource type="TextMesh" id="TextMesh_blocks"]
text = "Hi AV"
font = ExtResource("1_blocks")
font_size = 16
pixel_size = 0.05

[node name="Root" type="Node3D"]

