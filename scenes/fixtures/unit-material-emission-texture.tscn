[gd_scene load_steps=6 format=3 uid="uid://unitmaterialemissiontexture"]

; The two emission_operator cases that need a texture to be observable. Flat quads, not spheres:
; a checkerboard discriminates UVs, and Godot's SphereMesh winds its UVs at a different phase
; than three's sphere even on plain albedo. On a quad the mapping is unambiguous, so only the
; operator is measured.

[ext_resource type="Texture2D" path="res://textures/checkerboard.svg" id="1_checker"]

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(1.4, 1.4)

[sub_resource type="StandardMaterial3D" id="Mat_add"]
albedo_color = Color(0.15, 0.15, 0.18, 1)
roughness = 0.5
emission_enabled = true
emission_texture = ExtResource("1_checker")
emission_energy_multiplier = 1.5

[sub_resource type="StandardMaterial3D" id="Mat_multiply"]
albedo_color = Color(0.15, 0.15, 0.18, 1)
roughness = 0.5
emission_enabled = true
emission = Color(0.2, 0.9, 1.0, 1)
emission_texture = ExtResource("1_checker")
emission_operator = 1
emission_energy_multiplier = 1.5

[node name="EmissionTextureRoot" type="Node3D"]

; ADD over Godot's default emission colour, black and so omitted from the file: Godot computes
; (0 + tex) * energy, so the checkerboard shows at full energy. Multiplying that absent black
; through renders the quad unlit, and this is the most common way emission is authored.
[node name="AddOperator" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.9, 0, 0)
mesh = SubResource("QuadMesh_1")
surface_material_override/0 = SubResource("Mat_add")

; MULTIPLY with a lit colour, (colour * tex) * energy: the one case three's multiply-only emissive
; chain expresses natively, so the checkerboard arrives tinted.
[node name="MultiplyOperator" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.9, 0, 0)
mesh = SubResource("QuadMesh_1")
surface_material_override/0 = SubResource("Mat_multiply")
