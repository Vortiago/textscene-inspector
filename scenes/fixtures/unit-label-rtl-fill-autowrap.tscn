; One variable: HORIZONTAL_ALIGNMENT_FILL on an RTL Label. FILL's RTL arm (label.cpp:472-478)
; reads the shaped paragraph direction (:470), not `rtl_layout` (:471), and `text_direction`
; defaults to TEXT_DIRECTION_AUTO (label.h:70), not inherited. So a Latin paragraph infers LTR,
; the arm never fires, and the wrapped Label's last line must still start at x 0.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.1, 0.16, 0.12, 1)

; The last line is the one the jst_flags skip, so it keeps its natural width.
; unit-label-rtl-alignment.tscn moves the arms that read the layout direction, so it cannot
; catch a FILL arm wired to it. Both Labels are 500 wide and centred, so the rect mirror
; (control.cpp:1785) is the identity.
[node name="RtlFillNoWrap" type="Label" parent="."]
layout_mode = 1
layout_direction = 3
offset_left = 326.0
offset_right = 826.0
offset_top = 24.0
offset_bottom = 64.0
text = "Wave rift"
horizontal_alignment = 3
autowrap_mode = 0

[node name="RtlFillWrap" type="Label" parent="."]
layout_mode = 1
layout_direction = 3
offset_left = 326.0
offset_right = 826.0
offset_top = 96.0
offset_bottom = 216.0
text = "Wave rift over quiet stone and slow amber light across the long shelf"
horizontal_alignment = 3
autowrap_mode = 3
