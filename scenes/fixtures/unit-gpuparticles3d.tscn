; GPUParticles3D emitting a visible burst. Without a `draw_pass_1` mesh Godot
; renders nothing at all (it warns about exactly that), so the earlier fixture
; showed an empty frame in BOTH engines and proved nothing. `preprocess` runs
; the simulation forward before the first frame, so a still capture catches a
; spread of particles rather than the instant of emission.
;
; The previewer renders GPUParticles3D as a transform-only node (ADR-0008) — it
; does not simulate — so this fixture's whole point on the comparison sheet is
; to show Godot's particle cloud beside our deliberate nothing.
[gd_scene load_steps=4 format=3]

[sub_resource type="ParticleProcessMaterial" id="Process_1"]
direction = Vector3(0, 1, 0)
spread = 45.0
initial_velocity_min = 2.0
initial_velocity_max = 3.0
gravity = Vector3(0, -2, 0)
scale_min = 0.5
scale_max = 1.0

[sub_resource type="SphereMesh" id="Sphere_1"]
radius = 0.12
height = 0.24

[sub_resource type="StandardMaterial3D" id="Dot_1"]
albedo_color = Color(0.9, 0.55, 0.2, 1)
emission_enabled = true
emission = Color(0.9, 0.45, 0.1, 1)

[node name="Root" type="Node3D"]

[node name="GPUParticles3D" type="GPUParticles3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
amount = 200
lifetime = 2.0
preprocess = 1.2
process_material = SubResource("Process_1")
draw_pass_1 = SubResource("Sphere_1")
material_override = SubResource("Dot_1")
