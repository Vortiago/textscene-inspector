; One variable: the stack order and focus of four embedded windows. A, always on top, draws
; last. C, the last window that can take focus, draws the focused border, and the rest the unfocused one.

[gd_scene format=3]

[node name="Root" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Bg" type="ColorRect" parent="."]
offset_right = 1152.0
offset_bottom = 648.0
color = Color(0.2, 0.3, 0.5, 1)

[node name="A" type="Window" parent="."]
title = "A first"
position = Vector2i(100, 100)
size = Vector2i(300, 200)
always_on_top = true

[node name="B" type="Window" parent="."]
title = "B unfocusable"
position = Vector2i(250, 200)
size = Vector2i(300, 200)
unfocusable = true

[node name="C" type="Window" parent="."]
title = "C"
position = Vector2i(600, 100)
size = Vector2i(300, 200)

[node name="D" type="Window" parent="."]
title = "D unfocusable"
position = Vector2i(700, 250)
size = Vector2i(300, 200)
unfocusable = true
