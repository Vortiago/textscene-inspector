; One variable: a Camera3D `environment` in a SubViewport that shares the root world. Godot forces
; it over the world's for that pass (`renderer_scene_cull.cpp:3594-3597`): a warm background, green
; ambient and ACES in the target, the world's blue and linear curve around it. No other scene gives a
; camera in a shared-world SubViewport an Environment, so none shows a regression in it.

[gd_scene format=3]

[sub_resource type="Environment" id="Env_world"]
background_mode = 1
background_color = Color(0.05, 0.06, 0.2, 1)

[sub_resource type="Environment" id="Env_camera"]
background_mode = 1
background_color = Color(0.6, 0.3, 0.1, 1)
ambient_light_source = 2
ambient_light_color = Color(0.1, 0.5, 0.2, 1)
tonemap_mode = 3

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(1.2, 1.2)

[sub_resource type="ViewportTexture" id="ViewportTexture_1"]
viewport_path = NodePath("SubViewport")

[sub_resource type="StandardMaterial3D" id="Mat_screen"]
resource_local_to_scene = true
shading_mode = 0
billboard_mode = 1
albedo_texture = SubResource("ViewportTexture_1")

[sub_resource type="SphereMesh" id="SphereMesh_1"]

[sub_resource type="StandardMaterial3D" id="Mat_grey"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
roughness = 1.0
metallic_specular = 0.0

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_world")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.707107, 0.707107, 0, -0.707107, 0.707107, 0, 3, 0)
light_energy = 0.5

[node name="Sphere" type="MeshInstance3D" parent="."]
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Mat_grey")

; The world is shared, so the target shows the sphere above. The quad sits outside the view of
; the target's camera, so the target never samples itself.
[node name="SubViewport" type="SubViewport" parent="."]
size = Vector2i(256, 256)
render_target_update_mode = 4

[node name="Camera3D" type="Camera3D" parent="SubViewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 3)
fov = 50.0
environment = SubResource("Env_camera")

[node name="Screen" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.2, 0, 0)
mesh = SubResource("QuadMesh_1")
surface_material_override/0 = SubResource("Mat_screen")
