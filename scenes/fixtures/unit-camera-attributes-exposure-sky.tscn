; One variable: CameraAttributesPractical.exposure_multiplier = 2 over a procedural sky. Godot scales
; the sky background by the factor and the sky's ambient and reflection by its square, since the
; sky's radiance is baked at the factor and a surface reads it times the factor again. The emissive
; box takes the factor once. `unit-camera-attributes-exposure` shows a colour background, whose
; ambient is flat, so no other scene shows a regression in the sky's squared share.
[gd_scene load_steps=10 format=3]

[sub_resource type="CameraAttributesPractical" id="Camera_attributes_1"]
exposure_multiplier = 2.0

[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Env_1"]
background_mode = 2
sky = SubResource("Sky_1")

