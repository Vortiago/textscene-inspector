[gd_scene format=3 uid="uid://unit_spatial_shader_transforms"]

; One unshaded spatial shader shared by three boxes: one under a rotated parent scaled unevenly, one
; under a parent with a negative scale, which turns its winding, and one with no parent.

[sub_resource type="Shader" id="Shader_1"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = vec3(UV, 0.5) * (NORMAL.z * 0.25 + 0.75);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_1"]
shader = SubResource("Shader_1")

[sub_resource type="BoxMesh" id="BoxMesh_1"]
