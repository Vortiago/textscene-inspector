[gd_scene load_steps=5 format=3 uid="uid://unit_animation_player_libraries"]

; AnimationPlayer whose clips are declared via Godot 4's dictionary-form
; `libraries = { "": SubResource(...) }` (the real serialization Godot writes),
; as opposed to the expanded slash form in unit-animation-player.tscn. Exercises
; the dict-form path in the AnimationPlayer parser's extractLibraries.

