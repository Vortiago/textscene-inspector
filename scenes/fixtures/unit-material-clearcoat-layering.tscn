; A clearcoat sphere beside the same sphere bare, under one OmniLight3D and a sky, for the one
; variable no other golden moves: how the coat layers over the light beneath it. No other golden
; draws a clearcoat. Godot 4.6.3 dims only the sky's ambient and reflection under the coat
; (scene_forward_clustered.glsl:1764-1773), so the coated sphere's lit side matches the bare one.
[gd_scene load_steps=7 format=3]

[sub_resource type="ProceduralSkyMaterial" id="SkyMat_1"]

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("SkyMat_1")

[sub_resource type="Environment" id="Env_1"]
background_mode = 2
sky = SubResource("Sky_1")
tonemap_mode = 0

[sub_resource type="SphereMesh" id="Sphere_1"]
radius = 0.8
height = 1.6
radial_segments = 48
rings = 24

[sub_resource type="StandardMaterial3D" id="Bare_1"]
