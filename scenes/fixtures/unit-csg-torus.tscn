[gd_scene load_steps=2 format=3 uid="uid://unitcsgtorus"]

; CSGTorus3D. Godot's ring lies in XZ with the hole on +Y. `sides` counts segments around the
; ring and `ring_sides` around the tube, the opposite of three's TorusGeometry naming.
; `smooth_faces` defaults to true here (csg_shape.cpp:2146), unlike CSGPolygon3D.

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_torus"]
albedo_color = Color(0.55, 0.45, 0.2, 1)

[node name="CSGTorusRoot" type="Node3D"]

; Vendored witness: scenes/demos/3d/csg/csg.tscn:268, a ring cut into a pillar.
; ring_sides = 5 is deliberately coarse: no cross-section vertex lands at the top
; of the tube, so the Y extent is tube * sin(72deg), not the tube radius.
[node name="Ring" type="CSGTorus3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
inner_radius = 0.25
outer_radius = 0.4
sides = 32
ring_sides = 5
material = SubResource("StandardMaterial3D_torus")

; Every dimension omitted, so this pins the previewer's defaults against Godot's
; 0.5 / 1.0 / 8 / 6. A wrong default only shows on a node like this.
[node name="DefaultTorus" type="CSGTorus3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 0, 0)

; smooth_faces = false exercises the non-default branch.
[node name="FacetedTorus" type="CSGTorus3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3, 0, 0)
inner_radius = 0.4
outer_radius = 0.9
sides = 12
ring_sides = 4
smooth_faces = false
material = SubResource("StandardMaterial3D_torus")

; Rotated 45 degrees about X, the only CSG fixture with a rotation, so it measures the
; Transform3D basis convention: basis_x/y/z are matrix rows in TSCN, while Godot's C++
; Basis(x, y, z) constructor sets columns. Reading it the C++ way transposes every rotation,
; which a translation-only scene cannot show.
[node name="TiltedTorus" type="CSGTorus3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.7071068, -0.7071068, 0, 0.7071068, 0.7071068, 0, 1.6, 0)
inner_radius = 0.3
outer_radius = 0.7
sides = 24
ring_sides = 12
material = SubResource("StandardMaterial3D_torus")
