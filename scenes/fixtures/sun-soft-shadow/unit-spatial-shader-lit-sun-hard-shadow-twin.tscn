[gd_scene format=3 uid="uid://unit_spatial_shader_lit_sun_hard_shadow_twin"]

; The soft shadow scene with the first sun's angular distance at 0, so it takes the PCF. The frame
; budget measures the pair, and the Performance overlay shows the soft shadow's GPU cost between them.

[sub_resource type="PlaneMesh" id="PlaneMesh_ground"]
size = Vector2(4, 4)

[sub_resource type="Shader" id="Shader_lit"]
code = "shader_type spatial;

uniform vec3 albedo = vec3(0.5);
uniform float sss = 0.0;

void fragment() {
	ALBEDO = albedo;
	ROUGHNESS = 1.0;
	SSS_STRENGTH = sss;
	SSS_TRANSMITTANCE_COLOR = vec4(1.0, 0.4, 0.2, 1.0);
	SSS_TRANSMITTANCE_DEPTH = 0.6;
	SSS_TRANSMITTANCE_BOOST = 0.2;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_ground"]
shader = SubResource("Shader_lit")

[sub_resource type="ShaderMaterial" id="ShaderMaterial_wall"]
shader = SubResource("Shader_lit")
shader_parameter/albedo = Vector3(0.8, 0.8, 0.8)
shader_parameter/sss = 0.5

[sub_resource type="BoxMesh" id="BoxMesh_post"]
size = Vector3(0.1, 1, 0.1)

[sub_resource type="BoxMesh" id="BoxMesh_wall"]
size = Vector3(1.6, 0.8, 0.06)

