[gd_scene format=4]

; BONE_INDICES and BONE_WEIGHTS of 4-weight and 8-weight surfaces, plain and compressed, and of a surface
; with no skin, each read by an unshaded spatial shader. No other golden reads a mesh's bones in a shader.

[sub_resource type="Shader" id="Shader_oweq8"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
varying vec4 c;
void vertex() { c = vec4(BONE_INDICES) / 11.0; }
void fragment() { ALBEDO = c.rgb * 0.8 + vec3(c.a) * 0.2; }
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_2qvib"]
render_priority = 0
shader = SubResource("Shader_oweq8")

[sub_resource type="Shader" id="Shader_cu26f"]
