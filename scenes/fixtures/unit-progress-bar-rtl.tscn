; One variable: `layout_direction = 3` on the lower ProgressBar. Under RTL ProgressBar swaps which
; horizontal fill mode counts as right-to-left (progress_bar.cpp:121), so FILL_BEGIN_TO_END fills
; from the right. The percentage label centres by its own arithmetic and must not move.
; `unit-progress-bar` is vertical and indeterminate, so neither piece meets a direction elsewhere.

[gd_scene format=3 uid="uid://unitprogressbarrtl"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; `value = 30` keeps the band clearly shorter than the track, so the end it grows from reads at a
; glance.
[node name="Ltr" type="ProgressBar" parent="."]
offset_left = 64.0
offset_top = 48.0
offset_right = 264.0
offset_bottom = 80.0
value = 30.0

[node name="Rtl" type="ProgressBar" parent="."]
layout_direction = 3
offset_left = 64.0
offset_top = 96.0
offset_right = 264.0
offset_bottom = 128.0
value = 30.0
