[gd_scene format=3 uid="uid://unit_item_list_guide_lines"]

; A LEFT icon-mode ItemList wrapping four plain rows into two columns, so the row-packing
; separators of `force_update_list_size` (item_list.cpp:1840) land between them. icon_mode is
; the one variable: unit-item-list.tscn uses TOP (0), where Godot draws no guide line
; (item_list.cpp:1447). No icon or override, so only panel, row text and guide lines show.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="MyItemList" type="ItemList" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 232.0
offset_bottom = 96.0
max_columns = 2
item_count = 4
item_0/text = "Sword"
item_1/text = "Shield"
item_2/text = "Potion"
item_3/text = "Bow"
