; The one variable: `layout_direction = 3` (RTL) with the line-number gutter drawn. The custom gutter
; region mirrors (text_edit.cpp:1471-1476), then the number right-aligns inside it
; (code_edit.cpp:1583-1587). `min_digits` 3 makes that visible. unit-text-edit-rtl.tscn has no gutter.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Ltr" type="CodeEdit" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_top = 16.0
offset_bottom = 120.0
text = "func f():\n\tpass\nDone"
gutters_draw_line_numbers = true
gutters_line_numbers_min_digits = 3

[node name="Rtl" type="CodeEdit" parent="."]
layout_mode = 1
layout_direction = 3
anchor_right = 1.0
offset_top = 152.0
offset_bottom = 256.0
text = "func f():\n\tpass\nDone"
gutters_draw_line_numbers = true
gutters_line_numbers_min_digits = 3
