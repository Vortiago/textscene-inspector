[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; Exercises every ADD_PROPERTY GraphEdit binds: scroll, grid and snapping, the port type-name
; dictionary, connection-line styling, the four zoom levels, the minimap and all six toolbar
; toggles. `type_names` and `connections` sit on one line each: the strict parser skips
; multi-line values, so Godot's wrapped form would never reach their validators.

[node name="MyGraphEdit" type="GraphEdit" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 408.0
offset_bottom = 328.0
scroll_offset = Vector2(32, 16)
show_grid = true
grid_pattern = 1
snapping_enabled = true
snapping_distance = 40
panning_scheme = 1
right_disconnects = true
type_names = { 0: "Number", 1: "Text" }
connection_lines_curvature = 0.25
connection_lines_thickness = 6.0
connection_lines_antialiased = false
connections = [{ "from_node": &"Source", "from_port": 0, "to_node": &"Sink", "to_port": 0, "keep_alive": true }]
zoom = 1.5
zoom_min = 0.25
zoom_max = 4.0
zoom_step = 1.5
minimap_enabled = true
minimap_size = Vector2(200, 120)
minimap_opacity = 0.4
show_menu = true
show_zoom_label = true
show_zoom_buttons = true
show_grid_buttons = false
show_minimap_button = false
show_arrange_button = false

; A third sibling, never the parent of Source and Sink: GraphFrame's `_resort` lays scene
; children into its own content rect and would collapse their `position_offset`. Its authored
; rect encloses both without GraphEdit's runtime-only autoshrink running.
[node name="Frame" type="GraphFrame" parent="MyGraphEdit"]
offset_right = 360.0
offset_bottom = 140.0
position_offset = Vector2(20, 20)
title = "Group"

; GraphEdit's own child placement, which the GraphNode-only unit-graph-node.tscn cannot move:
; Source and Sink sit at different `position_offset` values (`offset_left`/`offset_top` only size
; a GraphElement child once GraphEdit places it), so placing every child at one spot, or reading
; `offset_left`/`offset_top` as position, shows only once two children must land apart.
[node name="Source" type="GraphNode" parent="MyGraphEdit"]
offset_right = 120.0
offset_bottom = 64.0
position_offset = Vector2(40, 56)
title = "Add"
slot/0/right_enabled = true
slot/0/right_color = Color(0.4, 0.7, 1, 1)

[node name="Value" type="Label" parent="MyGraphEdit/Source"]
layout_mode = 2
text = "Value"

; Source and Sink each carry one `slot/0` (a right port and a left port) over one Label, so the
; port-icon placement (row y-centre, `port_h_offset`) shows here. unit-graph-node.tscn covers the
; slot geometry itself.
[node name="Sink" type="GraphNode" parent="MyGraphEdit"]
offset_right = 120.0
offset_bottom = 64.0
position_offset = Vector2(220, 56)
title = "Print"
slot/0/left_enabled = true
slot/0/left_color = Color(0.4, 0.7, 1, 1)

[node name="Result" type="Label" parent="MyGraphEdit/Sink"]
layout_mode = 2
text = "Result"
