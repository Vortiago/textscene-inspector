; One variable: what the surface shows when the sub-viewport's subtree has no DOM form. The other
; container fixtures (unit-sub-viewport-container.tscn, -stretch.tscn) hold ColorRects, which
; render as DOM whether or not a pixel reaches the surface from the render target. Only CanvasItem
; content proves the target → readPixels → <canvas> blit runs: regress it and these Polygon2Ds vanish.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; stretch is off, so the surface is exactly the sub-viewport's 200x150 and each probe addresses
; one target pixel. The bottom-right quadrant stays uncovered for the viewport's clear colour,
; Godot's default rgb(77, 77, 77), the constant the container paints in DOM: there a correct blit
; matches the backdrop and a wrong one does not.
[node name="Booth" type="SubViewportContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 400.0
offset_bottom = 280.0

; Asymmetric both ways, because the readback is bottom-up (GL's framebuffer origin is
; bottom-left) while a canvas is top-down. Band covers rows 0..39 at full width, which a vertical
; flip moves to rows 110..149. Mark covers rows 60..99, cols 10..49, which a horizontal flip moves
; to cols 150..189.
[node name="SubViewport" type="SubViewport" parent="Booth"]
size = Vector2i(200, 150)
render_target_update_mode = 4

; Color(0.5, 0.5, 0.5): sRGB 0.5 stores as linear 0.214, byte 55 in the target, and must show as
; about 128. It reads 55 if the blit forgets that the target is LinearSRGBColorSpace while a 2D
; canvas reads putImageData bytes as sRGB, a bug a pure-primary fixture cannot see, since the
; encode is the identity at 0 and 255.
[node name="Band" type="Polygon2D" parent="Booth/SubViewport"]
color = Color(0.5, 0.5, 0.5, 1)
polygon = PackedVector2Array(0, 0, 200, 0, 200, 40, 0, 40)

[node name="Mark" type="Polygon2D" parent="Booth/SubViewport"]
color = Color(1, 0.4, 0, 1)
polygon = PackedVector2Array(10, 60, 50, 60, 50, 100, 10, 100)
