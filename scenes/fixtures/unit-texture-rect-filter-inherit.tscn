[gd_scene load_steps=2 format=3 uid="uid://unittexturerectfilterinherit"]

; Three 200x200 TextureRects sample one 8x8 checkerboard, magnified 25x so magFilter dominates
; (as unit-material-texture-filter.tscn does in 3D). None names a texture_filter: the one
; variable is how PARENT_NODE resolves through the Control ancestor chain. No other TextureRect
; fixture puts a naming ancestor above an inheriting one.

[ext_resource type="Texture2D" path="res://textures/checkerboard-8px.svg" id="1_tex"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="NearestAncestor" type="Control" parent="."]
offset_right = 200.0
offset_bottom = 200.0
texture_filter = 1

; Its parent names texture_filter=1 (NEAREST): hard checker edges.
[node name="Nearest" type="TextureRect" parent="NearestAncestor"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
texture = ExtResource("1_tex")

[node name="ChainRoot" type="Control" parent="."]
offset_left = 250.0
offset_right = 450.0
offset_bottom = 200.0
texture_filter = 1

[node name="TransparentMiddle" type="Control" parent="ChainRoot"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
texture_filter = 0

; Its grandparent names NEAREST and its parent re-states PARENT_NODE (0): still hard edges, so
; a non-naming ancestor is transparent, not a wall that stops the walk at the viewport default.
[node name="NearestThroughChain" type="TextureRect" parent="ChainRoot/TransparentMiddle"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
texture = ExtResource("1_tex")

; No ancestor names a filter: soft edges, the viewport default (CANVAS_ITEM_TEXTURE_FILTER_LINEAR).
; Resolving PARENT_NODE straight to that default makes the other two look like this one.
[node name="LinearBaseline" type="TextureRect" parent="."]
offset_left = 500.0
offset_right = 700.0
offset_bottom = 200.0
texture = ExtResource("1_tex")
