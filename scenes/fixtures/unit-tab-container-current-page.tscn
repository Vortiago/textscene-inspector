; One variable: a TabContainer whose pages author no `visible`. `TabContainer::add_child_notify`
; hides each page as it is added (tab_container.cpp:651), and `_repaint` shows only `i == current`
; (tab_container.cpp:377-399, the split of `controls[i]->set_visible(i == current)` at :290-293).
; No `current_tab`, so `current` is 0, set by the first `add_tab` (tab_bar.cpp:1324-1331).

[gd_scene format=3 uid="uid://unittabcurrentpage"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; So page 0 draws, page 1 does not, and the strip selects tab 0. The editor writes
; `visible = false` on non-current pages itself, so the corpus passes whether or not the
; container writes anything. Only a hand-edited file like this one exposes it.
[node name="Tabs" type="TabContainer" parent="."]
offset_left = 64.0
offset_top = 48.0
offset_right = 464.0
offset_bottom = 288.0

[node name="General" type="ColorRect" parent="Tabs"]
color = Color(0.9, 0.2, 0.2, 1)

[node name="Advanced" type="ColorRect" parent="Tabs"]
color = Color(0.2, 0.4, 0.9, 1)
