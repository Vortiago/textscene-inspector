[gd_scene format=3 uid="uid://unit_spatial_shader_lit_outputs"]

; The one variable: unshaded spatial shaders that write the outputs only the light reads. Godot draws
; albedo and alpha only, so no write shows. The shaders read six defaults. The shader package's
; end-to-end scenes read each of the 18.
; No other golden writes these outputs, so only this one moves when the unshaded template reads them.

[sub_resource type="Shader" id="Shader_emission"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = vec3(UV, 0.3) * 0.6 + EMISSION + vec3(SPECULAR * 0.4);
	EMISSION = vec3(1.0, 0.0, 1.0);
	SPECULAR = 1.0;
	RIM = 1.0;
	RIM_TINT = 1.0;
	CLEARCOAT = 1.0;
	CLEARCOAT_ROUGHNESS = 1.0;
}
"

[sub_resource type="Shader" id="Shader_normal_map"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = NORMAL_MAP * vec3(UV, 1.0) + vec3(0.0, 0.0, NORMAL_MAP_DEPTH * 0.2);
	NORMAL_MAP = vec3(0.1, 0.9, 0.4);
	NORMAL_MAP_DEPTH = 4.0;
	BENT_NORMAL_MAP = vec3(0.9, 0.1, 0.6);
	ANISOTROPY = 1.0;
	ANISOTROPY_FLOW = vec2(0.0, 1.0);
}
"

[sub_resource type="Shader" id="Shader_sss"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = SSS_TRANSMITTANCE_COLOR.rgb + vec3(AO * 0.3, UV.y * 0.5, 0.4);
	SSS_STRENGTH = 1.0;
	SSS_TRANSMITTANCE_COLOR = vec4(1.0, 0.2, 0.2, 1.0);
	SSS_TRANSMITTANCE_DEPTH = 2.0;
	SSS_TRANSMITTANCE_BOOST = 1.0;
	BACKLIGHT = vec3(1.0, 1.0, 0.0);
	AO = 0.0;
	AO_LIGHT_AFFECT = 1.0;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_emission"]
shader = SubResource("Shader_emission")

[sub_resource type="ShaderMaterial" id="ShaderMaterial_normal_map"]
shader = SubResource("Shader_normal_map")

[sub_resource type="ShaderMaterial" id="ShaderMaterial_sss"]
shader = SubResource("Shader_sss")

[sub_resource type="BoxMesh" id="BoxMesh_1"]
material = SubResource("ShaderMaterial_emission")

[sub_resource type="SphereMesh" id="SphereMesh_1"]
material = SubResource("ShaderMaterial_normal_map")

[sub_resource type="CylinderMesh" id="CylinderMesh_1"]
material = SubResource("ShaderMaterial_sss")

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.1, 0.12, 0.16, 1)

[node name="Root" type="Node3D"]

