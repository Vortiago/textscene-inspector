[node name="Masked1" type="Polygon2D" parent="."]
color = Color(0.25, 0.25, 0.25, 1)
polygon = PackedVector2Array(0, 0, 384, 0, 384, 540, 0, 540)

[node name="Masked2" type="Polygon2D" parent="."]
light_mask = 2
color = Color(0.25, 0.25, 0.25, 1)
polygon = PackedVector2Array(384, 0, 768, 0, 768, 540, 384, 540)

[node name="Unmasked" type="Polygon2D" parent="."]
light_mask = 0
z_index = 2000
color = Color(0.25, 0.25, 0.25, 1)
polygon = PackedVector2Array(768, 0, 1152, 0, 1152, 540, 768, 540)

[node name="Sun" type="DirectionalLight2D" parent="."]
