[gd_scene load_steps=4 format=3]

; One variable: whether a Sprite3D at default `alpha_cut` and full modulate alpha reaches the
; blended pass. Invisible elsewhere: the other Sprite3D scenes draw an RGB marker with no alpha
; channel and an inline gradient with alpha 1 at both stops, so no other sprite texel is
; non-opaque, and nothing stands behind them, as the wall stands behind this one.

[ext_resource type="Texture2D" path="res://textures/dodge-walk1.png" id="1_walk"]
; Its transparent texels carry RGB (0, 0, 0), so an opaque read is a hard black rectangle on the
; wall, and the antialiased edge band is the graded half of the same failure.

[sub_resource type="QuadMesh" id="QuadMesh_wall"]
size = Vector2(3.2, 2.6)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_wall"]
shading_mode = 0
albedo_color = Color(0.15, 0.55, 0.85, 1)

[node name="Scene" type="Node3D"]

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 2.5)
fov = 70.0

; With nothing behind a sprite, blending an opaque texel paints what an opaque write does, and no
; depth-tested geometry is there for `depth_draw_opaque`'s skipped write to lose.
[node name="Wall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.5)
mesh = SubResource("QuadMesh_wall")
surface_material_override/0 = SubResource("StandardMaterial3D_wall")

; Strictly inside the wall on all four sides, so the black rectangle cannot be read as the
; environment. Only texture and pixel_size: a modulate alpha below 1, a `transparency` or a
; non-default `alpha_cut` blend under the wrong rule too. It is the only alpha-pass object, so the
; baseline pins no transparent sort order.
[node name="TransparentSprite" type="Sprite3D" parent="."]
; `_update_shader` emits `ALPHA *= albedo.a * albedo_tex.a` for any transparency but DISABLED
; (`material.cpp:1836`), and FLAG_PASS_ALPHA follows the shader's booleans
; (`render_forward_clustered.cpp:4079-4090`). Gating on the modulate alpha instead files this
; sprite in the opaque list, where blending is off: each a=0 texel paints its RGB and writes depth.
texture = ExtResource("1_walk")
pixel_size = 0.01
