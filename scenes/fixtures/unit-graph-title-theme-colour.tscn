[gd_scene load_steps=4 format=3 uid="uid://unitgraphtitlethm"]

; The title Label of a GraphNode or GraphFrame is a Label on the GraphNodeTitleLabel or GraphFrameTitleLabel variation,
; so it reads font_color through the Theme chain (graph_node.cpp, graph_frame.cpp). A Theme that sets Label colours
; the title. A GraphNodeTitleLabel entry beats the Label entry. A Button entry does not reach it. The Theme on each
; node is the one variable.

[sub_resource type="Theme" id="Theme_label"]
Label/colors/font_color = Color(1, 0.2, 0.2, 1)

[sub_resource type="Theme" id="Theme_variation"]
Label/colors/font_color = Color(1, 0.2, 0.2, 1)
GraphNodeTitleLabel/colors/font_color = Color(0.2, 1, 0.2, 1)

[sub_resource type="Theme" id="Theme_frame"]
