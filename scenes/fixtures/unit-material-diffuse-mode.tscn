[gd_scene format=3]

; diffuse_mode, one sphere each: Burley, Lambert, Lambert wrap and toon, left to right. The light
; comes from +X, so each mode's terminator shows. Every other lit scene draws Burley alone, so no
; other golden shows a regression in the other three modes.

[sub_resource type="SphereMesh" id="SphereMesh_1"]
radius = 0.9
height = 1.8
radial_segments = 48
rings = 24

[sub_resource type="StandardMaterial3D" id="Material_burley"]
albedo_color = Color(0.85, 0.85, 0.85, 1)
roughness = 0.6

[sub_resource type="StandardMaterial3D" id="Material_lambert"]
albedo_color = Color(0.85, 0.85, 0.85, 1)
roughness = 0.6
diffuse_mode = 1

[sub_resource type="StandardMaterial3D" id="Material_lambert_wrap"]
albedo_color = Color(0.85, 0.85, 0.85, 1)
roughness = 0.6
diffuse_mode = 2

[sub_resource type="StandardMaterial3D" id="Material_toon"]
albedo_color = Color(0.85, 0.85, 0.85, 1)
roughness = 0.6
diffuse_mode = 3

[node name="Root" type="Node3D"]

[node name="Burley" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3, 0, 0)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Material_burley")

[node name="Lambert" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1, 0, 0)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Material_lambert")

[node name="LambertWrap" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1, 0, 0)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Material_lambert_wrap")

[node name="Toon" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 0, 0)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Material_toon")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 0, 0, 0)
