; One variable: `layout_direction = 3` on the lower HSlider. Under RTL the horizontal arm of
; `Slider::_notification` reverses the ratio before it truncates (slider.cpp:331-339,363): the
; `grabber_area` fills from the right edge and the grabber travels from the right. The track and
; ticks stay. `unit-hslider` and `unit-vslider` are LTR, and no other scene sets a direction on a Slider.

[gd_scene format=3 uid="uid://unithsliderrtl"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; Both rows are 120 wide at `value = 30`, so the grabber travel (120 - 16) is 104 and both sides
; land on a fractional product (31.2 and 72.8). Mirroring the LTR rect instead of reversing the
; ratio lands one pixel out on each, which a round travel would hide.
[node name="Ltr" type="HSlider" parent="."]
offset_left = 64.0
offset_top = 48.0
offset_right = 184.0
offset_bottom = 64.0
value = 30.0

[node name="Rtl" type="HSlider" parent="."]
layout_direction = 3
offset_left = 64.0
offset_top = 96.0
offset_right = 184.0
offset_bottom = 112.0
value = 30.0
