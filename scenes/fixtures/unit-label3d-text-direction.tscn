; One variable: the paragraph direction of a Label3D, through `text_direction`, `language` and the
; structured override (label_3d.cpp:479-494). `language` also picks the case map of `uppercase`.
; Only the glyph order changes: the block keeps its alignment and offset.

[gd_scene load_steps=5 format=3]

[ext_resource type="FontFile" path="res://fonts/dejavu-sans-bidi-subset.ttf" id="1_font"]

[sub_resource type="QuadMesh" id="QuadMesh_backdrop"]
size = Vector2(14, 9)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_backdrop"]
shading_mode = 0
albedo_color = Color(0.1, 0.12, 0.18, 1)

[node name="Root" type="Node3D"]

[node name="Backdrop" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.05)
mesh = SubResource("QuadMesh_backdrop")
surface_material_override/0 = SubResource("StandardMaterial3D_backdrop")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.1, 4.5)

; RTL puts `!` at the visual left. The CENTER alignment does not move.
[node name="Rtl" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 1.6, 0)
pixel_size = 0.005
font = ExtResource("1_font")
font_size = 48
outline_size = 0
text = "Hello!"
text_direction = 2

; AUTO infers RTL from Hebrew.
[node name="AutoHebrew" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 0.8, 0)
pixel_size = 0.005
font = ExtResource("1_font")
font_size = 48
outline_size = 0
text = "שלום abc!"

; The value 3 acts as AUTO, which infers LTR from `H`.
[node name="Three" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 0.0, 0)
pixel_size = 0.005
font = ExtResource("1_font")
font_size = 48
outline_size = 0
text = "Hello!"
text_direction = 3

; Hebrew sets the direction of neutral text.
[node name="NeutralHe" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, -0.8, 0)
pixel_size = 0.005
font = ExtResource("1_font")
font_size = 48
outline_size = 0
text = "123!"
language = "he"

; Turkish upper-cases i to the dotted capital I.
[node name="UpperTr" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, -1.6, 0)
pixel_size = 0.005
font = ExtResource("1_font")
font_size = 48
outline_size = 0
text = "istanbul"
uppercase = true
language = "tr"

; FILE keeps each path segment in logical order, left to right.
[node name="File" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.6, 1.6, 0)
pixel_size = 0.005
font = ExtResource("1_font")
font_size = 48
outline_size = 0
text = "שלום/עולם/abc.txt"
text_direction = 2
structured_text_bidi_override = 2

; Without an override, the RTL paragraph puts the Latin name at the visual left.
[node name="NoOverride" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.6, 0.8, 0)
pixel_size = 0.005
font = ExtResource("1_font")
font_size = 48
outline_size = 0
text = "שלום/עולם/abc.txt"
text_direction = 2

; An LTR paragraph keeps `!` last and reverses each Hebrew word in place.
[node name="HebrewLtr" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.6, 0.0, 0)
pixel_size = 0.005
font = ExtResource("1_font")
font_size = 48
outline_size = 0
text = "שלום עולם!"
text_direction = 1
