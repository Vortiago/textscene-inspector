[gd_scene format=3 uid="uid://unitvolfogshadow"]

; The volumetric fog's directional shadow: a thin box under a DirectionalLight3D tilted 60 degrees
; with shadow_enabled on leaves a dark column in the fog below and behind it. Godot draws the column
; only for a light that casts. The shadowed omni in unit-world-environment-basic moves that golden
; by at most 1/255, so no other golden shows the fog's shadow.

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.1, 0.12, 0.2, 1)
volumetric_fog_enabled = true
volumetric_fog_density = 0.1

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(3, 0.2, 3)

[sub_resource type="StandardMaterial3D" id="Material_1"]
albedo_color = Color(0.8, 0.5, 0.3, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Box" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Material_1")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.5, 0.866025, 0, -0.866025, 0.5, 0, 4, 0)
shadow_enabled = true

[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.984808, 0.173648, 0, -0.173648, 0.984808, 0, 2, 7)
fov = 70.0
