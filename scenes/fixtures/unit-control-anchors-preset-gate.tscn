[gd_scene format=3]

; The one variable: whether `anchors_preset` applies. Godot applies it only at layout_mode 1 or 3, and
; the field defaults to 0: red (1, point) and green (1, wide) move, blue (no layout_mode) and yellow
; (2, in a container) keep raw anchors. Every other fixture states preset 0 or explicit anchors,
; which no gate stops.

[node name="Root" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="GateOpenPoint" type="ColorRect" parent="."]
custom_minimum_size = Vector2(160, 96)
layout_mode = 1
anchors_preset = 6
color = Color(0.9, 0.25, 0.2, 1)

[node name="GateOpenWide" type="ColorRect" parent="."]
custom_minimum_size = Vector2(120, 64)
layout_mode = 1
anchors_preset = 12
color = Color(0.2, 0.7, 0.35, 1)

[node name="GateClosedNoLayoutMode" type="ColorRect" parent="."]
anchors_preset = 15
offset_left = 40.0
offset_top = 40.0
offset_right = 240.0
offset_bottom = 160.0
color = Color(0.25, 0.45, 0.95, 1)

[node name="Column" type="VBoxContainer" parent="."]
offset_left = 40.0
offset_top = 240.0
offset_right = 360.0
offset_bottom = 440.0

[node name="GateClosedContainer" type="ColorRect" parent="Column"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
anchors_preset = 15
color = Color(0.95, 0.8, 0.2, 1)
