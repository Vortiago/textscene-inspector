; One variable: `layout_direction = 3` (RTL) on the Control the windows sit under. A Window states
; no direction of its own (`window.cpp:3397` binds no property), so it inherits the Control's: its
; HBoxContainer lays out right to left, and the narrow window's trimmed title shapes right to left.

[gd_scene format=3]

[node name="Root" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
layout_direction = 3

[node name="Bg" type="ColorRect" parent="."]
offset_right = 1152.0
offset_bottom = 648.0
color = Color(0.2, 0.3, 0.5, 1)

[node name="Wide" type="Window" parent="."]
title = "Hello window"
position = Vector2i(100, 120)
size = Vector2i(300, 200)

[node name="Row" type="HBoxContainer" parent="Wide"]
offset_left = 10.0
offset_top = 10.0
offset_right = 290.0
offset_bottom = 60.0

[node name="Red" type="ColorRect" parent="Wide/Row"]
custom_minimum_size = Vector2(60, 50)
layout_mode = 2
color = Color(0.9, 0.2, 0.2, 1)

[node name="Green" type="ColorRect" parent="Wide/Row"]
custom_minimum_size = Vector2(40, 50)
layout_mode = 2
color = Color(0.2, 0.9, 0.2, 1)

[node name="Narrow" type="Window" parent="."]
title = "A much longer window title"
position = Vector2i(560, 120)
size = Vector2i(160, 120)
