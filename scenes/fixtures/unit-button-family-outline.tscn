[gd_scene format=3 uid="uid://unitbuttonfamilyoutline"]

; The one variable: the theme text outline of Button, CheckBox, CheckButton, OptionButton and
; MenuButton. Each draws "Btn" at font_size 48 with a red outline_size 8. Every other scene of
; these Controls leaves outline_size at its default 0, so none shows a regression in it.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Button" type="Button" parent="."]
layout_mode = 0
offset_left = 20.0
offset_top = 20.0
offset_right = 220.0
offset_bottom = 100.0
text = "Btn"
theme_override_colors/font_outline_color = Color(1, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 48

[node name="CheckBox" type="CheckBox" parent="."]
layout_mode = 0
offset_left = 20.0
offset_top = 120.0
offset_right = 220.0
offset_bottom = 200.0
text = "Chk"
theme_override_colors/font_outline_color = Color(1, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 48

[node name="CheckButton" type="CheckButton" parent="."]
layout_mode = 0
offset_left = 20.0
offset_top = 220.0
offset_right = 220.0
offset_bottom = 300.0
text = "Chk"
theme_override_colors/font_outline_color = Color(1, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 48

[node name="OptionButton" type="OptionButton" parent="."]
layout_mode = 0
offset_left = 20.0
offset_top = 320.0
offset_right = 220.0
offset_bottom = 400.0
item_count = 1
selected = 0
popup/item_0/text = "Opt"
popup/item_0/id = 0
theme_override_colors/font_outline_color = Color(1, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 48

[node name="MenuButton" type="MenuButton" parent="."]
layout_mode = 0
offset_left = 20.0
offset_top = 420.0
offset_right = 220.0
offset_bottom = 500.0
text = "Menu"
