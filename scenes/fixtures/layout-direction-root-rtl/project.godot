; A res:// root of its own, because
; `internationalization/rendering/root_node_layout_direction` is a PROJECT
; setting and no .tscn can carry one. Kept in a subdirectory rather than at
; scenes/fixtures — a project.godot there would silently apply to every other
; fixture in the flat bag.

config_version=5

[application]

config/name="Right-to-left root layout direction"
run/main_scene="res://unit-control-layout-direction-root.tscn"
config/features=PackedStringArray("4.6")

[internationalization]

rendering/root_node_layout_direction=2
