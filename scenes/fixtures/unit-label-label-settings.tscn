[gd_scene load_steps=2 format=3 uid="uid://unit_label_label_settings"]

[sub_resource type="LabelSettings" id="LabelSettings_1"]
font_size = 32
font_color = Color(1, 0, 0, 1)
line_spacing = 10.0

; A `label_settings` resource on a Label that also authors theme_override_colors and
; theme_override_font_sizes: which one wins is the one variable. `label_settings` beats the
; node-local override (label.cpp:759,761), so the label draws at font_size 32 in red, not the
; override's 12/blue. Merging the two draws neither colour the baseline shows.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Label" type="Label" parent="."]
anchors_preset = 0
offset_left = 20.0
offset_top = 20.0
offset_right = 260.0
offset_bottom = 100.0
theme_override_colors/font_color = Color(0, 0, 1, 1)
theme_override_font_sizes/font_size = 12
text = "Settings win"
label_settings = SubResource("LabelSettings_1")
