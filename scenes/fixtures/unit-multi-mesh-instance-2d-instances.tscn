[gd_scene format=3]

; Draws a MultiMesh through MultiMeshInstance2D on the 2D canvas: four instances under their own 2D
; transform and colour (identity, a quarter turn, scale 2 at half alpha, blue), the same buffer under
; visible_instance_count = 2, a node modulate with no colours and no texture, and a 3D transform
; format, which Godot's canvas draws as nothing. No other scene has a MultiMeshInstance2D, so none
; shows a regression in how the canvas reads a MultiMesh.

[ext_resource type="Texture2D" path="res://textures/atlas-quadrants.png" id="1_quadrants"]

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(40, 40)

[sub_resource type="MultiMesh" id="MultiMesh_coloured"]
use_colors = true
instance_count = 4
mesh = SubResource("QuadMesh_1")
buffer = PackedFloat32Array(1, 0, 0, 50, 0, 1, 0, 50, 1, 1, 1, 1, 0, -1, 0, 150, 1, 0, 0, 50, 1, 0, 0, 1, 2, 0, 0, 300, 0, 2, 0, 80, 1, 1, 1, 0.5, 1, 0, 0, 330, 0, 1, 0, 80, 0, 0, 1, 1)

[sub_resource type="MultiMesh" id="MultiMesh_visible"]
use_colors = true
instance_count = 4
visible_instance_count = 2
mesh = SubResource("QuadMesh_1")
buffer = PackedFloat32Array(1, 0, 0, 50, 0, 1, 0, 50, 1, 1, 1, 1, 0, -1, 0, 150, 1, 0, 0, 50, 1, 0, 0, 1, 2, 0, 0, 300, 0, 2, 0, 80, 1, 1, 1, 0.5, 1, 0, 0, 330, 0, 1, 0, 80, 0, 0, 1, 1)

[sub_resource type="MultiMesh" id="MultiMesh_plain"]
instance_count = 2
mesh = SubResource("QuadMesh_1")
buffer = PackedFloat32Array(1, 0, 0, 50, 0, 1, 0, 50, 1, 0, 0, 120, 0, 1, 0, 50)

[sub_resource type="MultiMesh" id="MultiMesh_3d"]
transform_format = 1
instance_count = 1
mesh = SubResource("QuadMesh_1")
buffer = PackedFloat32Array(1, 0, 0, 50, 0, 1, 0, 50, 0, 0, 1, 0)

[node name="Root" type="Node2D"]

[node name="Coloured" type="MultiMeshInstance2D" parent="."]
