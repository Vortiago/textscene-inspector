; ONE VARIABLE: `layout_direction = 3` (RTL) on the lower CheckButton.
;
; CheckButton is the only Button-family type with its own `_mirrored` icon
; table: under RTL it draws `toggle_on_mirrored` rather than `toggle_on`
; (check_button.cpp:109-120), a separately authored SVG whose knob sits on the
; opposite end, and it moves the toggle to the LEFT content margin (:135).
; Both rows are `button_pressed` so the knob is on the far side of its track
; and a missed icon swap cannot hide behind a moved one.
;
; `unit-check-button` is LTR and carries no text; no other scene pairs a
; CheckButton with a layout direction.

[gd_scene format=3 uid="uid://unitcheckbuttonrtl"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Ltr" type="CheckButton" parent="."]
offset_left = 64.0
offset_top = 48.0
offset_right = 384.0
offset_bottom = 80.0
button_pressed = true
text = "Vertical sync"

[node name="Rtl" type="CheckButton" parent="."]
layout_direction = 3
offset_left = 64.0
offset_top = 112.0
offset_right = 384.0
offset_bottom = 144.0
button_pressed = true
text = "Vertical sync"
