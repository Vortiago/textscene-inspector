; One variable: `layout_direction = 3` on a LineEdit. Godot swaps the LEFT/FILL and RIGHT arms of
; `switch (alignment)` (line_edit.cpp:1397-1421), moves the clear button to the left margin
; (:1455-1458), floors the text past that icon instead of back from the right edge (:1473-1474),
; and stops subtracting the icon from `ofs_max` (:1481-1483).

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; Each RTL row pairs with its LTR twin, and the clear-button pair separates the icon side from
; the alignment swap. Full-width LineEdits make the rect mirror (control.cpp:1785) the identity.
; No other fixture pairs a LineEdit with a direction.
[node name="LtrLeft" type="LineEdit" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_top = 16.0
offset_bottom = 56.0
text = "Wave rift"
alignment = 0

[node name="LtrRight" type="LineEdit" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_top = 64.0
offset_bottom = 104.0
text = "Wave rift"
alignment = 2

[node name="LtrClear" type="LineEdit" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_top = 112.0
offset_bottom = 152.0
text = "Wave rift"
alignment = 2
clear_button_enabled = true

[node name="RtlLeft" type="LineEdit" parent="."]
layout_mode = 1
layout_direction = 3
anchor_right = 1.0
offset_top = 200.0
offset_bottom = 240.0
text = "Wave rift"
alignment = 0

[node name="RtlRight" type="LineEdit" parent="."]
layout_mode = 1
layout_direction = 3
anchor_right = 1.0
offset_top = 248.0
offset_bottom = 288.0
text = "Wave rift"
alignment = 2

[node name="RtlClear" type="LineEdit" parent="."]
layout_mode = 1
layout_direction = 3
anchor_right = 1.0
offset_top = 296.0
offset_bottom = 336.0
text = "Wave rift"
alignment = 2
clear_button_enabled = true
