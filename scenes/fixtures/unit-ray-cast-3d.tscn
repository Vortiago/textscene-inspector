; RayCast3D draws its editor ray gizmo for every node with the Gizmos toggle on (ADR-0056), which no
; other golden enables for a RayCast3D: the origin-to-target_position line and the pyramid of the
; authored debug_shape_thickness = 3, in the authored custom red, so the golden pins the gizmo's
; extent and look for one node type alone. No mesh draws, so the camera frames on the gizmo's own
; lines and fill.
[gd_scene format=3]

[node name="Root" type="Node3D"]

[node name="MyRayCast3D" type="RayCast3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
enabled = true
exclude_parent = false
target_position = Vector3(0, -3, 0)
collision_mask = 3
hit_from_inside = true
hit_back_faces = false
collide_with_areas = true
collide_with_bodies = true
debug_shape_custom_color = Color(1, 0, 0, 1)
debug_shape_thickness = 3
