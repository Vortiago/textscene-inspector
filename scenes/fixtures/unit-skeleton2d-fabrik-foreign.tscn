[gd_scene format=3]

; Moves one variable: a FABRIK chain on the skeleton Near whose joints name the bones of the
; skeleton Far. Godot moves the bones of Far to the red target, and gives each bone of Near the
; local transform of the bone of Far at its index. The strip skinned to Far follows its bones. No
; other golden names a bone of another skeleton.

[sub_resource type="SkeletonModification2DFABRIK" id="chain"]
target_nodepath = NodePath("../Target")
fabrik_data_chain_length = 3
joint_data/0/bone_index = 0
joint_data/0/bone2d_node = NodePath("../Far/A")
joint_data/1/bone_index = 1
joint_data/1/bone2d_node = NodePath("../Far/A/B")
joint_data/2/bone_index = 2
joint_data/2/bone2d_node = NodePath("../Far/A/B/C")

[sub_resource type="SkeletonModificationStack2D" id="stack"]
enabled = true
modification_count = 1
modifications/0 = SubResource("chain")

[node name="Root" type="Node2D"]

[node name="Near" type="Skeleton2D" parent="."]
position = Vector2(200, 120)
modification_stack = SubResource("stack")

[node name="A" type="Bone2D" parent="Near"]
rest = Transform2D(1, 0, 0, 1, 0, 0)

[node name="Bar" type="Polygon2D" parent="Near/A"]
color = Color(0.95, 0.55, 0.15, 1)
polygon = PackedVector2Array(0, -8, 80, -8, 80, 8, 0, 8)

[node name="B" type="Bone2D" parent="Near/A"]
position = Vector2(80, 0)
rest = Transform2D(1, 0, 0, 1, 80, 0)

[node name="Bar" type="Polygon2D" parent="Near/A/B"]
color = Color(0.2, 0.6, 0.95, 1)
polygon = PackedVector2Array(0, -8, 80, -8, 80, 8, 0, 8)

[node name="C" type="Bone2D" parent="Near/A/B"]
position = Vector2(80, 0)
rest = Transform2D(1, 0, 0, 1, 80, 0)
auto_calculate_length_and_angle = false
length = 80.0

[node name="Bar" type="Polygon2D" parent="Near/A/B/C"]
color = Color(0.6, 0.4, 0.9, 1)
polygon = PackedVector2Array(0, -8, 80, -8, 80, 8, 0, 8)

[node name="Far" type="Skeleton2D" parent="."]
position = Vector2(200, 330)

[node name="A" type="Bone2D" parent="Far"]
rest = Transform2D(1, 0, 0, 1, 0, 0)

[node name="Bar" type="Polygon2D" parent="Far/A"]
color = Color(0.95, 0.55, 0.15, 1)
polygon = PackedVector2Array(0, -8, 80, -8, 80, 8, 0, 8)

[node name="B" type="Bone2D" parent="Far/A"]
position = Vector2(80, 0)
rest = Transform2D(1, 0, 0, 1, 80, 0)

[node name="Bar" type="Polygon2D" parent="Far/A/B"]
color = Color(0.2, 0.6, 0.95, 1)
polygon = PackedVector2Array(0, -8, 80, -8, 80, 8, 0, 8)

[node name="C" type="Bone2D" parent="Far/A/B"]
position = Vector2(80, 0)
rest = Transform2D(1, 0, 0, 1, 80, 0)
auto_calculate_length_and_angle = false
length = 80.0

[node name="Bar" type="Polygon2D" parent="Far/A/B/C"]
color = Color(0.6, 0.4, 0.9, 1)
polygon = PackedVector2Array(0, -8, 80, -8, 80, 8, 0, 8)

[node name="Strip" type="Polygon2D" parent="."]
position = Vector2(200, 330)
skeleton = NodePath("../Far")
color = Color(0.3, 0.8, 0.4, 1)
polygon = PackedVector2Array(0, 16, 80, 16, 160, 16, 240, 16, 240, 30, 160, 30, 80, 30, 0, 30)
bones = [NodePath("A"), PackedFloat32Array(1, 0.5, 0, 0, 0, 0, 0.5, 1), NodePath("A/B"), PackedFloat32Array(0, 0.5, 0.5, 0, 0, 0.5, 0.5, 0), NodePath("A/B/C"), PackedFloat32Array(0, 0, 0.5, 1, 1, 0.5, 0, 0)]

[node name="Target" type="Node2D" parent="."]
position = Vector2(330, 500)

[node name="Mark" type="Polygon2D" parent="Target"]
color = Color(0.9, 0.25, 0.25, 1)
polygon = PackedVector2Array(-6, -6, 6, -6, 6, 6, -6, 6)
