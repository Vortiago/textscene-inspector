[gd_scene load_steps=4 format=3 uid="uid://unitdecalgradtex"]

; ONE VARIABLE: a Decal whose `texture_albedo` is an INLINE GradientTexture2D
; sub-resource rather than an image file.
;
; The decal's albedo is the only thing it projects — with the slot unresolved
; the node contributes nothing at all to the frame and the floor reads as an
; undecorated plane, which is exactly what an unlit missing texture looks like
; from above, so nothing else flags it. `unit-decal` and
; `unit-animation-player-decal` both use an ExtResource image and are untouched
; by a regression in the inline branch.
;
; Radial fill so the projection's footprint is legible against the flat floor
; and its centre is a single unambiguous probe point.

[sub_resource type="PlaneMesh" id="PlaneMesh_floor"]
size = Vector2(8, 8)

[sub_resource type="Gradient" id="Gradient_stain"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0.9, 0.25, 0.1, 1, 0.1, 0.2, 0.7, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_stain"]
gradient = SubResource("Gradient_stain")
width = 128
height = 128
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[node name="Scene" type="Node3D"]

[node name="Floor" type="MeshInstance3D" parent="."]
mesh = SubResource("PlaneMesh_floor")

[node name="InlineGradient" type="Decal" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
texture_albedo = SubResource("GradientTexture2D_stain")
size = Vector3(3, 3, 3)
albedo_mix = 1.0
