[gd_scene format=3]

; A Control with anchors_preset, an explicit offset and a theme_override_colors entry, as Godot's
; custom_drawing.tscn has. It must lint clean.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="Control" parent="."]
anchors_preset = 15
offset_right = 172.0
theme_override_colors/font_color = Color(0.9, 0.9, 0.9, 1)
