; One variable: `layout_direction = 3` on the lower MenuBar. `MenuBar::_get_menu_item_rect`
; mirrors every item inside the bar's width under RTL (menu_bar.cpp:424), so the first menu sits
; at the trailing edge and the order runs back. No other MenuBar scene pairs a direction with a
; bar wider than its content.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.12, 0.18, 1)

; Both bars are far wider than their minimum: a bar shrunk to its content puts the same pixels
; in the same place either way. The titles differ in width, so a reversal is not a mirror of
; equal blocks, and `flat` stays false so each item's StyleBox marks where it landed.
[node name="Ltr" type="MenuBar" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_left = 120.0
offset_top = 48.0
offset_right = -120.0
offset_bottom = 88.0
flat = false

[node name="File" type="PopupMenu" parent="Ltr"]
title = "File"

[node name="Preferences" type="PopupMenu" parent="Ltr"]
title = "Preferences"

[node name="Help" type="PopupMenu" parent="Ltr"]
title = "Help"

[node name="Rtl" type="MenuBar" parent="."]
layout_mode = 1
layout_direction = 3
anchor_right = 1.0
offset_left = 120.0
offset_top = 144.0
offset_right = -120.0
offset_bottom = 184.0
flat = false

[node name="File" type="PopupMenu" parent="Rtl"]
title = "File"

[node name="Preferences" type="PopupMenu" parent="Rtl"]
title = "Preferences"

[node name="Help" type="PopupMenu" parent="Rtl"]
title = "Help"
