; One variable: a PointLight2D reaches native Controls. Godot lights a Control like any CanvasItem,
; so the ColorRect, the Panel with a StyleBoxFlat and the Label each take the light by pixel. The
; scene has no CanvasModulate and no CanvasItemMaterial, and no other golden holds a light over a
; Control, so the Controls draw flat grey if the pass skips them.

[gd_scene format=3]

[sub_resource type="Gradient" id="Gradient_cookie"]
offsets = PackedFloat32Array(0.02, 0.65)
colors = PackedColorArray(0.85, 0.85, 0.85, 1, 0, 0, 0, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_cookie"]
gradient = SubResource("Gradient_cookie")
width = 160
height = 160
fill = 1
fill_from = Vector2(0.5, 0.5)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.2, 0.4, 0.3, 1)
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 6
border_color = Color(0.6, 0.55, 0.2, 1)
corner_radius_top_left = 20
corner_radius_top_right = 20
corner_radius_bottom_right = 20
corner_radius_bottom_left = 20

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Rect" type="ColorRect" parent="."]
offset_left = 40.0
offset_top = 40.0
offset_right = 340.0
offset_bottom = 240.0
color = Color(0.5, 0.4, 0.3, 1)

[node name="Panel" type="Panel" parent="."]
offset_left = 380.0
offset_top = 40.0
offset_right = 680.0
offset_bottom = 240.0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Label" type="Label" parent="."]
offset_left = 720.0
offset_top = 110.0
offset_right = 1100.0
offset_bottom = 170.0
text = "Lit label"
theme_override_colors/font_color = Color(0.7, 0.6, 0.5, 1)
theme_override_font_sizes/font_size = 48

[node name="Torch" type="PointLight2D" parent="."]
position = Vector2(300, 140)
texture = SubResource("GradientTexture2D_cookie")
color = Color(1, 0.55, 0.2, 1)
energy = 1.2
texture_scale = 4.0

[node name="Moon" type="PointLight2D" parent="."]
position = Vector2(820, 140)
texture = SubResource("GradientTexture2D_cookie")
color = Color(0.3, 0.5, 1, 1)
energy = 1.0
texture_scale = 4.0
