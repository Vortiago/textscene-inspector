[gd_scene format=3]

; The In-game view draws its 3D world, then a CanvasLayer over it (`renderer_viewport.cpp:380-385`).
; The variable is the composite: a current Camera3D over one unshaded box, and one ColorRect on a
; CanvasLayer. No other golden draws a canvas over the root viewport's world, so no other scene shows
; a regression in it.

[sub_resource type="BoxMesh" id="BoxMesh_1"]

