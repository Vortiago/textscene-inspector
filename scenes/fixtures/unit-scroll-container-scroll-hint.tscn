; One variable: `scroll_hint_mode` on a ScrollContainer. `_update_scroll_hints`
; (`scroll_container.cpp:606-658`) toggles two TextureRects that fade the edge the content runs
; past. At the default offset only the bottom-right one shows (the top-left needs
; `v_scroll_value > 1`, `:623`), and only while the other axis fits (`:623,633,641,651`).

[gd_scene format=3 uid="uid://unit_scroll_container_scroll_hint"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.95, 0.95, 0.92, 1)

; Overflows on height alone (a 200x420 child in a 240x200 box), `Horizontal` on width alone (a
; 500x160 child), so they show the two icons: `scroll_hint_vertical.svg` across the bottom 24px
; band and `scroll_hint_horizontal.svg` down the trailing 24px column, each flipped so the fade
; is densest against its own edge (`:630,647`).
[node name="Vertical" type="ScrollContainer" parent="."]
layout_mode = 1
offset_left = 24.0
offset_top = 24.0
offset_right = 264.0
offset_bottom = 224.0
scroll_hint_mode = 1

[node name="Tall" type="ColorRect" parent="Vertical"]
layout_mode = 2
custom_minimum_size = Vector2(200, 420)
color = Color(0.98, 0.92, 0.72, 1)

; Both are at `scroll_hint_mode = 1` (ALL). The two directional modes select a subset of the same
; pair and add no icon. Every other ScrollContainer fixture stays at DISABLED, which draws
; neither node.
[node name="Horizontal" type="ScrollContainer" parent="."]
layout_mode = 1
offset_left = 300.0
offset_top = 24.0
offset_right = 540.0
offset_bottom = 224.0
scroll_hint_mode = 1

[node name="Wide" type="ColorRect" parent="Horizontal"]
layout_mode = 2
custom_minimum_size = Vector2(500, 160)
color = Color(0.98, 0.92, 0.72, 1)
