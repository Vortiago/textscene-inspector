[gd_scene format=3]

; Exercises FlowContainer's inherited alignment/wrap/fill properties; never carries `vertical`, which VFlowContainer removes.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="MyVFlowContainer" type="VFlowContainer" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 108.0
offset_bottom = 40.0
alignment = 1
last_wrap_alignment = 3
reverse_fill = true

[node name="First" type="Label" parent="MyVFlowContainer"]
layout_mode = 2
text = "First"

[node name="Second" type="Label" parent="MyVFlowContainer"]
layout_mode = 2
text = "Second"
