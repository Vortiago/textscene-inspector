; A res:// root of its own, because `rendering/environment/glow/upscale_mode` is a PROJECT
; setting and no .tscn can carry one. Kept in a subdirectory rather than at scenes/fixtures: a
; project.godot there would apply to every other fixture.

config_version=5

[application]

config/name="Glow Linear upscale"
run/main_scene="res://unit-glow-linear-upscale.tscn"
config/features=PackedStringArray("4.6")

[rendering]

environment/glow/upscale_mode=0
