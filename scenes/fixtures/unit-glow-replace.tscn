[gd_scene load_steps=5 format=3 uid="uid://unitglowreplace"]

; REPLACE blend: the frame BECOMES the glow buffer.
;
; Nothing of the scene survives except what passed the bright pass and was blurred,
; so this is the only fixture where the pyramid is visible on its own, with no
; scene colour underneath to mask a wrong falloff. It is also the mode that proves
; the composer mount cannot be decided from "is anything bright" alone — REPLACE
; rewrites every pixel even where the glow buffer is black.

[sub_resource type="ProceduralSkyMaterial" id="Sky_lit"]
sky_top_color = Color(0.35, 0.4, 0.5, 1)
sky_horizon_color = Color(0.4, 0.42, 0.46, 1)
ground_bottom_color = Color(0.3, 0.26, 0.2, 1)
ground_horizon_color = Color(0.4, 0.42, 0.46, 1)

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("Sky_lit")

[sub_resource type="Environment" id="Env_glow"]
background_mode = 2
