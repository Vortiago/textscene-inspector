[gd_scene load_steps=3 format=3 uid="uid://unit_animation_player_method_track"]

; Mixes a method track (tracks/0, calling Mesh.set_modulate) with a value
; track (tracks/1, animating Mesh position). The render-side parser only
; understands `value` tracks (plus the dedicated 3D transform track types);
; `method` is an unrecognized type and is skipped entirely during resolution
; — it never becomes a GodotTrack at all (not even a no-op placeholder), so
; only the position track drives the mesh. Confirms a mixed clip degrades to
; "the parts we understand" rather than failing outright.

[sub_resource type="BoxMesh" id="BoxMesh_box"]

[sub_resource type="Animation" id="Animation_mixed"]
resource_name = "mixed"
length = 1.0
tracks/0/type = "method"
tracks/0/path = NodePath("Mesh")
tracks/0/interp = 1
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"values": [{
"args": [Color(1, 0, 0, 1)],
"method": &"set_modulate"
}]
}
tracks/1/type = "value"
tracks/1/path = NodePath("Mesh:position")
tracks/1/interp = 1
tracks/1/keys = {
"times": PackedFloat32Array(0, 1),
"transitions": PackedFloat32Array(1, 1),
"values": [Vector3(0, 0, 0), Vector3(0, 2, 0)]
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_default"]
_data = {
"mixed": SubResource("Animation_mixed")
}

[node name="Scene" type="Node3D"]

[node name="Mesh" type="MeshInstance3D" parent="."]
mesh = SubResource("BoxMesh_box")

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
libraries/ = SubResource("AnimationLibrary_default")
autoplay = "mixed"
