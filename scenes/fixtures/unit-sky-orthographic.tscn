[gd_scene format=3 uid="uid://unitskyorthographic"]

; One variable: an orthographic Camera3D over a ProceduralSkyMaterial. Godot's sky pass reads only
; the projection's scale, so the sky spreads as through a perspective lens whose tangent is half
; the `size` (`sky.glsl:218-220`, `sky.cpp:224-227`). Every other sky golden looks through a
; perspective camera, so none shows the sky of an orthographic view.

[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]
sky_top_color = Color(0.9, 0.35, 0.1, 1)
sky_horizon_color = Color(1, 0.8, 0.5, 1)
sky_curve = 0.25
ground_bottom_color = Color(0.05, 0.2, 0.08, 1)
ground_horizon_color = Color(0.3, 0.45, 0.2, 1)
ground_curve = 0.1

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Env_1"]
background_mode = 2
sky = SubResource("Sky_1")

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

; Its sun shines along -Z, so the disc sits behind the camera and no editor preview sun applies.
[node name="Sun" type="DirectionalLight3D" parent="."]

[node name="Camera3D" type="Camera3D" parent="."]
projection = 1
size = 4.0
