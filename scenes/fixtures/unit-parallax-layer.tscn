[gd_scene format=3]

; One variable: `motion_mirroring`, the only ParallaxLayer property a static preview shows. The
; others (motion_scale, motion_offset and the scroll_* surface) reach the layer through
; `set_base_offset_and_scale`, which Godot never calls without a current Camera2D, so a
; camera-less scene keeps each layer's authored position and scale. Measured through Godot 4.6.3.

[node name="ParallaxBackground" type="ParallaxBackground"]

; `Mirrored` repeats every 200 px and `Once` does not, each holding the same 60x60 square: one
; square above two squares 200 px apart. The server draws mirroring
; (`canvas_set_item_mirroring`), not a node, and no other scene repeats a canvas subtree.
[node name="Once" type="ParallaxLayer" parent="."]
position = Vector2(40, 40)

[node name="OnceSquare" type="Polygon2D" parent="Once"]
color = Color(0.9, 0.7, 0.2, 1)
polygon = PackedVector2Array(0, 0, 60, 0, 60, 60, 0, 60)

[node name="Mirrored" type="ParallaxLayer" parent="."]
position = Vector2(40, 160)
motion_mirroring = Vector2(200, 0)

[node name="MirroredSquare" type="Polygon2D" parent="Mirrored"]
color = Color(0.3, 0.8, 0.5, 1)
polygon = PackedVector2Array(0, 0, 60, 0, 60, 60, 0, 60)
