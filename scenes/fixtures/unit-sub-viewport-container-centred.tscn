; A SubViewportContainer whose rect comes from a parent that CONSUMES its
; minimum size, instead of from its own offsets.
;
; The one variable against unit-sub-viewport-container.tscn: the container is a
; CenterContainer child with no offsets of its own, so its position is
; `floor((parent - get_minimum_size()) / 2)` and its minimum size is the only
; thing deciding where the surface lands. Every other SubViewportContainer
; fixture pins the container with explicit offsets under a plain Control, where
; a minimum size of zero and a minimum size of 300x180 place the surface in the
; SAME pixel — the anchor formula never reads the minimum size once the
; authored rect already exceeds it. A regression in
; `SubViewportContainer::get_minimum_size` is therefore invisible in every one
; of them, and displaces the surface by exactly half the sub-viewport here.
;
; Measured through Godot 4.6.3 at the 1152x648 project viewport: Centre is
; (100, 80) 800x480, the sub-viewport's 300x180 is the container's minimum
; size, so Booth sits at (100 + floor((800-300)/2), 80 + floor((480-180)/2)) =
; (350, 230) and the orange surface spans x 350..649, y 230..409.
;
; Mark is what makes the displacement falsifiable rather than merely shifted.
; It sits at the sub-viewport's right edge (x 260..289 of 300), so at the
; correct placement it lands at x 610..639 — inside the blue backdrop's frame —
; while a surface placed at its own half-extent instead puts it at x 760..789.
; No amount of scaling turns one into the other, and the two never overlap.
;
; The sub-viewport holds Controls only, so the surface is filled by the
; Control-raster pass rather than the 2D-world one.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

[node name="Centre" type="CenterContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 900.0
offset_bottom = 560.0

[node name="Booth" type="SubViewportContainer" parent="Centre"]

[node name="SubViewport" type="SubViewport" parent="Centre/Booth"]
size = Vector2i(300, 180)
render_target_update_mode = 4

[node name="Inner" type="ColorRect" parent="Centre/Booth/SubViewport"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(1, 0.6, 0, 1)

[node name="Mark" type="ColorRect" parent="Centre/Booth/SubViewport"]
offset_left = 260.0
offset_top = 10.0
offset_right = 290.0
offset_bottom = 40.0
color = Color(0, 1, 0, 1)
