; One variable against unit-sub-viewport-container.tscn: the container is a CenterContainer
; child with no offsets, at `floor((parent - get_minimum_size()) / 2)`, so its minimum size alone
; places the surface. Elsewhere explicit offsets exceed the minimum, which the anchor formula then
; never reads, so a `SubViewportContainer::get_minimum_size` regression shows only here.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; Measured through Godot 4.6.3 at the 1152x648 project viewport: Centre is (100, 80) 800x480 and
; the sub-viewport's 300x180 is the container's minimum size, so Booth sits at
; (100 + floor((800-300)/2), 80 + floor((480-180)/2)) = (350, 230) and the orange surface spans
; x 350..649, y 230..409. A regression displaces it by half the sub-viewport.
[node name="Centre" type="CenterContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 900.0
offset_bottom = 560.0

[node name="Booth" type="SubViewportContainer" parent="Centre"]

; Controls only, so the Control-raster pass fills the surface, not the 2D-world one.
[node name="SubViewport" type="SubViewport" parent="Centre/Booth"]
size = Vector2i(300, 180)
render_target_update_mode = 4

[node name="Inner" type="ColorRect" parent="Centre/Booth/SubViewport"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(1, 0.6, 0, 1)

; At the sub-viewport's right edge (x 260..289 of 300), so correct placement puts it at
; x 610..639, inside the blue backdrop's frame, and a surface placed at its own half-extent puts
; it at x 760..789. No scaling turns one into the other, and the two never overlap.
[node name="Mark" type="ColorRect" parent="Centre/Booth/SubViewport"]
offset_left = 260.0
offset_top = 10.0
offset_right = 290.0
offset_bottom = 40.0
color = Color(0, 1, 0, 1)
