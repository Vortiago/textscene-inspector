[gd_scene format=3 uid="uid://unit_spatial_shader_blend_modes"]

; Unshaded spatial shaders with blend_add, blend_sub, blend_mul and blend_premul_alpha, each over an opaque orange
; quad and the background. Only the blend mode moves: no other golden draws a spatial shader in the alpha pass.

[sub_resource type="Shader" id="Shader_orange"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = vec3(0.9, 0.3, 0.1);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_orange"]
shader = SubResource("Shader_orange")

[sub_resource type="Shader" id="Shader_add"]
code = "shader_type spatial;
render_mode unshaded, blend_add;

void fragment() {
	ALBEDO = vec3(UV * 0.4, 0.3);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_add"]
shader = SubResource("Shader_add")

[sub_resource type="Shader" id="Shader_sub"]
code = "shader_type spatial;
render_mode unshaded, blend_sub;

void fragment() {
	ALBEDO = vec3(UV * 0.4, 0.3);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_sub"]
