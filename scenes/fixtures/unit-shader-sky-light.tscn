[gd_scene load_steps=10 format=3 uid="uid://unitshaderskylight"]

; Twin of unit-shader-sky-parameters.tscn with one change: the sky shader adds a glow toward the
; sun it reads through LIGHT0_DIRECTION. No other golden passes a light to a sky shader.

[sub_resource type="Gradient" id="Gradient_sky"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.95, 0.55, 0.2, 1, 0.3, 0.55, 0.9, 1, 0.05, 0.1, 0.35, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_sky"]
gradient = SubResource("Gradient_sky")
fill_to = Vector2(0, 1)

[sub_resource type="Shader" id="Shader_sky"]
code = "shader_type sky;

uniform sampler2D gradient : source_color, filter_linear;
uniform float strength = 0.25;

void sky() {
	COLOR = texture(gradient, vec2(0.5, SKY_COORDS.y)).rgb * strength;
	COLOR += LIGHT0_COLOR * LIGHT0_ENERGY * 0.5 * pow(max(dot(EYEDIR, LIGHT0_DIRECTION), 0.0), 8.0);
}
"

[sub_resource type="ShaderMaterial" id="SkyMat_shader"]
shader = SubResource("Shader_sky")
shader_parameter/gradient = SubResource("GradientTexture2D_sky")
shader_parameter/strength = 1.5

[sub_resource type="Sky" id="Sky_shader"]
sky_material = SubResource("SkyMat_shader")

[sub_resource type="Environment" id="Environment_stage"]
background_mode = 2
sky = SubResource("Sky_shader")
ambient_light_source = 2
ambient_light_color = Color(0.6, 0.6, 0.6, 1)
ambient_light_sky_contribution = 0.0
tonemap_mode = 4

