; Sky ambient with a graded sky: the shape half of the IBL, where `unit-light-transport-sky` pins
; its scale. A uniform sky convolves to itself, so every filter agrees. This sky carries Godot's
; editor-preview gradient, bright above and dark below, so up- and down-facing surfaces see very
; different irradiance, and their ratio measures the filter's directionality.
[gd_scene load_steps=9 format=3]

[sub_resource type="ProceduralSkyMaterial" id="SkyMat_1"]
sky_top_color = Color(0.385, 0.454, 0.55, 1)
sky_horizon_color = Color(0.66224, 0.67174, 0.68674, 1)
ground_bottom_color = Color(0.2, 0.169, 0.133, 1)
ground_horizon_color = Color(0.66224, 0.67174, 0.68674, 1)

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("SkyMat_1")

[sub_resource type="Environment" id="Env_1"]
background_mode = 2
sky = SubResource("Sky_1")
ambient_light_source = 3
ambient_light_sky_contribution = 1.0
tonemap_mode = 0

[sub_resource type="PlaneMesh" id="Ground_1"]
size = Vector2(8, 8)

[sub_resource type="PlaneMesh" id="Wall_1"]
size = Vector2(8, 8)

[sub_resource type="PlaneMesh" id="Patch_1"]
size = Vector2(2.5, 2.5)

[sub_resource type="StandardMaterial3D" id="Lit_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
metallic = 0.0
roughness = 1.0
diffuse_mode = 1

[sub_resource type="StandardMaterial3D" id="Unshaded_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
shading_mode = 0

[node name="LightTransportSkyGraded" type="Node3D"]

; LINEAR tonemapping: a curve compresses the high end, where a distribution error shows.
[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

[node name="DarkSun" type="DirectionalLight3D" parent="."]
light_energy = 0.0

; The floor faces +Y and sees almost only sky. It shares one albedo with the wall, and the
; unshaded square gives that albedo, so each surface reads as an irradiance multiple that
; compares across renderers without matching cameras.
[node name="LitGround" type="MeshInstance3D" parent="."]
mesh = SubResource("Ground_1")
surface_material_override/0 = SubResource("Lit_1")

; Rotated 90 degrees about X so its normal points at +Z: a vertical wall that sees half sky and
; half ground where the floor sees almost only sky. The floor/wall ratio measures the filter's
; directionality.
[node name="LitWall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, -1, 0, 1, 0, 0, 2, -3)
mesh = SubResource("Wall_1")
surface_material_override/0 = SubResource("Lit_1")

[node name="UnshadedReference" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.01, 0)
mesh = SubResource("Patch_1")
surface_material_override/0 = SubResource("Unshaded_1")
