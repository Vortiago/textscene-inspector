; SplitContainer layout: where the boundary between two children falls. The one variable is
; `_compute_split_offset`'s three branches, chosen by which children carry SIZE_EXPAND. Box, grid
; and margin containers (unit-control-containers.tscn) place children in sequence, but a
; SplitContainer solves one number, `computed_split_offset`, and derives both rects from it.

[gd_scene format=3]

;   both expanded    wished = size * ratio - sep * 0.5 + split_offset
;   first expanded   wished = size - sep + split_offset
;   neither          wished = split_offset
[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; Each row is 400 wide and 60 tall at x = 20, 80 apart. ColorRect children make the boundary a
; hard colour edge a probe can find. unit-split-container-vertical.tscn carries the other axis,
; so a transposed axis cannot pass here.
[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; Both children expand, split_offset 0: an even split.
[node name="Both" type="HSplitContainer" parent="."]
offset_left = 20.0
offset_top = 20.0
offset_right = 420.0
offset_bottom = 80.0

