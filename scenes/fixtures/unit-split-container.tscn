; SplitContainer layout: where the boundary between the two children falls.
;
; The one variable: `_compute_split_offset`'s three branches, selected by which
; children carry SIZE_EXPAND. Every other container fixture
; (unit-control-containers.tscn) exercises box/grid/margin flow, which places
; children one after another; a SplitContainer instead solves for ONE number —
; `computed_split_offset` — and derives both rects from it, so a regression in
; that solve is invisible in every other container.
;
;   both expanded    wished = size * ratio - sep * 0.5 + split_offset
;   first expanded   wished = size - sep + split_offset
;   neither          wished = split_offset
;
; Each row is 400 wide and 60 tall, at x = 20, stacked 80 apart. The children
; are ColorRects so the boundary is a hard colour edge that a probe can find.
;
; Row 1  Both      both children expand, split_offset 0  -> even split
; Row 2  Offset    both expand, split_offset = 60        -> boundary moves right
; Row 3  Ratio     both expand, stretch_ratio 3 : 1      -> 3/4 of the width
; Row 4  FirstOnly only the first expands                -> first eats the rest
; Row 5  Neither   neither expands, split_offset = 120   -> first is exactly 120
;
; Vertical is the same solve on the other axis; unit-split-container-vertical
; .tscn carries it so a transposed axis cannot pass here.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

[node name="Both" type="HSplitContainer" parent="."]
offset_left = 20.0
offset_top = 20.0
offset_right = 420.0
offset_bottom = 80.0

[node name="BothLeft" type="ColorRect" parent="Both"]
layout_mode = 2
size_flags_horizontal = 3
color = Color(1, 0, 0, 1)

[node name="BothRight" type="ColorRect" parent="Both"]
layout_mode = 2
size_flags_horizontal = 3
color = Color(0, 1, 0, 1)

[node name="Offset" type="HSplitContainer" parent="."]
offset_left = 20.0
offset_top = 100.0
offset_right = 420.0
offset_bottom = 160.0
split_offset = 60

