; The one variable: an ancestor Theme gives FlatMenuButton a box with 14/10 margins and a fill. The
; picker's shape, mode and menu buttons draw it and size their rows by it (color_picker.cpp:2098,2148,2255),
; while btn_pick keeps Button's box. No other ColorPicker scene sets FlatMenuButton.
[gd_scene format=3]

[sub_resource type="StyleBoxFlat" id="Box_fmb"]
content_margin_left = 14.0
content_margin_top = 10.0
content_margin_right = 14.0
content_margin_bottom = 10.0
bg_color = Color(0.5, 0.2, 0.2, 1)

[sub_resource type="Theme" id="Theme_fmb"]
FlatMenuButton/styles/normal = SubResource("Box_fmb")
FlatMenuButton/styles/hover = SubResource("Box_fmb")
FlatMenuButton/styles/disabled = SubResource("Box_fmb")

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme = SubResource("Theme_fmb")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.12, 0.2, 1)

[node name="ColorPicker" type="ColorPicker" parent="."]
layout_mode = 1
offset_left = 4.0
offset_top = 4.0
offset_right = 404.0
offset_bottom = 404.0
color = Color(0.2, 0.4, 0.6, 0.8)
