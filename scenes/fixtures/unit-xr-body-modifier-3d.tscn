[gd_scene format=3]

; XRBodyModifier3D under the Skeleton3D it poses: SkeletonModifier3D finds a skeleton only in its
; direct parent. body_tracker names a hand-registered tracker, not the default. body_update is the
; Upper Body | Lower Body subset of the three inspector flags, without hands, and bone_update = 1
; rotates the bones without moving them, so the mesh keeps its own bone lengths.

[node name="Root" type="Node3D"]

[node name="Skeleton3D" type="Skeleton3D" parent="."]

[node name="MyXRBodyModifier3D" type="XRBodyModifier3D" parent="Skeleton3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
influence = 0.75
body_tracker = &"/user/full_body_tracker"
body_update = 3
bone_update = 1
