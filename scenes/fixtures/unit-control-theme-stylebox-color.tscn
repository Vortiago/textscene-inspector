[gd_scene load_steps=2 format=3 uid="uid://unitcontrolthemestyleboxcolor"]

; A Theme `.tres` carrying a StyleBoxFlat (`Panel/styles/panel`) and a Color
; (`Label/colors/font_color`), applied via `theme = ExtResource(...)` on the
; ROOT Control only — never as a `theme_override_styles/*` or
; `theme_override_colors/*` on either widget below. That is the one variable:
; whether a Panel/Label with no local override of its own resolves its
; chrome/text colour by walking UP through an ancestor's theme, rather than
; falling back to the bundled default theme's own StyleBoxFlat (grey, no
; border) and font colour (opaque white).
;
; ThemedPanel sits one hop below the theme owner; ThemedLabel sits two, as
; the Panel's own child — so a walk that resolved only the node's OWN theme
; (skipping the ancestor chain entirely) would leave BOTH on the bundled
; default, and a walk that stopped at the nearest ancestor without reading
; its Theme's per-type entries would still show the Panel's default grey box
; through Godot's own `StyleBoxFlat` fallback shape.
;
; No other fixture in the set authors a Theme's `styles`/`colors` entries —
; `unit-control-scene-font-theme.tscn` is the sibling that does this for
; `default_font`/`default_font_size` only. This is the first frame that can
; fail if the StyleBox/colour half of the ancestor-Theme walk regresses.

[ext_resource type="Theme" path="res://unit-control-theme-stylebox-color.tres" id="1"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.09, 0.1, 0.13, 1)

[node name="ThemedPanel" type="Panel" parent="."]
anchors_preset = 0
offset_left = 64.0
offset_top = 48.0
offset_right = 700.0
offset_bottom = 168.0

[node name="ThemedLabel" type="Label" parent="ThemedPanel"]
