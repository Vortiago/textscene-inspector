[gd_scene load_steps=2 format=3]

; One variable: a `region_rect` larger than its texture on a Sprite3D, the 3D half of the overrun
; `unit-sprite2d-region-oversized.tscn` pins, resolving the other way. SpriteBase3D derives the `texture_repeat` it
; hands `get_material_for_2d` from the frame's UV corners (`sprite_3d.cpp:163`). This is the only Sprite3D window that
; leaves `[0, 1]`, so the only one it answers REPEAT for: it runs to 3.0, emits `repeat_enable` and tiles where 2D clamps.

[ext_resource type="Texture2D" path="res://textures/sprite2d-marker.png" id="1_marker"]

[node name="Scene" type="Node3D"]

; 96x96 texture, 288x192 region: a 3x2 grid of "F" markers, where the 2D twin shows one "F" and a
; blue smear. The pair is the point: either alone lets the shared UV compositor be "fixed" into
; the wrong answer. Measured against Godot 4.6.3: 0.007%, the harness's antialiasing floor, so
; clamping this side for consistency with 2D would be the regression.
[node name="OversizedRegion" type="Sprite3D" parent="."]
texture = ExtResource("1_marker")
pixel_size = 0.01
region_enabled = true
; Neither sprite family clips the region (`base_rect = region_rect`, and
; `Texture2D::get_rect_region` passes through), so both keep the full region size and UVs past 1.0.
region_rect = Rect2(0, 0, 288, 192)
