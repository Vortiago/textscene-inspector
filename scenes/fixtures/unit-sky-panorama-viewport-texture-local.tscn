; One variable: a PanoramaSkyMaterial panorama that is a ViewportTexture, with every holder local
; to scene, so Godot sets it up (`packed_scene.cpp:701-704`, `core/io/resource.cpp:497-503`). The
; sky draws the live target: orange on one half of the azimuth, blue on the other.
; No other golden draws a set-up ViewportTexture panorama.

[gd_scene format=3]

[sub_resource type="ViewportTexture" id="ViewportTexture_1"]
viewport_path = NodePath("SubViewport")

[sub_resource type="PanoramaSkyMaterial" id="Pano_1"]
resource_local_to_scene = true
panorama = SubResource("ViewportTexture_1")

[sub_resource type="Sky" id="Sky_1"]
resource_local_to_scene = true
sky_material = SubResource("Pano_1")

[sub_resource type="Environment" id="Env_1"]
resource_local_to_scene = true
background_mode = 2
sky = SubResource("Sky_1")

[node name="SkyPanoramaViewportTexture" type="Node3D"]

[node name="SubViewport" type="SubViewport" parent="."]
disable_3d = true
size = Vector2i(64, 64)
render_target_update_mode = 4

[node name="Orange" type="ColorRect" parent="SubViewport"]
offset_right = 32.0
offset_bottom = 64.0
color = Color(0.8, 0.2, 0, 1)

[node name="Blue" type="ColorRect" parent="SubViewport"]
offset_left = 32.0
offset_right = 64.0
offset_bottom = 64.0
color = Color(0, 0.4, 0.8, 1)

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

[node name="Camera" type="Camera3D" parent="."]
fov = 90.0
