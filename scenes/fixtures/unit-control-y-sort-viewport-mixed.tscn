[gd_scene format=3 uid="uid://unitcontrolysortviewportmixed"]

; The variable: a Node2D (Marker) in the SubViewport beside the y-sorted Control. The walk of a
; viewport that holds 2D-world content sorts its Controls the same way as a Control-only one.
; unit-control-y-sort-viewport has no Node2D beside them.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Container" type="SubViewportContainer" parent="."]
layout_mode = 0
offset_left = 100.0
offset_top = 100.0
offset_right = 500.0
offset_bottom = 400.0
stretch = true

[node name="Viewport" type="SubViewport" parent="Container"]
handle_input_locally = false
size = Vector2i(400, 300)
render_target_update_mode = 4

[node name="Marker" type="Polygon2D" parent="Container/Viewport"]
position = Vector2(200, 120)
color = Color(0.2, 0.8, 0.3, 1)
polygon = PackedVector2Array(0, 0, 80, 0, 80, 80, 0, 80)

[node name="Sorted" type="Control" parent="Container/Viewport"]
y_sort_enabled = true
layout_mode = 3
anchors_preset = 0

[node name="Low" type="ColorRect" parent="Container/Viewport/Sorted"]
offset_left = 40.0
offset_top = 100.0
offset_right = 140.0
offset_bottom = 200.0
color = Color(0.9, 0.2, 0.2, 1)

[node name="High" type="ColorRect" parent="Container/Viewport/Sorted"]
