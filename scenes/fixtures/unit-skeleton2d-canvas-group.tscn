[gd_scene format=3]

; Moves one variable against unit-skeleton2d-lookat.tscn: the skeleton and the strip it skins sit
; under a CanvasGroup. No other golden draws a solved pose into the buffer of a group, which draws
; before the frame. The arm, its bar child and the strip point at the red target there too.

[sub_resource type="SkeletonModification2DLookAt" id="lookat"]
bone_index = 0
bone2d_node = NodePath("Arm")
target_nodepath = NodePath("../../Target")

[sub_resource type="SkeletonModificationStack2D" id="stack"]
enabled = true
modification_count = 1
modifications/0 = SubResource("lookat")

[node name="Root" type="Node2D"]

[node name="Group" type="CanvasGroup" parent="."]

[node name="Skeleton" type="Skeleton2D" parent="Group"]
position = Vector2(300, 150)
modification_stack = SubResource("stack")

[node name="Arm" type="Bone2D" parent="Group/Skeleton"]
rest = Transform2D(1, 0, 0, 1, 0, 0)
auto_calculate_length_and_angle = false
length = 200.0

[node name="Bar" type="Polygon2D" parent="Group/Skeleton/Arm"]
color = Color(0.95, 0.55, 0.15, 1)
polygon = PackedVector2Array(0, -10, 200, -10, 200, 10, 0, 10)

[node name="Strip" type="Polygon2D" parent="Group"]
position = Vector2(300, 150)
skeleton = NodePath("../Skeleton")
color = Color(0.2, 0.6, 0.95, 1)
polygon = PackedVector2Array(0, 20, 200, 20, 200, 40, 0, 40)
bones = [NodePath("Arm"), PackedFloat32Array(1, 1, 1, 1)]

[node name="Target" type="Node2D" parent="."]
position = Vector2(300, 400)

[node name="Mark" type="Polygon2D" parent="Target"]
color = Color(0.9, 0.25, 0.25, 1)
polygon = PackedVector2Array(-6, -6, 6, -6, 6, 6, -6, 6)
