[gd_scene format=3 uid="uid://unitdepthfogaerialsky"]

; Depth fog with full aerial perspective over a procedural sky: the fog takes its colour from the
; sky's radiance layers, blurrier the nearer the fragment. An unshaded floor and boxes read the
; layers at every distance, and nothing else in the frame reads the sky. No other golden fogs with
; the sky.

[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]
sky_top_color = Color(0.1, 0.3, 0.9, 1)
sky_horizon_color = Color(1, 0.6, 0.2, 1)
sky_curve = 0.3
ground_bottom_color = Color(0.05, 0.3, 0.1, 1)
ground_horizon_color = Color(0.6, 0.5, 0.3, 1)
ground_curve = 0.1

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Environment_1"]
background_mode = 2
sky = SubResource("Sky_1")
fog_enabled = true
fog_density = 0.12
fog_aerial_perspective = 1.0
fog_sky_affect = 0.0

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(2, 2, 2)

[sub_resource type="PlaneMesh" id="Plane_1"]
size = Vector2(40, 40)

[sub_resource type="StandardMaterial3D" id="Material_1"]
shading_mode = 0
albedo_color = Color(0.9, 0.9, 0.9, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Dark" type="DirectionalLight3D" parent="."]
light_energy = 0.0
sky_mode = 1

[node name="Floor" type="MeshInstance3D" parent="."]
mesh = SubResource("Plane_1")
surface_material_override/0 = SubResource("Material_1")

[node name="BoxNear" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.5, 1, 4)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Material_1")

[node name="BoxMid" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, -4)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Material_1")

[node name="BoxFar" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 4, 1, -22)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Material_1")

[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 8)
fov = 70.0
