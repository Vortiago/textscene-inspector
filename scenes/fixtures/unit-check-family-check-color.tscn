offset_top = 20.0
theme_override_colors/button_checked_color = Color(1, 0.4, 0.2, 1)
theme_override_colors/button_unchecked_color = Color(0.2, 1, 0.4, 1)
button_pressed = true
text = "Checked"

[node name="CheckButtonUnchecked" type="CheckButton" parent="."]
