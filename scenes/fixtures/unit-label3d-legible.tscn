[gd_scene format=3]

; unit-label3d.tscn is out of the visual set (see scripts/visual/scenes.mjs): its labels sit
; about 4 world units apart, so auto-framing leaves each a few pixels tall. The one variable is
; `pixel_size` at 0.05 (Godot default 0.005), so one label fills most of the frame and its MSDF
; glyphs and outline pass are checkable pixel by pixel, which no other golden does for Label3D.

[node name="Root" type="Node3D"]

[node name="Caption" type="Label3D" parent="."]
text = "Label3D"
pixel_size = 0.05
billboard = 1
modulate = Color(1, 1, 1, 1)
outline_size = 8
outline_modulate = Color(0, 0, 0, 1)
