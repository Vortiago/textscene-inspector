[gd_scene load_steps=7 format=3 uid="uid://unittextmeshcff"]

; The one variable: the surface a TextMesh builds from the outlines of an OpenType-CFF scene font. Its
; glyphs are cubic Béziers, which the previewer tessellates by Godot's curve_step. Every other TextMesh
; golden uses a TrueType font, whose outlines are quadratic. The scene is that of unit-text-mesh.tscn
; otherwise: the left text has depth, the right text has none, and the glyphs 8, a and A hold the
; holes and the curves.

[ext_resource type="FontFile" path="res://fonts/montserrat-extra-bold.otf" id="1_font"]

