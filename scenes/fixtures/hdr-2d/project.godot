; A res:// root of its own, because `rendering/viewport/hdr_2d` is a PROJECT setting and no .tscn
; can carry one. Kept in a subdirectory rather than at scenes/fixtures: a project.godot there would
; apply to every other fixture.

config_version=5

[application]

config/name="Root viewport HDR 2D"
run/main_scene="res://unit-hdr-2d.tscn"
config/features=PackedStringArray("4.6")

[rendering]

viewport/hdr_2d=true
