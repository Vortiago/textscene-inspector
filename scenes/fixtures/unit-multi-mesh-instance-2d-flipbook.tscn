[gd_scene format=3]

; Draws a MultiMesh through a CanvasItemMaterial with particles_animation: a sheet of two cells, and
; each instance shows the cell its custom data z picks, at the cell's width (z 0 and 0.5). A
; MeshInstance2D under the same material has no custom data, so it shows cell 0 at that width. No
; other scene puts particles_animation on a mesh, so none shows a regression in the flipbook.

[ext_resource type="Texture2D" path="res://textures/atlas-quadrants.png" id="1_quadrants"]

[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_1"]
particles_animation = true
particles_anim_h_frames = 2
particles_anim_v_frames = 1

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(80, 80)

[sub_resource type="MultiMesh" id="MultiMesh_1"]
use_custom_data = true
instance_count = 2
mesh = SubResource("QuadMesh_1")
buffer = PackedFloat32Array(1, 0, 0, 100, 0, 1, 0, 100, 0, 0, 0, 0, 1, 0, 0, 250, 0, 1, 0, 100, 0, 0, 0.5, 0)

[node name="Root" type="Node2D"]

[node name="Sheet" type="MultiMeshInstance2D" parent="."]
material = SubResource("CanvasItemMaterial_1")
multimesh = SubResource("MultiMesh_1")
texture = ExtResource("1_quadrants")

[node name="Mesh" type="MeshInstance2D" parent="."]
material = SubResource("CanvasItemMaterial_1")
position = Vector2(450, 100)
mesh = SubResource("QuadMesh_1")
texture = ExtResource("1_quadrants")
