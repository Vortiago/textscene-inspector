; One variable: two shared-world SubViewports of a 2D scene, each with a WorldEnvironment. Both
; join the root's world, whose first WorldEnvironment in tree order wins
; (`world_environment.cpp:76-85`, `scene_tree.cpp:1568-1581`). So the Right viewport glows with
; the Left one's Environment, though its own Environment has no glow. Each viewport holds the
; same sphere at the same place, so each target shows one sphere however the world is shared.

[gd_scene format=3]

[sub_resource type="Environment" id="Env_glow"]
background_mode = 1
background_color = Color(0.05, 0.06, 0.09, 1)
glow_enabled = true

[sub_resource type="Environment" id="Env_plain"]
background_mode = 1
background_color = Color(0.05, 0.06, 0.09, 1)

[sub_resource type="ViewportTexture" id="ViewportTexture_left"]
viewport_path = NodePath("Left")

[sub_resource type="ViewportTexture" id="ViewportTexture_right"]
viewport_path = NodePath("Right")

[sub_resource type="SphereMesh" id="SphereMesh_1"]
radius = 0.3
height = 0.6

; Emission far above the glow's HDR threshold of 1, so the bloom reaches well past the sphere.
[sub_resource type="StandardMaterial3D" id="Mat_emissive"]
albedo_color = Color(0, 0, 0, 1)
emission_enabled = true
emission = Color(1, 0.6, 0.2, 1)
emission_energy_multiplier = 4.0

[node name="Root" type="Node2D"]

[node name="Left" type="SubViewport" parent="."]
size = Vector2i(256, 256)
render_target_update_mode = 4

[node name="WorldEnvironment" type="WorldEnvironment" parent="Left"]
environment = SubResource("Env_glow")

[node name="Subject" type="MeshInstance3D" parent="Left"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -2)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Mat_emissive")

[node name="Camera3D" type="Camera3D" parent="Left"]
fov = 75.0

[node name="Right" type="SubViewport" parent="."]
size = Vector2i(256, 256)
render_target_update_mode = 4

[node name="WorldEnvironment" type="WorldEnvironment" parent="Right"]
environment = SubResource("Env_plain")

[node name="Subject" type="MeshInstance3D" parent="Right"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -2)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("Mat_emissive")

[node name="Camera3D" type="Camera3D" parent="Right"]
fov = 75.0

[node name="LeftScreen" type="Sprite2D" parent="."]
position = Vector2(300, 300)
scale = Vector2(2, 2)
texture = SubResource("ViewportTexture_left")

[node name="RightScreen" type="Sprite2D" parent="."]
position = Vector2(860, 300)
scale = Vector2(2, 2)
texture = SubResource("ViewportTexture_right")
