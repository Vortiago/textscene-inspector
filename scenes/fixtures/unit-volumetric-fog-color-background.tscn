[gd_scene format=3 uid="uid://unitvolfogcolorbg"]

; A colour background under thin volumetric fog, with no light in the fog. Godot draws a fogged
; colour background through a sky pass that converts the colour to linear twice. So the background
; is far darker than the same colour without fog. No other golden shows a colour background through
; fog this thin. Temporal reprojection is off, as the background is the variable, not the history.
; An unshaded box gives the capture a second colour. The zero-energy sun keeps the editor's preview
; sun out (ADR-0025).

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.9, 0.7, 0.4, 1)
volumetric_fog_enabled = true
volumetric_fog_density = 0.01
volumetric_fog_temporal_reprojection_enabled = false

[sub_resource type="BoxMesh" id="BoxMesh_1"]

[sub_resource type="StandardMaterial3D" id="Material_1"]
shading_mode = 0
albedo_color = Color(0.3, 0.5, 0.8, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Box" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Material_1")

[node name="Dark" type="DirectionalLight3D" parent="."]
light_energy = 0.0

[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 7)
fov = 70.0
