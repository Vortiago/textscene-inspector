; A scene with no DirectionalLight3D and no WorldEnvironment, so both of Godot's editor previews
; apply (ADR-0025): the preview sun casts the shadow, and the preview sky is the background and
; the only ambient. scripts/godot-ref/reference/preview-lighting.png is Godot's render of it.
[gd_scene load_steps=5 format=3]

[sub_resource type="PlaneMesh" id="Plane_1"]
size = Vector2(10, 10)

[sub_resource type="SphereMesh" id="Sphere_1"]

[sub_resource type="StandardMaterial3D" id="Rough_1"]
albedo_color = Color(0.8, 0.8, 0.82, 1)
metallic = 0.0
roughness = 0.9

[sub_resource type="StandardMaterial3D" id="Metal_1"]
albedo_color = Color(0.9, 0.85, 0.7, 1)
metallic = 1.0
roughness = 0.15

[node name="PreviewLighting" type="Node3D"]

[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("Plane_1")

; The rough and metallic spheres need the ambient to be an IBL: a flat ambient leaves the metal
; black, since a metal has no diffuse response and only shows what it reflects.
[node name="RoughBall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.2, 1, 0)
mesh = SubResource("Sphere_1")
surface_material_override/0 = SubResource("Rough_1")

[node name="MetalBall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.2, 1, 0)
mesh = SubResource("Sphere_1")
surface_material_override/0 = SubResource("Metal_1")

[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.94, 0.342, 0, -0.342, 0.94, 0, 2.2, 5)
fov = 60.0
