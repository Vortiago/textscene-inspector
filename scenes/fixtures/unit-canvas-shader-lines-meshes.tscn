[gd_scene format=3]

; One variable: the Line2D properties and the MeshInstance2D mesh kinds that a canvas_item ShaderMaterial
; draws: width_curve, gradient, joint_mode, cap modes, texture_mode tile and stretch, closed, and an
; ArrayMesh, QuadMesh, PrismMesh and SphereMesh, one of them with vertex colours that vertex() rewrites.
; The shader mixes TEXTURE with UV and COLOR, so a wrong UV, vertex or colour shows. The one other shaded
; Line2D and MeshInstance2D golden draws one plain line and one quad, so none shows a regression in them.
; Each case sits at its own cell of a 6 by 3 grid, so a diff names the property or mesh that moved.

[ext_resource type="Texture2D" path="res://textures/sprite2d-marker.png" id="1_marker"]

[sub_resource type="Shader" id="Shader_mix"]
code = "shader_type canvas_item;

void fragment() {
	COLOR = mix(texture(TEXTURE, UV), vec4(UV, 0.5, 1.0), 0.5) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_mix"]
shader = SubResource("Shader_mix")

[sub_resource type="Shader" id="Shader_shift"]
code = "shader_type canvas_item;

void vertex() {
	VERTEX += vec2(0.0, sin(VERTEX.x * 0.12) * 12.0 - 10.0);
}

void fragment() {
	COLOR = mix(texture(TEXTURE, UV), vec4(UV, 0.5, 1.0), 0.5) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_shift"]
shader = SubResource("Shader_shift")

[sub_resource type="Shader" id="Shader_colour"]
code = "shader_type canvas_item;

void vertex() {
	COLOR.rgb = COLOR.bgr;
}

void fragment() {
	COLOR = vec4(COLOR.rgb * (0.4 + 0.6 * texture(TEXTURE, UV).r), 1.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_colour"]
shader = SubResource("Shader_colour")

[sub_resource type="Curve" id="Curve_bump"]
_data = [Vector2(0, 0.3), 0.0, 0.0, 0, 0, Vector2(0.5, 1), 0.0, 0.0, 0, 0, Vector2(1, 0.3), 0.0, 0.0, 0, 0]
point_count = 3

