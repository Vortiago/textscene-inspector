colors = PackedColorArray(0.85, 0.5, 1, 1, 0.85, 0.5, 1, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_normal"]
gradient = SubResource("Gradient_normal")
width = 256
height = 256

[sub_resource type="CanvasTexture" id="CanvasTexture_mapped"]
diffuse_texture = SubResource("GradientTexture2D_grey")
normal_texture = SubResource("GradientTexture2D_normal")

[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_mapped"]
