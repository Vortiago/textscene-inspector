[gd_scene format=3]
; One variable: the alternative of a TileMapLayer cell on a normal-mapped CanvasTexture. Plain,
; FlippedH and Transposed draw the same tile, whose flat normal map tilts to +x. A cell's flip negates
; the matching normal component and its transpose swaps them first (renderer_canvas_cull.cpp:1638-1657,
; canvas.glsl:655-661), so FlippedH is lit from the right and Transposed from above. Each layer has a
; light of its own mask. No other scene lights a tile through a normal map.

[sub_resource type="Gradient" id="Gradient_grey"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0.5, 0.5, 0.5, 1, 0.5, 0.5, 0.5, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_grey"]
gradient = SubResource("Gradient_grey")
width = 256
height = 256

[sub_resource type="Gradient" id="Gradient_normal"]
