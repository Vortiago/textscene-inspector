; One variable: what a ScrollContainer does to content that does not fit. The left container is
; 600x500 around a 900x900 child, so every block inside it is cut by one boundary, the
; container's rect. Nothing else in the goldens clips, or draws a themed ScrollBar track or
; grabber, so a container that stopped clipping or drew bars unconditionally shows only here.

[gd_scene format=3]

; Measured against Godot 4.6.3 at `--mode 2d`: the clip is pixel-exact. The clipped content, the
; frame right of and below the clip and the fitting container agree within a rounding step:
; 711,360 pixels, zero disagreements.
[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.1, 0.12, 0.16, 1)

[node name="OverflowSlot" type="ColorRect" parent="."]
anchors_preset = 0
offset_left = 120.0
offset_top = 60.0
offset_right = 720.0
offset_bottom = 560.0
color = Color(0.2, 0.22, 0.28, 1)

[node name="FitSlot" type="ColorRect" parent="."]
anchors_preset = 0
offset_left = 776.0
offset_top = 60.0
offset_right = 1096.0
offset_bottom = 300.0
color = Color(0.2, 0.22, 0.28, 1)

; Both bars land in the same 8 px strips as Godot's, in the same colours over the container's
; background (track rgb(36, 38, 44), grabber rgb(124, 125, 128)). Where a bar crosses content,
; Godot draws its bars last: its grabber over the magenta block reads rgb(164, 133, 157) along
; y=300, x=712..719, where the previewer keeps the block's rgb(217, 89, 191).
[node name="Overflowing" type="ScrollContainer" parent="."]
anchors_preset = 0
offset_left = 120.0
offset_top = 60.0
offset_right = 720.0
offset_bottom = 560.0

; That 3,200 px compose-order gap is the whole disagreement, and the baseline is the
; previewer's.
[node name="Canvas" type="Control" parent="Overflowing"]
custom_minimum_size = Vector2(900, 900)
layout_mode = 2

; The two bands run the full 900 on each axis, so the cut is a long straight edge: a clip off by
; a pixel, or applied on the wrong axis, shows as a displaced edge along that length.
[node name="TopBand" type="ColorRect" parent="Overflowing/Canvas"]
anchors_preset = 0
offset_right = 900.0
offset_bottom = 72.0
color = Color(0.85, 0.3, 0.25, 1)

[node name="LeftBand" type="ColorRect" parent="Overflowing/Canvas"]
anchors_preset = 0
offset_right = 72.0
offset_bottom = 900.0
color = Color(0.25, 0.6, 0.85, 1)

[node name="Inside" type="ColorRect" parent="Overflowing/Canvas"]
anchors_preset = 0
offset_left = 160.0
offset_top = 160.0
offset_right = 280.0
offset_bottom = 280.0
color = Color(0.35, 0.75, 0.4, 1)

; Three blocks straddle the boundary: this one at the vertical edge, StraddleBottom at the
; horizontal one, Outside beyond both. A missing clip leaves all three whole over the backdrop,
; and an over-eager one drops them instead of halving them.
[node name="StraddleRight" type="ColorRect" parent="Overflowing/Canvas"]
anchors_preset = 0
offset_left = 520.0
offset_top = 140.0
offset_right = 760.0
offset_bottom = 260.0
color = Color(0.85, 0.35, 0.75, 1)

[node name="StraddleBottom" type="ColorRect" parent="Overflowing/Canvas"]
anchors_preset = 0
offset_left = 200.0
offset_top = 400.0
offset_right = 340.0
offset_bottom = 700.0
color = Color(0.35, 0.8, 0.8, 1)

[node name="Outside" type="ColorRect" parent="Overflowing/Canvas"]
anchors_preset = 0
offset_left = 700.0
offset_top = 520.0
offset_right = 860.0
offset_bottom = 660.0
color = Color(0.95, 0.95, 0.9, 1)

; The same node type with a child smaller than its box, here for the bars: overflow decides
; whether a bar draws, so this one shows none while the left shows both, each dodging the other's
; reserved strip.
[node name="Fitting" type="ScrollContainer" parent="."]
