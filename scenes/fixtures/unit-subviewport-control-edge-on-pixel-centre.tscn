; One variable: the bottom edge of a Control in a Control-only SubViewport sits on a pixel centre
; in y. unit-subviewport-edge-on-pixel-centre moves the same edge in a 2D viewport.

[gd_scene format=3 uid="uid://unitsubviewportcontroledge"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Container" type="SubViewportContainer" parent="."]
layout_mode = 0
offset_left = 100.0
offset_top = 100.0
offset_right = 500.0
offset_bottom = 400.0
stretch = true

[node name="Viewport" type="SubViewport" parent="Container"]
handle_input_locally = false
size = Vector2i(400, 300)
render_target_update_mode = 4

[node name="Band" type="ColorRect" parent="Container/Viewport"]
offset_left = 50.0
offset_top = 200.0
offset_right = 150.0
offset_bottom = 260.5
color = Color(0, 0.6, 0, 1)
