[gd_scene format=3]

; `color`'s alpha (0.6) is the ONE variable that matters visually: it is the
; only value that puts the checkerboard backdrop on screen at all, since an
; opaque swatch fully covers it and a regression there is invisible on any
; fully-opaque color. `edit_alpha`/`edit_intensity` stay non-default only for
; the strict parser's grammar coverage — neither reaches a drawn pixel.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="MyColorPickerButton" type="ColorPickerButton" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 108.0
offset_bottom = 40.0
color = Color(0.8, 0.3, 0.5, 0.6)
edit_alpha = false
edit_intensity = false
