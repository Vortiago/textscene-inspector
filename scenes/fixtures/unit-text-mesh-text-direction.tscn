; RTL puts `!` at the visual left.
[node name="Rtl" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 1.6, 0)
mesh = SubResource("TextMesh_Rtl")

; AUTO infers RTL from Hebrew.
[node name="AutoHebrew" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 0.8, 0)
mesh = SubResource("TextMesh_AutoHebrew")

; Hebrew sets the direction of neutral text.
[node name="NeutralHe" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 0.0, 0)
mesh = SubResource("TextMesh_NeutralHe")

; Turkish upper-cases i to the dotted capital I.
[node name="UpperTr" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, -0.8, 0)
mesh = SubResource("TextMesh_UpperTr")

; With no language, the root rules give a plain I.
[node name="UpperRoot" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, -1.6, 0)
mesh = SubResource("TextMesh_UpperRoot")

; FILE keeps each path segment in logical order, left to right.
[node name="File" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.6, 1.6, 0)
mesh = SubResource("TextMesh_File")

; Without an override, the RTL paragraph puts the Latin name at the visual left.
[node name="NoOverride" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.6, 0.8, 0)
mesh = SubResource("TextMesh_NoOverride")

; An LTR paragraph keeps `!` last and reverses each Hebrew word in place.
[node name="HebrewLtr" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.6, 0.0, 0)
mesh = SubResource("TextMesh_HebrewLtr")
