; One variable: the project locale is "ar-EG" under an LTR root (`layout_direction = 2`). The SpinBox's
; inner LineEdit is AUTO with no language, so its neutral text takes the locale's direction
; (`line_edit.h:144`, `line_edit.cpp:3103-3112`) and a prefix or minus sign lands on the far side.
; ASCII digits (`localize_numeral_system = false`), so only the direction differs.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
layout_direction = 2

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.12, 0.2, 1)

[node name="Prefix" type="SpinBox" parent="."]
offset_left = 20.0
offset_top = 20.0
offset_right = 260.0
offset_bottom = 60.0
min_value = -100.0
step = 0.5
value = 100.0
prefix = "$"
localize_numeral_system = false

[node name="Negative" type="SpinBox" parent="."]
offset_left = 20.0
offset_top = 80.0
offset_right = 260.0
offset_bottom = 120.0
min_value = -100.0
step = 0.5
value = -12.5
prefix = "$"
localize_numeral_system = false

[node name="Suffix" type="SpinBox" parent="."]
offset_left = 20.0
offset_top = 140.0
offset_right = 260.0
offset_bottom = 180.0
min_value = -100.0
step = 0.5
value = -12.5
suffix = "kg"
localize_numeral_system = false
