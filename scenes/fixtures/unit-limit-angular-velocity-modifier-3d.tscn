[gd_scene format=3]

; LimitAngularVelocityModifier3D under the Skeleton3D it modifies, the only placement where a
; SkeletonModifier3D does anything. The subject is max_angular_velocity, radians_as_degrees: the
; hint reads "0,720,or_greater" in degrees while the file stores radians, so 3.1415927 is 180
; degrees per second. joint_count and joints/ are absent: Godot derives both and never writes them.

[node name="Root" type="Node3D"]

; Bare on purpose: bones drag in a key space this fixture is not about. Against a bare skeleton
; set_root_bone rewrites any index at or above the bone count to -1, so the chains/0/ family uses
; the -1 unset sentinel, the one index kept as written. The names survive either way, stored
; verbatim before the index resolves from them.
[node name="Skeleton3D" type="Skeleton3D" parent="."]

[node name="MyLimitAngularVelocityModifier3D" type="LimitAngularVelocityModifier3D" parent="Skeleton3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
max_angular_velocity = 3.1415927
exclude = true
chain_count = 1
chains/0/root_bone_name = "UpperArm.L"
chains/0/root_bone = -1
chains/0/end_bone_name = "UpperArm.L"
chains/0/end_bone = -1
