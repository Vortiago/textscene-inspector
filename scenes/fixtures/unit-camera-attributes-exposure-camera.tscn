; One variable: Camera3D.attributes. The WorldEnvironment holds exposure_multiplier = 0.25 and the Camera3D that
; renders the frame holds 2. Godot forces the camera's attributes over the scenario's
; (`renderer_scene_cull.cpp:3562-3565`), so the frame draws at 2 and not at 0.25. `unit-camera-attributes-exposure`
; shows the same frame at 2 through the WorldEnvironment alone, so no other scene shows a wrong choice
; between the two.
[gd_scene load_steps=9 format=3]

[sub_resource type="CameraAttributesPractical" id="Camera_attributes_world"]
exposure_multiplier = 0.25

[sub_resource type="CameraAttributesPractical" id="Camera_attributes_camera"]
exposure_multiplier = 2.0

[sub_resource type="Environment" id="Env_1"]
background_mode = 1
background_color = Color(0.2, 0.2, 0.2, 1)
ambient_light_source = 2
ambient_light_color = Color(0.3, 0.3, 0.3, 1)

[sub_resource type="BoxMesh" id="Box_1"]

[sub_resource type="StandardMaterial3D" id="Grey_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
roughness = 1.0
metallic_specular = 0.0

[sub_resource type="StandardMaterial3D" id="Emissive_1"]
albedo_color = Color(0, 0, 0, 1)
roughness = 1.0
metallic_specular = 0.0
emission_enabled = true
emission = Color(0.4, 0.1, 0.1, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")
camera_attributes = SubResource("Camera_attributes_world")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 0, 3, 0)
