; One variable: `indent_wrapped_lines` on a wrapping TextEdit. On the break side it sets
; `BREAK_TRIM_INDENT` on the paragraph (`text_edit.cpp:285-287`), subtracting the leading indent's
; width from every later row (`text_server.cpp:1048-1062`), so a wrapping line gains rows. On the
; draw side each of those rows starts one `indent_ofs` further in (`:1488-1494`).

[gd_scene format=3 uid="uid://unit_text_edit_indent_wrapped"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; `indent_ofs` is that width capped at 60% of the wrap column (`:1363`). No other TextEdit or
; CodeEdit fixture sets the flag, and a line without leading whitespace cannot show it. Both
; nodes carry the same two lines, indented with twelve spaces and with a tab, each wrapping in a
; 180px box at `wrap_mode = 1`. This one draws four rows, all flush at the text margin.
[node name="Flush" type="TextEdit" parent="."]
layout_mode = 1
offset_left = 16.0
offset_top = 16.0
offset_right = 196.0
offset_bottom = 176.0
text = "            alpha bravo charlie delta echo\n\techo foxtrot golf hotel india"
wrap_mode = 1

; Five rows: the narrowed break costs the space line an extra row, and every continuation row is
; stepped in. A half-port that moves the rows without narrowing the break loses the fifth row, and
; one that narrows without moving them loses the step.
[node name="Stepped" type="TextEdit" parent="."]
layout_mode = 1
offset_left = 212.0
offset_top = 16.0
offset_right = 392.0
offset_bottom = 176.0
text = "            alpha bravo charlie delta echo\n\techo foxtrot golf hotel india"
wrap_mode = 1
indent_wrapped_lines = true
