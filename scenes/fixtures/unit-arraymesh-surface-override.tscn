; ONE VARIABLE: `surface_material_override/N` on an ArrayMesh — whether a
; MeshInstance3D's per-surface material override reaches a baked mesh's draw
; groups, and reaches ONLY the surface it names.
;
; unit-arraymesh-surface-override-quads.tres holds two quads whose surfaces BOTH
; name the same `[sub_resource]` body material, so the mesh alone draws two
; identical blue plates. The node overrides surface 1 and nothing else, so the
; correct image is a blue LEFT plate and an amber RIGHT one. The left plate is
; the control: an override that leaks onto every surface turns both amber, an
; override that is dropped leaves both blue, and an override applied to the wrong
; index swaps which plate is amber — three distinct failures, each legible from
; the pair rather than from either plate on its own.
;
; Why a regression here is invisible in every other scene: no other fixture sets
; `surface_material_override/N` at all, and no other golden puts a node-level
; material in front of a mesh that already carries its own. `arraymesh` has no
; material, `arraymesh-uv` and `arraymesh-compressed` take theirs from a shared
; material file, and `arraymesh-own-material` reads both of its surfaces straight
; off the mesh — every one of them renders the same picture whether the override
; path exists or not. `material_override`, which outranks this override on every
; surface, is deliberately NOT in this scene: a second overriding node would give
; the image two variables and no way to say which one moved.
[gd_scene load_steps=3 format=3 uid="uid://unitarraymeshsurfover"]

[ext_resource type="ArrayMesh" path="res://unit-arraymesh-surface-override-quads.tres" id="1_quads"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_override"]
resource_name = "surface_1_override"
albedo_color = Color(0.85, 0.4, 0.05, 1)
metallic = 0.0
roughness = 0.5

[node name="Root" type="Node3D"]

[node name="Quads" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
mesh = ExtResource("1_quads")
surface_material_override/1 = SubResource("StandardMaterial3D_override")

[node name="Title" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.8, 0)
text = "ArrayMesh surface_material_override/1"
pixel_size = 0.006
billboard = 1
modulate = Color(1, 1, 0.7, 1)

[node name="Description" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1.8, 0)
text = "Left plate blue from the mesh, right plate amber from the override"
pixel_size = 0.005
billboard = 1
modulate = Color(1, 1, 1, 1)
