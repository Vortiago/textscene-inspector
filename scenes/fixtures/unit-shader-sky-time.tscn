[gd_scene format=3 uid="uid://unitshaderskytime"]

; A sky shader that reads TIME, Quality at radiance size 128, under a mirror ball and a rough ball,
; seeked to 0.75 s. The one variable is TIME in the radiance: the balls show the sky baked again at
; 0.75 s, not at the first frame. No other golden reads a sky's radiance after TIME moves.

[sub_resource type="Shader" id="Shader_sky"]
code = "shader_type sky;\n\nvoid sky() {\n\tfloat t = TIME;\n\tCOLOR = vec3(0.5 + 0.5 * sin(t * 2.3 + EYEDIR.x * 3.0), 0.5 + 0.5 * cos(t * 1.7 + EYEDIR.y * 4.0), 0.3 + 0.3 * sin(t * 3.1 + EYEDIR.z * 2.0));\n}\n"

[sub_resource type="ShaderMaterial" id="SkyMat_shader"]
shader = SubResource("Shader_sky")

[sub_resource type="Sky" id="Sky_shader"]
sky_material = SubResource("SkyMat_shader")
process_mode = 1
radiance_size = 2

[sub_resource type="Environment" id="Environment_stage"]
background_mode = 2
sky = SubResource("Sky_shader")
ambient_light_source = 2
ambient_light_color = Color(0.6, 0.6, 0.6, 1)
ambient_light_sky_contribution = 0.0
tonemap_mode = 4

[sub_resource type="SphereMesh" id="SphereMesh_ball"]
radius = 0.9
height = 1.8
radial_segments = 64
rings = 32

[sub_resource type="StandardMaterial3D" id="Mirror"]
albedo_color = Color(0.9, 0.9, 0.9, 1)
metallic = 1.0
roughness = 0.0

[sub_resource type="StandardMaterial3D" id="Rough"]
albedo_color = Color(0.9, 0.9, 0.9, 1)
metallic = 1.0
roughness = 0.5

[sub_resource type="Animation" id="Animation_clock"]
resource_name = "clock"
length = 5.0

[sub_resource type="AnimationLibrary" id="AnimationLibrary_clock"]
_data = {
&"clock": SubResource("Animation_clock")
}

[node name="Root" type="Node3D"]

[node name="MirrorBall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1, 0.6, 0)
mesh = SubResource("SphereMesh_ball")
surface_material_override/0 = SubResource("Mirror")

[node name="RoughBall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1, 0.6, 0)
mesh = SubResource("SphereMesh_ball")
surface_material_override/0 = SubResource("Rough")

[node name="DarkSun" type="DirectionalLight3D" parent="."]
light_energy = 0.0

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.6, 4.2)

[node name="Clock" type="AnimationPlayer" parent="."]
libraries = {
&"": SubResource("AnimationLibrary_clock")
}


[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_stage")
