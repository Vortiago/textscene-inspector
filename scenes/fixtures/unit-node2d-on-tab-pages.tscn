[gd_scene format=3]

; Moves one variable: the current tab of a TabContainer whose pages each hold a Polygon2D. The container
; shows only the current page (tab_container.cpp:377-399), so Godot draws the blue polygon of the second
; page: pixel (200, 80) is (0, 0, 255) and pixel (50, 80) is the panel.

