[gd_scene load_steps=3 format=3 uid="uid://unitcsgcombiner"]

; CSGCombiner3D draws nothing of its own: `_build_brush()` returns an empty brush
; (csg_shape.cpp:1072). It folds its CSG children into one solid, which combines into its parent
; by its own `operation`. This fixture pins `visible`: an unregistered combiner falls through to
; GenericNodeFallback, which ignores `visible`, so a hidden combiner's children keep drawing.

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_ground"]
albedo_color = Color(0.45, 0.5, 0.45, 1)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_ledge"]
albedo_color = Color(0.7, 0.55, 0.35, 1)

[node name="CSGCombinerRoot" type="Node3D"]

; Shape of the vendored witness, scenes/demos/3d/ragdoll_physics/ragdoll_physics.tscn:92:
; a CSGCombiner3D under a StaticBody3D holding CSGBox3D children. The witness sets
; visible = false, which would make this a blank frame, so the hidden case is
; exercised by HiddenGroup below instead and this subtree stays drawn.
[node name="StaticBody3D" type="StaticBody3D" parent="."]

[node name="CSGCombiner3D" type="CSGCombiner3D" parent="StaticBody3D"]

[node name="Ground" type="CSGBox3D" parent="StaticBody3D/CSGCombiner3D"]
size = Vector3(4, 0.25, 4)
material = SubResource("StandardMaterial3D_ground")

[node name="SmallLedge" type="CSGBox3D" parent="StaticBody3D/CSGCombiner3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, 1.2)
size = Vector3(1.5, 0.5, 0.5)
material = SubResource("StandardMaterial3D_ledge")

; visible = false on a combiner must hide its whole CSG subtree. If this sphere is
; ever visible in the golden, the node fell through to the generic fallback.
[node name="HiddenGroup" type="CSGCombiner3D" parent="StaticBody3D"]
visible = false

[node name="NeverDrawn" type="CSGSphere3D" parent="StaticBody3D/HiddenGroup"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
radius = 0.6
material = SubResource("StandardMaterial3D_ledge")
