; One variable: a tab character that no tab stop aligns. Godot gives it no advance (measured in
; Godot 4.6.3), so "a<tab>b<tab>c" draws as "abc". A Label with tab_stops keeps its aligned tab.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Label" type="Label" parent="."]
offset_left = 20.0
offset_top = 10.0
offset_right = 300.0
offset_bottom = 60.0
text = "a	b	c"

[node name="Label2" type="Label" parent="."]
offset_left = 20.0
offset_top = 70.0
offset_right = 300.0
offset_bottom = 120.0
text = "	lead	x"
tab_stops = PackedFloat32Array(40)

[node name="Label3" type="Label" parent="."]
offset_left = 20.0
offset_top = 130.0
offset_right = 300.0
offset_bottom = 180.0
text = "abcdefgh	x"
