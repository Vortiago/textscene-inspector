[gd_scene load_steps=5 format=3 uid="uid://unittexrectatlastex"]

; One variable: a TextureRect whose `texture` is an inline AtlasTexture sub-resource, a cell of a
; sprite sheet. Godot presents it at its region's size (`AtlasTexture::get_width`/`get_height`),
; so the slot feeds the pixels and the minimum size. Each rect shrinks to that minimum
; (`size_flags_horizontal = 0`), so a wrong size moves every sibling below: layout and paint both.

; res://textures/atlas-quadrants.png is 128x128 in four flat 64x64 quadrants: red top-left, green
; top-right, blue bottom-left, yellow bottom-right, so each cell is unmistakable. Other
; TextureRect fixtures use a whole image or a GradientTexture2D, and the only other AtlasTextures
; are SpriteFrames frames in an AnimatedSprite2D, a different consumer with no golden.
[ext_resource type="Texture2D" path="res://textures/atlas-quadrants.png" id="1_sheet"]

[sub_resource type="AtlasTexture" id="AtlasTexture_topleft"]
atlas = ExtResource("1_sheet")
region = Rect2(0, 0, 64, 64)

[sub_resource type="AtlasTexture" id="AtlasTexture_centre"]
atlas = ExtResource("1_sheet")
region = Rect2(32, 32, 64, 64)

[sub_resource type="AtlasTexture" id="AtlasTexture_margined"]
atlas = ExtResource("1_sheet")
region = Rect2(96, 0, 32, 32)
margin = Rect2(8, 8, 16, 16)

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Column" type="VBoxContainer" parent="."]
offset_left = 100.0
offset_top = 60.0
offset_right = 420.0
offset_bottom = 600.0

[node name="Above" type="ColorRect" parent="Column"]
custom_minimum_size = Vector2(0, 24)
color = Color(0.15, 0.6, 0.3, 1)

; 64x64 of flat red. The whole sheet instead shows all four colours. Nothing shows the background.
[node name="TopLeftCell" type="TextureRect" parent="Column"]
size_flags_horizontal = 0
texture = SubResource("AtlasTexture_topleft")

; 64x64 across the quadrant join: a 2x2 of red, green, blue and yellow. Only the region origin
; (32, 32) produces it, so an offset read at the wrong corner shows at once.
[node name="CentreCell" type="TextureRect" parent="Column"]
size_flags_horizontal = 0
texture = SubResource("AtlasTexture_centre")

; A 32x32 green square inset 8 px in a 48x48 box, the rest transparent: `margin` widens what the
; texture reports and moves where the region lands in it, two separate reads.
[node name="MarginedCell" type="TextureRect" parent="Column"]
size_flags_horizontal = 0
texture = SubResource("AtlasTexture_margined")

[node name="Below" type="ColorRect" parent="Column"]
custom_minimum_size = Vector2(0, 24)
color = Color(0.95, 0.85, 0.1, 1)
