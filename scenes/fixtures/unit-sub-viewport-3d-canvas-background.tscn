; A 3D viewport under the Canvas background mode draws the canvas layers up to
; `background_canvas_max_layer` as its background, and the rest over its 3D render
; (`renderer_viewport.cpp:650-715`). Ground and Under draw behind the quad, so the quad covers them
; and they show beside it. Plate sits on a layer above the max layer and draws over the quad.

[gd_scene format=3]

[sub_resource type="Environment" id="Environment_1"]
background_mode = 3
background_canvas_max_layer = 0

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(2, 2)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_1"]
shading_mode = 0
albedo_color = Color(1, 0.4, 0, 1)

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; stretch is off, so screen = target pixel + (100, 80).
[node name="Booth" type="SubViewportContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 300.0
offset_bottom = 280.0

[node name="SubViewport" type="SubViewport" parent="Booth"]
own_world_3d = true
