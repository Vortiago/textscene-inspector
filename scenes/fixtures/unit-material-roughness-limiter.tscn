[gd_scene format=3]

; One variable: the roughness limiter Godot's importer runs on a roughness map's mip chain. Both
; spheres tile the same smooth roughness map and bumpy normal map so densely that they sample small
; levels. The left map's sidecar names the normal map, so each level is rougher by the spread of the
; normals it covers and the highlight spreads and dims. The right map's sidecar turns the limiter
; off, so its averaged normals go flat and its highlight stays tight. No other golden limits roughness.

[ext_resource type="Texture2D" path="res://textures/rough-limit-on.png" id="1_on"]
[ext_resource type="Texture2D" path="res://textures/rough-limit-off.png" id="2_off"]
[ext_resource type="Texture2D" path="res://textures/rough-limit-normal.png" id="3_normal"]

[sub_resource type="SphereMesh" id="SphereMesh_ball"]
radius = 0.6
height = 1.2

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_limited"]
metallic = 1.0
roughness_texture = ExtResource("1_on")
normal_enabled = true
normal_texture = ExtResource("3_normal")
uv1_scale = Vector3(32, 16, 1)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_unlimited"]
metallic = 1.0
roughness_texture = ExtResource("2_off")
normal_enabled = true
normal_texture = ExtResource("3_normal")
uv1_scale = Vector3(32, 16, 1)

[node name="RoughnessLimiter" type="Node3D"]

[node name="Limited" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.75, 0, 0)
mesh = SubResource("SphereMesh_ball")
surface_material_override/0 = SubResource("StandardMaterial3D_limited")

[node name="Unlimited" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.75, 0, 0)
mesh = SubResource("SphereMesh_ball")
surface_material_override/0 = SubResource("StandardMaterial3D_unlimited")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.25, 0.433013, 0, 0.866025, 0.5, -0.5, -0.433013, 0.75, 0, 0, 0)
