[gd_scene format=3 uid="uid://unit_standard_material_shading_lit"]

; What it holds: a StandardMaterial3D with toon diffuse, clearcoat, rim, emission and an ambient occlusion map,
; on a ground and a sphere, beside an unshaded sphere. A shadowed sun and a colour ambient light light them. They draw through
; Godot's generated shader and the lit scene template (?litSurface=nodes). One material holds all five features, because each
; distinct material costs a shader compile of about 25 s on SwiftShader in CI.
; Every other material golden draws the classic path, so only this one shows a regression in these features on the node path.

[ext_resource type="Texture2D" path="res://textures/checkerboard.svg" id="1_checkerboard"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_shaded"]
albedo_color = Color(0.75, 0.55, 0.45, 1)
roughness = 0.5
diffuse_mode = 3
clearcoat_enabled = true
clearcoat = 1.0
clearcoat_roughness = 0.1
rim_enabled = true
rim = 1.0
rim_tint = 0.25
emission_enabled = true
emission = Color(0.35, 0.1, 0, 1)
ao_enabled = true
ao_light_affect = 0.6
ao_texture = ExtResource("1_checkerboard")
uv1_scale = Vector3(2, 2, 1)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_unshaded"]
albedo_color = Color(0.4, 0.8, 0.3, 1)
shading_mode = 0

[sub_resource type="SphereMesh" id="SphereMesh_ball"]
radius = 0.5
height = 1.0

[sub_resource type="PlaneMesh" id="PlaneMesh_ground"]
size = Vector2(4, 4)

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.1, 0.12, 0.16, 1)
ambient_light_source = 2
ambient_light_color = Color(0.25, 0.3, 0.4, 1)

[node name="StandardMaterialShadingLitRoot" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.8660254, -0.3830222, 0.3213938, 0, 0.6427876, 0.7660444, -0.5, -0.6634139, 0.5566704, 0, 3, 0)
shadow_enabled = true

[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("PlaneMesh_ground")
surface_material_override/0 = SubResource("StandardMaterial3D_shaded")

[node name="Shaded" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.5, 0.5, 0.6)
mesh = SubResource("SphereMesh_ball")
surface_material_override/0 = SubResource("StandardMaterial3D_shaded")

[node name="Unshaded" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.9, 0.5, -0.6)
mesh = SubResource("SphereMesh_ball")
surface_material_override/0 = SubResource("StandardMaterial3D_unshaded")
