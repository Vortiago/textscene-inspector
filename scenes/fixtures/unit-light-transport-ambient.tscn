; Flat ambient, isolated — the same experiment as `unit-light-transport-direct`
; with the sun replaced by `AMBIENT_SOURCE_COLOR`.
;
; Godot adds a constant ambient as `ambient_light * albedo` with no 1/PI, while
; three's `getAmbientLightIrradiance` returns the colour unscaled and then
; multiplies by `albedo/PI` — the same factor the directional path needs, on a
; path that is easy to miss because it is the one Godot writes most simply.
;
; White ambient at energy 1.0 therefore renders the surface's own albedo, and
; the unshaded square sitting on the ground IS that albedo: when the scale is
; right the square is invisible.
;
; The DirectionalLight3D is here at energy 0 purely to suppress Godot's editor
; preview sun — the yield rule counts node TYPES and never looks at energy or
; visibility (ADR-0025), so a dark light is the portable way to say "this scene
; brings its own sun, and it emits nothing".
[gd_scene load_steps=6 format=3]

[sub_resource type="Environment" id="Env_1"]
background_mode = 1
background_color = Color(0.05, 0.06, 0.08, 1)
ambient_light_source = 2
ambient_light_color = Color(1, 1, 1, 1)
ambient_light_energy = 1.0
tonemap_mode = 0

[sub_resource type="PlaneMesh" id="Ground_1"]
size = Vector2(8, 8)

[sub_resource type="PlaneMesh" id="Patch_1"]
size = Vector2(2.5, 2.5)

[sub_resource type="StandardMaterial3D" id="Lit_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
metallic = 0.0
roughness = 1.0
diffuse_mode = 1

[sub_resource type="StandardMaterial3D" id="Unshaded_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
shading_mode = 0

[node name="LightTransportAmbient" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

[node name="DarkSun" type="DirectionalLight3D" parent="."]
light_energy = 0.0

[node name="LitGround" type="MeshInstance3D" parent="."]
mesh = SubResource("Ground_1")
surface_material_override/0 = SubResource("Lit_1")

[node name="UnshadedReference" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.01, 0)
mesh = SubResource("Patch_1")
surface_material_override/0 = SubResource("Unshaded_1")
