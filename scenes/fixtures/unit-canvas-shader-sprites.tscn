[gd_scene format=3]

; One variable: the Sprite2D and AnimatedSprite2D properties that change the rect, the UV or the
; colour a canvas_item ShaderMaterial reads: region, flip, centered, offset, hframes and vframes,
; modulate, texture_filter, texture_repeat, and an AnimatedSprite2D frame, flip and AtlasTexture.
; The shader mixes TEXTURE with UV, so a wrong UV, rect or colour shows. The one other sprite shader
; golden moves the shader, not these properties, so none shows a regression in them. Each case sits
; at its own cell of a 6 by 3 grid, so a diff names the property that moved.

[ext_resource type="Texture2D" path="res://textures/sprite2d-marker.png" id="1_marker"]
[ext_resource type="Texture2D" path="res://textures/mip-checker.png" id="2_checker"]
[ext_resource type="Texture2D" path="res://textures/atlas-quadrants.png" id="3_quadrants"]

[sub_resource type="Shader" id="Shader_mix"]
code = "shader_type canvas_item;

void fragment() {
	COLOR = mix(texture(TEXTURE, UV), vec4(UV, 0.5, 1.0), 0.5) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_mix"]
shader = SubResource("Shader_mix")

[sub_resource type="Shader" id="Shader_shift"]
code = "shader_type canvas_item;

void vertex() {
	VERTEX += vec2(10.0, -14.0);
}

void fragment() {
	COLOR = mix(texture(TEXTURE, UV), vec4(UV, 0.5, 1.0), 0.5) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_shift"]
shader = SubResource("Shader_shift")

[sub_resource type="Shader" id="Shader_double"]
code = "shader_type canvas_item;

void fragment() {
	COLOR = texture(TEXTURE, UV * 2.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_double"]
shader = SubResource("Shader_double")

[sub_resource type="AtlasTexture" id="AtlasTexture_marker_tr"]
atlas = ExtResource("1_marker")
region = Rect2(48, 0, 48, 48)

[sub_resource type="AtlasTexture" id="AtlasTexture_quadrants_bl"]
atlas = ExtResource("3_quadrants")
region = Rect2(0, 64, 64, 64)

[sub_resource type="SpriteFrames" id="SpriteFrames_three"]
animations = [{
"frames": [{
"duration": 1.0,
"texture": ExtResource("1_marker")
}, {
"duration": 1.0,
"texture": ExtResource("3_quadrants")
}, {
"duration": 1.0,
"texture": SubResource("AtlasTexture_quadrants_bl")
}, {
"duration": 1.0,
"texture": SubResource("AtlasTexture_marker_tr")
}],
"loop": true,
"name": &"default",
"speed": 5.0
}]

