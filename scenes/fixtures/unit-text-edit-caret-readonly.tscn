; One variable: `caret_draw_when_editable_disabled` on a read-only TextEdit. `NOTIFICATION_DRAW`
; clears `draw_caret` for an unfocused node (`text_edit.cpp:926-927`), and a still frame is
; unfocused, but while `editable` is false it overwrites that from
; `is_drawing_caret_when_editable_disabled()` (`:945-947`), the only path to a caret without focus.

[gd_scene format=3 uid="uid://unit_text_edit_caret_readonly"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; The only TextEdit or CodeEdit scene with a caret. Both nodes are `editable = false`, wearing the
; `read_only` stylebox and `font_readonly_color`, and differ only in the flag, so a caret drawn
; always or never moves exactly one of them.
[node name="Drawn" type="TextEdit" parent="."]
layout_mode = 1
; The caret is a 1px bar (`caret_width`, `default_theme.cpp:481`) in `caret_color` at line 0
; column 0, where caret 0 rests and no `.tscn` property can move it. One short line of text keeps
; the bar against the plain stylebox fill, clear of any glyph's antialiasing.
offset_left = 24.0
offset_top = 24.0
offset_right = 224.0
offset_bottom = 84.0
text = "Read only"
editable = false
caret_draw_when_editable_disabled = true

[node name="NotDrawn" type="TextEdit" parent="."]
layout_mode = 1
offset_left = 24.0
offset_top = 104.0
offset_right = 224.0
offset_bottom = 164.0
text = "Read only"
editable = false
