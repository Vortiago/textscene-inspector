; One variable against unit-sub-viewport-container-2d-content.tscn: `stretch`, with identical
; container geometry, authored `size = Vector2i(200, 150)` and content. With stretch on,
; `recalc_force_viewport_sizes` runs `set_size_force(get_size() / stretch_shrink)`, so the
; authored size is dead and the sub-viewport renders at the container's 300x200.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; The Control arm lays children out against the surface, which fills the container whatever the
; target's size, so a ColorRect at the same coordinates shows either way. Only content through
; the render target shows which rect it was laid out against, so no other container fixture can.
[node name="Booth" type="SubViewportContainer" parent="."]
offset_left = 100.0
offset_top = 80.0
offset_right = 400.0
offset_bottom = 280.0
stretch = true

[node name="SubViewport" type="SubViewport" parent="Booth"]
size = Vector2i(200, 150)
render_target_update_mode = 4

; Keeps the sibling's Color(0.5, 0.5, 0.5), so the colour pipeline stays pinned. The bottom-left
; corner stays uncovered for the clear colour.
[node name="Band" type="Polygon2D" parent="Booth/SubViewport"]
color = Color(0.5, 0.5, 0.5, 1)
polygon = PackedVector2Array(0, 0, 300, 0, 300, 40, 0, 40)

; Spans x 220..280, y 160..190: outside a 200x150 target and inside a 300x200 one, so it is drawn
; or not, and no scaling turns one into the other.
[node name="Outside" type="Polygon2D" parent="Booth/SubViewport"]
color = Color(1, 0.4, 0, 1)
polygon = PackedVector2Array(220, 160, 280, 160, 280, 190, 220, 190)
