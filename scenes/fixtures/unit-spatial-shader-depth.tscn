[gd_scene format=3 uid="uid://unit_spatial_shader_depth"]

; Unshaded spatial shaders that write DEPTH, and a depth_prepass_alpha fade, each crossing an opaque orange quad.
; Only DEPTH and the depth prepass move: no other golden spatial shader names DEPTH or depth_prepass_alpha.

[sub_resource type="Shader" id="Shader_orange"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = vec3(0.9, 0.3, 0.1);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_orange"]
shader = SubResource("Shader_orange")

[sub_resource type="Shader" id="Shader_shared"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = vec3(UV * 0.4, 0.3);
	DEPTH = UV.x;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_shared"]
shader = SubResource("Shader_shared")

[sub_resource type="Shader" id="Shader_own"]
code = "shader_type spatial;
render_mode unshaded;

void vertex() {
	VERTEX = VERTEX;
}

void fragment() {
	ALBEDO = vec3(UV * 0.4, 0.3);
	DEPTH = UV.x;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_own"]
shader = SubResource("Shader_own")

[sub_resource type="Shader" id="Shader_prepass_alpha"]
code = "shader_type spatial;
render_mode unshaded, depth_prepass_alpha;

void fragment() {
	ALBEDO = vec3(UV * 0.4, 0.3);
	ALPHA = min(UV.y * 1.5, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_prepass_alpha"]
shader = SubResource("Shader_prepass_alpha")

[sub_resource type="QuadMesh" id="QuadMesh_1"]

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.1, 0.12, 0.16, 1)

