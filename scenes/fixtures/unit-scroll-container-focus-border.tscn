; One variable: `draw_focus_border` on a ScrollContainer. Every other ScrollContainer fixture
; leaves it at the default, so dropping the margin term, or applying it without the flag, moves
; nothing there.

[gd_scene format=3 uid="uid://unit_scroll_container_focus_border"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.1, 0.1, 0.16, 1)

; The focus panel the flag names is gated on `has_focus(true) || child_has_focus()`
; (`scroll_container.cpp:474-475`), which no scene file can author. So the flag reaches a still
; frame only through `_get_margins` (`:103-130`), which every layout formula reads: the content
; origin and extent, both scrollbar rects and the container's minimum size.
[node name="Scroll" type="ScrollContainer" parent="."]
; With the flag set, each margin rises from the `panel` StyleBox's 0 (a StyleBoxEmpty,
; `default_theme.cpp:655-657`) to the `focus` StyleBox's 4 at scale 1 (`:659`, through
; `make_flat_stylebox`'s `default_margin`).
layout_mode = 1
offset_left = 24.0
offset_top = 24.0
offset_right = 264.0
offset_bottom = 184.0
draw_focus_border = true

; 120x60 with no expand flag, so its top-left corner is the content origin: flush at the
; container's (24, 24) by default, at (28, 28) with the flag.
[node name="Inner" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Block" type="ColorRect" parent="Scroll/Inner"]
layout_mode = 2
custom_minimum_size = Vector2(120, 60)
color = Color(0.95, 0.35, 0.1, 1)

; 0x400, so the vertical scrollbar shows. Its strip is inset by the right and bottom margins
; too, a second witness of the same four numbers.
[node name="Overflow" type="ColorRect" parent="Scroll/Inner"]
layout_mode = 2
custom_minimum_size = Vector2(120, 400)
color = Color(0.2, 0.7, 0.95, 1)
