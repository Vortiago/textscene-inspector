; The ONE variable: `draw_focus_border` on a ScrollContainer.
;
; The focus PANEL this flag names is gated on `has_focus(true) ||
; child_has_focus()` (`scroll_container.cpp:474-475`), which no scene file can
; author, so the flag reaches a still frame only through `_get_margins`
; (`:103-130`): with the flag set, each side rises from the `panel` StyleBox's
; margin (0 — `ScrollContainer`'s panel is a StyleBoxEmpty,
; `default_theme.cpp:655-657`) to the `focus` StyleBox's (4 at scale 1,
; `:659` through `make_flat_stylebox`'s `default_margin`). Every layout
; formula reads those margins: the content origin, the content extent, both
; scrollbar rects and the container's own minimum size.
;
; `Inner` is a 120x60 ColorRect with no expand flag, so its top-left corner IS
; the content origin: at the default it sits flush at the container's (24, 24),
; and with the flag at (28, 28). `Overflow` is 0x400 tall so the vertical
; scrollbar shows, whose strip is inset by the right and bottom margins too —
; a second, independent witness of the same four numbers.
;
; Every other ScrollContainer fixture leaves `draw_focus_border` at its
; default, so a regression that drops the margin term — or applies it without
; the flag — moves nothing in any of them.

[gd_scene format=3 uid="uid://unit_scroll_container_focus_border"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.1, 0.1, 0.16, 1)

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
offset_left = 24.0
offset_top = 24.0
offset_right = 264.0
offset_bottom = 184.0
draw_focus_border = true

[node name="Inner" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Block" type="ColorRect" parent="Scroll/Inner"]
layout_mode = 2
custom_minimum_size = Vector2(120, 60)
color = Color(0.95, 0.35, 0.1, 1)

[node name="Overflow" type="ColorRect" parent="Scroll/Inner"]
layout_mode = 2
custom_minimum_size = Vector2(120, 400)
color = Color(0.2, 0.7, 0.95, 1)
