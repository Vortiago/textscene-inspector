[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Container" type="SubViewportContainer" parent="."]
layout_mode = 0
offset_left = 100.0
offset_top = 100.0
offset_right = 500.0
offset_bottom = 400.0
stretch = true

[node name="Viewport" type="SubViewport" parent="Container"]
