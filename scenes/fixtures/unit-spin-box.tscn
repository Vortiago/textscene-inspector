[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; Exercises SpinBox's own alignment/editable/prefix/suffix/custom_arrow_step/custom_arrow_round/select_all_on_focus/update_on_text_changed.
[node name="MySpinBox" type="SpinBox" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 108.0
offset_bottom = 40.0
alignment = 2
editable = true
prefix = "$"
suffix = "kg"
custom_arrow_step = 0.5
custom_arrow_round = true
select_all_on_focus = true
update_on_text_changed = true
