[gd_scene format=4]

; CUSTOM0 to CUSTOM3, one surface for each of Godot's 8 custom array formats, each read by an unshaded
; spatial shader. No other golden gives a translated mesh custom arrays.

[sub_resource type="Shader" id="Shader_owku4"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
varying vec4 c;
void vertex() { c = CUSTOM0; }
void fragment() { ALBEDO = abs(c.rgb) * 0.7 + vec3(abs(c.a)) * 0.3; }
"

