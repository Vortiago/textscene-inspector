[gd_scene format=3]

; Three pages, one disabled, current_tab on the second page: at current_tab=0 a strip and page
; show even with broken indexing (for example always page 0). "General" has a tab_0/title
; override, so its label differs from its node name, while "Locked" and "Journal" use their node
; names, covering both title sources.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; Every non-current page authors visible = false, as the editor saves a TabContainer
; (TabContainer::add_child_notify hides every page but the current one), so this scene cannot
; tell whether the container writes that flag. unit-tab-container-current-page.tscn authors none.
[node name="MyTabContainer" type="TabContainer" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 200.0
offset_bottom = 72.0
tab_alignment = 1
current_tab = 1
tabs_position = 0
clip_tabs = true
tabs_visible = true
all_tabs_in_front = false
switch_on_drag_hover = true
drag_to_rearrange_enabled = true
tabs_rearrange_group = 0
use_hidden_tabs_for_min_size = false
tab_focus_mode = 2
deselect_enabled = false
tab_0/title = "Settings"
tab_2/disabled = true

[node name="General" type="Control" parent="MyTabContainer"]
visible = false
layout_mode = 2

[node name="Advanced" type="Control" parent="MyTabContainer"]
layout_mode = 2

[node name="Locked" type="Control" parent="MyTabContainer"]
visible = false
layout_mode = 2

[node name="RichTextLabel" type="RichTextLabel" parent="MyTabContainer/Advanced"]
layout_mode = 2
text = "Current page content"
