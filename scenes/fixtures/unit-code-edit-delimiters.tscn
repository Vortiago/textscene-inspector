; The ONE variable: `delimiter_comments` / `delimiter_strings` on a CodeEdit.
;
; Neither table colours anything — `scene/resources/syntax_highlighter.cpp`
; names no delimiter at all, and a `CodeHighlighter` carries its own
; `color_regions`. What they reach is the FOLD GUTTER: `can_fold_line`
; (`code_edit.cpp:1662-1735`) asks `is_in_comment`/`is_in_string` whether a
; line opens a region that continues, and draws the `can_fold` arrow beside
; the ones that do.
;
; All four nodes carry `gutters_draw_fold_gutter` and `line_folding`, so the
; gutter is there and folding is on in every one; only the tables differ.
; `Comments` and `NoComments` hold the SAME three-line comment buffer and
; differ by nothing but `delimiter_comments`, which is the pair Godot itself
; draws differently: an arrow beside line 0 with `PackedStringArray("#")` and
; nothing at all with `PackedStringArray()`. `Block` folds a multi-line
; comment the same way through a start/end pair, and `Strings` does it through
; `delimiter_strings` instead, which no other key can reach.
;
; No other CodeEdit fixture authors either table or the fold gutter, so a
; regression in the region scan is invisible in all of them.

[gd_scene format=3 uid="uid://unit_code_edit_delimiters"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Comments" type="CodeEdit" parent="."]
layout_mode = 1
offset_left = 16.0
offset_top = 16.0
offset_right = 256.0
offset_bottom = 136.0
text = "# one\n# two\n# three"
gutters_draw_fold_gutter = true
line_folding = true
delimiter_comments = PackedStringArray("#")

[node name="NoComments" type="CodeEdit" parent="."]
layout_mode = 1
offset_left = 272.0
offset_top = 16.0
offset_right = 512.0
offset_bottom = 136.0
text = "# one\n# two\n# three"
gutters_draw_fold_gutter = true
line_folding = true
delimiter_comments = PackedStringArray()

[node name="Block" type="CodeEdit" parent="."]
layout_mode = 1
offset_left = 528.0
offset_top = 16.0
offset_right = 768.0
offset_bottom = 136.0
text = "/* one\ntwo\n*/"
gutters_draw_fold_gutter = true
line_folding = true
delimiter_comments = PackedStringArray("/* */")

[node name="Strings" type="CodeEdit" parent="."]
layout_mode = 1
offset_left = 784.0
offset_top = 16.0
offset_right = 1024.0
offset_bottom = 136.0
text = "`one\ntwo\n`"
gutters_draw_fold_gutter = true
line_folding = true
delimiter_comments = PackedStringArray()
delimiter_strings = PackedStringArray("` `")
