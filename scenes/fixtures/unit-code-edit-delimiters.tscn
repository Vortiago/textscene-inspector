; The one variable: `delimiter_comments` and `delimiter_strings`. They colour nothing
; (scene/resources/syntax_highlighter.cpp) but feed the fold gutter, where can_fold_line
; (code_edit.cpp:1662-1735) draws an arrow on a line that opens a region. Comments and NoComments
; differ only in the table. No other CodeEdit fixture authors either table.

[gd_scene format=3 uid="uid://unit_code_edit_delimiters"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Comments" type="CodeEdit" parent="."]
layout_mode = 1
offset_left = 16.0
offset_top = 16.0
offset_right = 256.0
offset_bottom = 136.0
text = "# one\n# two\n# three"
gutters_draw_fold_gutter = true
line_folding = true
delimiter_comments = PackedStringArray("#")

[node name="NoComments" type="CodeEdit" parent="."]
layout_mode = 1
offset_left = 272.0
offset_top = 16.0
offset_right = 512.0
offset_bottom = 136.0
text = "# one\n# two\n# three"
gutters_draw_fold_gutter = true
line_folding = true
delimiter_comments = PackedStringArray()

[node name="Block" type="CodeEdit" parent="."]
layout_mode = 1
offset_left = 528.0
offset_top = 16.0
offset_right = 768.0
offset_bottom = 136.0
text = "/* one\ntwo\n*/"
gutters_draw_fold_gutter = true
line_folding = true
delimiter_comments = PackedStringArray("/* */")

[node name="Strings" type="CodeEdit" parent="."]
layout_mode = 1
offset_left = 784.0
offset_top = 16.0
offset_right = 1024.0
offset_bottom = 136.0
text = "`one\ntwo\n`"
gutters_draw_fold_gutter = true
line_folding = true
delimiter_comments = PackedStringArray()
delimiter_strings = PackedStringArray("` `")
