; Three buffer lines with every gutter turned on: the main gutter (blank —
; breakpoint/bookmark/executing state is never serialised), the line-number
; gutter (the one gutter this previewer paints), and the fold gutter (blank —
; can_fold_line depends on delimiter/comment analysis this previewer does not
; perform; see comparison.md). A missing gutter-width reservation is invisible
; without at least one drawn gutter shifting the text right.
[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="MyCodeEdit" type="CodeEdit" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 208.0
offset_bottom = 110.0
text = "func f():\n\tpass\nDone"
symbol_lookup_on_click = true
symbol_tooltip_on_hover = true
line_folding = true
line_length_guidelines = PackedInt32Array(80, 120)
gutters_draw_breakpoints_gutter = true
gutters_draw_bookmarks = true
gutters_draw_executing_lines = true
gutters_draw_line_numbers = true
gutters_zero_pad_line_numbers = false
gutters_line_numbers_min_digits = 3
gutters_draw_fold_gutter = true
delimiter_strings = PackedStringArray("' '", "\" \"")
delimiter_comments = PackedStringArray("# ")
code_completion_enabled = true
code_completion_prefixes = PackedStringArray(".", "$")
indent_size = 4
indent_use_spaces = true
indent_automatic = true
indent_automatic_prefixes = PackedStringArray(":", "{", "[", "(")
auto_brace_completion_enabled = true
auto_brace_completion_highlight_matching = true
auto_brace_completion_pairs = { "\"": "\"", "'": "'", "(": ")", "[": "]", "{": "}" }
