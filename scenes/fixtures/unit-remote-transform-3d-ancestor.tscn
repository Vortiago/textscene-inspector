[gd_scene load_steps=4 format=3 uid="uid://unitremotetransform3danc"]

; The one variable: a RemoteTransform3D whose remote_path names its own parent. Godot refuses such a
; target (remote_transform_3d.cpp:37), so the box stays at x -1.5 and the relay at +3 does not carry
; it away. Every other RemoteTransform golden drives a target outside the relay's own line of the
; tree, so none of them shows a regression in this.

[sub_resource type="PlaneMesh" id="PlaneMesh_ground"]
size = Vector2(8, 8)

[sub_resource type="BoxMesh" id="BoxMesh_target"]
size = Vector3(1, 1, 1)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_target"]
albedo_color = Color(0.2, 0.45, 0.9, 1)

[node name="Root" type="Node3D"]

[node name="Ground" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1, 0)
mesh = SubResource("PlaneMesh_ground")

[node name="Box" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.5, 0, 0)
mesh = SubResource("BoxMesh_target")
surface_material_override/0 = SubResource("StandardMaterial3D_target")

[node name="Relay" type="RemoteTransform3D" parent="Box"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 0, 0)
remote_path = NodePath("..")
