[gd_scene format=3]

; Exercises LinkButton's own text, uri, underline, ellipsis_char, text_overrun_behavior, text_direction, language and BiDi properties.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="MyLinkButton" type="LinkButton" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 108.0
offset_bottom = 40.0
text = "Visit our site"
uri = "https://godotengine.org"
underline = 1
ellipsis_char = "…"
text_overrun_behavior = 3
text_direction = 1
language = "en_GB"
structured_text_bidi_override = 0
structured_text_bidi_override_options = []
