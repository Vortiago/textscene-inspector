[gd_scene format=3]

; The three fixed-size ColorRects are the one variable: without children the resort loop never
; runs, and alignment, last_wrap_alignment, vertical and reverse_fill go unrendered. A and B are
; each 20px on the vertical main axis in a 32px content box, so each wraps into its own column.
; C (14px) leaves its trailing column not "filled" (the wrap check re-adds C: 14+14=28 <= 32).

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; C's short column is what lets last_wrap_alignment move it. A regression in the wrap threshold,
; the per-column alignment, last_wrap_alignment or reverse_fill is invisible against an empty
; container or an always-filled trailing line.
[node name="MyFlowContainer" type="FlowContainer" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 108.0
offset_bottom = 40.0
alignment = 1
last_wrap_alignment = 3
vertical = true
reverse_fill = true

[node name="A" type="ColorRect" parent="MyFlowContainer"]
layout_mode = 2
custom_minimum_size = Vector2(20, 20)
color = Color(0.85, 0.2, 0.2, 1)

[node name="B" type="ColorRect" parent="MyFlowContainer"]
layout_mode = 2
custom_minimum_size = Vector2(20, 20)
color = Color(0.2, 0.75, 0.2, 1)

[node name="C" type="ColorRect" parent="MyFlowContainer"]
layout_mode = 2
custom_minimum_size = Vector2(20, 14)
color = Color(0.2, 0.4, 0.85, 1)
