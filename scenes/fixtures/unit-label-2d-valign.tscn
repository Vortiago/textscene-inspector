; One variable: Label's vertical alignment offset. Every pane sets the same text, font size 16,
; left alignment (offset 0 for Label's empty style box) and box width, so only
; `vertical_alignment` and the box height change. Every other text fixture stays at TOP, where
; the offset is zero, and label-wrap is TOP too, so its pitch never carries FILL's separation.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; Engine rows are the first inked row per pane, measured against Godot 4.6.3 at `--mode 2d`. The
; golden draws from an MSDF atlas whose ink runs one row taller at the top (Label's comparison
; sheet), so a golden a row above these numbers is that atlas difference. Pane-to-pane
; differences other than 0 / 38 / 38 / 77 and 60 / 60 / 60 are a vertical-alignment regression.
[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.08, 0.09, 0.12, 1)

