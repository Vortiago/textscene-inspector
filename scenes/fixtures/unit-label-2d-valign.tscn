; 100 px box, TOP: the zero-offset reference, engine row 30. Every other offset is its ink row
; minus this one, which cancels the rasteriser's glyph shape.
[node name="TopRef" type="Label" parent="."]
anchors_preset = 0
offset_left = 24.0
offset_top = 24.0
offset_right = 264.0
offset_bottom = 124.0
theme_override_font_sizes/font_size = 16
text = "HHHH"
vertical_alignment = 0

; 99 px box, CENTER: box minus content is even, so the half lands on a whole pixel. Engine row
; 68, offset 38.
[node name="CenterWhole" type="Label" parent="."]
anchors_preset = 0
offset_left = 288.0
offset_top = 24.0
offset_right = 528.0
offset_bottom = 123.0
theme_override_font_sizes/font_size = 16
text = "HHHH"
vertical_alignment = 1

; 100 px box, CENTER: box minus content is odd, so the half is x.5. Godot keeps the offset in an
; `int` (`label.cpp`, `Label::get_layout_data`, `int vbegin = 0, vsep = 0`), so this lands on
; CenterWhole's row despite the taller box: engine row 68, offset 38. Keeping the half pixel
; splits the two by a row.
[node name="CenterHalf" type="Label" parent="."]
anchors_preset = 0
offset_left = 552.0
offset_top = 24.0
offset_right = 792.0
offset_bottom = 124.0
theme_override_font_sizes/font_size = 16
text = "HHHH"
vertical_alignment = 1

; 100 px box, BOTTOM: the offset is box minus content with no division, so its row states the
; engine's content height and makes the CENTER halving readable as a halving. Engine row 107,
; offset 77, that is a content height of 23.
[node name="BottomRef" type="Label" parent="."]
anchors_preset = 0
offset_left = 816.0
offset_top = 24.0
offset_right = 1056.0
offset_bottom = 124.0
theme_override_font_sizes/font_size = 16
text = "HHHH"
vertical_alignment = 2

; 205 px box, FILL: four lines, so the offset is a per-gap separation applied three times. 104/3
; leaves two thirds, which accumulate to a full 2 px by the last line. Engine rows 186, 246,
; 306, 366: a flat 60 px pitch, a separation of 34 on the 26 px line pitch.
[node name="FillFour" type="Label" parent="."]
anchors_preset = 0
offset_left = 24.0
offset_top = 180.0
offset_right = 264.0
offset_bottom = 385.0
theme_override_font_sizes/font_size = 16
text = "HHHH\nHHHH\nHHHH\nHHHH"
vertical_alignment = 3
