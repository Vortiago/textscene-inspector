[gd_scene format=3 uid="uid://unit_spatial_shader_depth_test"]

; Unshaded spatial shaders with depth_test_disabled and depth_test_inverted, each behind an opaque orange quad.
; Only the depth test moves: every other golden draws with the default depth test.

[sub_resource type="Shader" id="Shader_orange"]
code = "shader_type spatial;
render_mode unshaded;

void fragment() {
	ALBEDO = vec3(0.9, 0.3, 0.1);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_orange"]
shader = SubResource("Shader_orange")

[sub_resource type="Shader" id="Shader_test_off"]
code = "shader_type spatial;
render_mode unshaded, depth_test_disabled;

void fragment() {
	ALBEDO = vec3(0.2, 0.5, UV.y);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_test_off"]
shader = SubResource("Shader_test_off")

[sub_resource type="Shader" id="Shader_test_inverted"]
code = "shader_type spatial;
render_mode unshaded, depth_test_inverted;

void fragment() {
	ALBEDO = vec3(0.2, 0.5, UV.y);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_test_inverted"]
shader = SubResource("Shader_test_inverted")

[sub_resource type="QuadMesh" id="QuadMesh_1"]

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.1, 0.12, 0.16, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 4.2)

[node name="Orange_test_off" type="MeshInstance3D" parent="."]
transform = Transform3D(0.7, 0, 0, 0, 0.7, 0, 0, 0, 0.7, -0.65, -0.15, 0.2)
mesh = SubResource("QuadMesh_1")
material_override = SubResource("ShaderMaterial_orange")

