[gd_scene load_steps=4 format=3 uid="uid://unitmaterialemissionhdr"]

; An emission colour with a channel ABOVE 1, from Godot's HDR colour picker.
;
; Godot converts the colour sRGB->linear before energy multiplies it, and its
; conversion takes the pow branch for anything over 0.04045 — so a channel of 2.0
; extrapolates to 4.954 rather than clipping to 1. Converting after normalising by
; the peak instead, or clamping, lands the red channel and the hue somewhere else
; entirely, and since the peak is what the glow bright pass gates on it also changes
; how much of this blooms.

[sub_resource type="SphereMesh" id="SphereMesh_1"]
radius = 0.8
height = 1.6
radial_segments = 48
rings = 24

[sub_resource type="StandardMaterial3D" id="Mat_hdr"]
albedo_color = Color(0.3, 0.1, 0.05, 1)
roughness = 0.45
emission_enabled = true
emission = Color(2.0, 0.5, 0.1, 1)
emission_energy_multiplier = 1.0

[node name="EmissionHdrRoot" type="Node3D"]

[node name="HdrEmissiveSphere" type="MeshInstance3D" parent="."]
