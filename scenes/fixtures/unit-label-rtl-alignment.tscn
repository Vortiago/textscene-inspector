; The ONE variable: `layout_direction = 3` (RTL) on a Label. `Label::_get_line_rect`
; swaps its HORIZONTAL_ALIGNMENT_LEFT and _RIGHT arms outright under RTL
; (label.cpp:481-497) and leaves _CENTER alone, so each RTL row below must sit at
; the opposite edge from its LTR twin while the centred pair stays put. Every
; Label spans the full viewport width so its OWN rect mirror (control.cpp:1785)
; is the identity and only the per-line placement can move. No other fixture
; pairs a Label with a direction, so a regression in that swap is invisible
; everywhere else.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.1, 0.1, 0.18, 1)

