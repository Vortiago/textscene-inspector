[gd_scene format=3 uid="uid://unitalphaantialiasingonesample"]

; alpha_antialiasing_mode OFF, ALPHA_TO_COVERAGE and ALPHA_TO_COVERAGE_AND_TO_ONE, left to right, on
; scissor-cut quads at Godot's default msaa_3d, Disabled. One sample takes all or none of the
; coverage, so the edge stays hard where the msaa_3d golden spreads it. No other golden draws alpha
; to coverage into one sample.

