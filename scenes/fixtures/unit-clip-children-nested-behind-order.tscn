; One variable: the inert owner I2 sits behind inert owner I1 and holds a regular child C before a behind child B.
; Godot draws B before C wherever it recurses, so the green square covers the red one.
; No other scene gives a nested inert owner a regular child before its behind child, so none shows that order.

[gd_scene format=3]

[node name="Root" type="Node2D"]

[node name="I1" type="Node2D" parent="."]
position = Vector2(100, 100)
clip_children = 1

[node name="I2" type="Node2D" parent="I1"]
show_behind_parent = true
clip_children = 1

[node name="C" type="Polygon2D" parent="I1/I2"]
position = Vector2(40, 40)
color = Color(0, 1, 0, 1)
polygon = PackedVector2Array(0, 0, 100, 0, 100, 100, 0, 100)

[node name="B" type="Polygon2D" parent="I1/I2"]
show_behind_parent = true
color = Color(1, 0, 0, 1)
polygon = PackedVector2Array(0, 0, 100, 0, 100, 100, 0, 100)
