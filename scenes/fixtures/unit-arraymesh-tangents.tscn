[gd_scene format=3 uid="uid://unitarraymeshtangents"]

; The one variable: the tangents an authored ArrayMesh stores. Both spheres are Godot's SphereMesh
; arrays saved as an ArrayMesh, left uncompressed and right compressed, which store the tangent in
; two layouts. The top row is anisotropic, the bottom row normal-mapped, and both bend with the
; tangent. The demo ArrayMeshes in other goldens carry tangents but no normal map or anisotropy.

[sub_resource type="ArrayMesh" id="plain"]
_surfaces = [{
