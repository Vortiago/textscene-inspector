[gd_scene format=3 uid="uid://unit_item_list_wrap_trim"]

; One variable: each ItemList label fits its draw width, not its minimum-size width. Every list is
; plain text, so the icon-mode, fixed_column_width, max_text_lines, text_overrun_behavior and
; wraparound_items paths show beside each other. unit-item-list.tscn pins the property sweep and
; no other scene shows a row that overflows its list (item_list.cpp:1625-1661, :1766).

