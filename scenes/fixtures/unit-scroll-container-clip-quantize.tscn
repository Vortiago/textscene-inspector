anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.08, 0.09, 0.12, 1)

[node name="Whole" type="ScrollContainer" parent="."]
anchors_preset = 0
offset_left = 20.0
offset_top = 20.0
offset_right = 520.25
offset_bottom = 300.75
horizontal_scroll_mode = 3
vertical_scroll_mode = 3
scroll_horizontal = 40
scroll_vertical = 40

[node name="WholeFill" type="ColorRect" parent="Whole"]
