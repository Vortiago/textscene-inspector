; One variable: the probe of `reflection-probe-camera-exposure-sky` updates ALWAYS. Godot draws its
; six faces at the world's exposure before the view in each frame, and each bakes the sky it finds
; dirty, so the ground outside the probe reads the sky with the sun at the world's exposure
; (`renderer_scene_cull.cpp:3755-3762`, `sky.cpp:1105-1143`).

[gd_scene format=3]

[sub_resource type="CameraAttributesPractical" id="Camera_attributes_world"]
exposure_multiplier = 1.0

[sub_resource type="CameraAttributesPractical" id="Camera_attributes_camera"]
exposure_multiplier = 4.0

[sub_resource type="ProceduralSkyMaterial" id="SkyMat_1"]

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("SkyMat_1")

[sub_resource type="Environment" id="Environment_1"]
background_mode = 2
sky = SubResource("Sky_1")

[sub_resource type="PlaneMesh" id="Plane_1"]
size = Vector2(12, 12)

[sub_resource type="SphereMesh" id="Sphere_1"]

[sub_resource type="StandardMaterial3D" id="Grey_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)
roughness = 1.0
metallic_specular = 0.0

[sub_resource type="StandardMaterial3D" id="Shiny_1"]
albedo_color = Color(0.8, 0.8, 0.8, 1)
metallic = 1.0
roughness = 0.2

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")
camera_attributes = SubResource("Camera_attributes_world")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 0, 3, 0)
light_energy = 0.5

[node name="Ground" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
mesh = SubResource("Plane_1")
surface_material_override/0 = SubResource("Grey_1")

[node name="Ball" type="MeshInstance3D" parent="."]
mesh = SubResource("Sphere_1")
surface_material_override/0 = SubResource("Shiny_1")

[node name="Probe" type="ReflectionProbe" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
update_mode = 1
size = Vector3(10, 6, 10)
ambient_mode = 1

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.894427, 0.447214, 0, -0.447214, 0.894427, 0, 2, 4)
fov = 70.0
attributes = SubResource("Camera_attributes_camera")
