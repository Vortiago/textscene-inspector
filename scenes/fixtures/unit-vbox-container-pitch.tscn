; The expand path: minimums plus separations come to 302 of 542, and the middle rows carry
; `size_flags_vertical = 3` at stretch ratios 1 and 2. `_resort` recomputes each stretcher's whole
; size as `stretch_avail * ratio / total` over a `stretch_avail` that includes their minimums
; (80 + 240 = 320), then truncates. "Minimum plus a share" gives 120 and 200, 14 px off by band 3.
[node name="ExpandColumn" type="VBoxContainer" parent="."]
anchors_preset = 0
offset_left = 96.0
offset_top = 60.0
offset_right = 496.0
offset_bottom = 602.0
theme_override_constants/separation = 24

; Godot 4.6.3, band edges at x=300: Red 60..119, Blue 144..249 (106), Green 274..486 (213), Amber
; 511..600 (90), one pixel of the 320 unassigned at the bottom. Sharing the leftover by count
; instead of by stretch ratio moves no other baseline.
[node name="Red" type="ColorRect" parent="ExpandColumn"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
color = Color(0.85, 0.3, 0.25, 1)

[node name="Blue" type="ColorRect" parent="ExpandColumn"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_vertical = 3
color = Color(0.25, 0.6, 0.85, 1)

; The truncation carries a fractional-error accumulator that Godot runs in float32 and the
; previewer in float64: at 320/3 the fractions sum to just under 1 in float, just over in double.
; So this Green is 214, not 213, and Amber follows a pixel down. The baseline is the previewer's
; and carries that pixel. Every other edge matches Godot.
[node name="Green" type="ColorRect" parent="ExpandColumn"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 2.0
color = Color(0.35, 0.75, 0.4, 1)

[node name="Amber" type="ColorRect" parent="ExpandColumn"]
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
color = Color(0.9, 0.7, 0.2, 1)

; The pitch with nothing stretching: the same minimums, no expand flags, `alignment = 1`. The
; stack keeps its natural 302 and Godot centres it, 120 px down: Red 180..239, Blue 264..303,
; Green 328..367, Amber 392..481. A broken running offset shows most plainly here, and
; `alignment` is dead in the left column, since it applies only when nothing stretched.
[node name="AlignColumn" type="VBoxContainer" parent="."]
anchors_preset = 0
offset_left = 596.0
offset_top = 60.0
offset_right = 996.0
offset_bottom = 602.0
alignment = 1
theme_override_constants/separation = 24

