[gd_scene format=3]

; The one variable: the offsets an operational `anchors_preset` writes through set_offsets_preset,
; from the minimum size at that instant. They move a pixel only when a `grow_*` contradicts the
; preset: Agreeing does not, ContradictV and ContradictH set grow END. No other fixture or demo pairs
; a preset with a contradicting grow on a type with a minimum size.

[node name="Root" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.1, 0.12, 0.16, 1)

[node name="AgreeingCell" type="ColorRect" parent="."]
offset_left = 40.0
offset_top = 40.0
offset_right = 552.0
offset_bottom = 240.0
color = Color(0.35, 0.2, 0.45, 1)

[node name="Agreeing" type="Button" parent="AgreeingCell"]
layout_mode = 1
anchors_preset = 14
text = "hcenter wide, grow as the preset implies"

[node name="ContradictVCell" type="ColorRect" parent="."]
offset_left = 600.0
offset_top = 40.0
offset_right = 1112.0
offset_bottom = 240.0
color = Color(0.2, 0.35, 0.45, 1)

[node name="ContradictV" type="Button" parent="ContradictVCell"]
layout_mode = 1
anchors_preset = 14
grow_vertical = 1
text = "hcenter wide, grow_vertical = END"

[node name="ContradictHCell" type="ColorRect" parent="."]
offset_left = 40.0
offset_top = 300.0
offset_right = 552.0
offset_bottom = 500.0
color = Color(0.45, 0.35, 0.2, 1)

[node name="ContradictH" type="Button" parent="ContradictHCell"]
layout_mode = 1
anchors_preset = 13
grow_horizontal = 1
text = "vcenter"
