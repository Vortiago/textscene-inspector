[gd_scene format=3 uid="uid://unit_label_visible_characters"]

; `visible_characters` mid-reveal at the default VC_CHARS_BEFORE_SHAPING, the one variable
; against unit-label-2d.tscn. Godot truncates the string before shaping (label.cpp:155-156), so
; the trailing "reveal" characters are not glyphs at all. Drawing the full string, or drawing it
; dimmed instead of shortened, shows only here.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Label" type="Label" parent="."]
anchors_preset = 0
offset_left = 20.0
offset_top = 20.0
offset_right = 260.0
offset_bottom = 60.0
text = "Typewriter reveal"
visible_characters = 10
