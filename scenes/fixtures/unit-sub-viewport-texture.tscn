; ViewportTexture — a SubViewport's render target consumed as a texture.
;
; The one variable: what a `ViewportTexture` sample shows THROUGH the target —
; that `viewport_path` resolves to the live target, and that the offscreen
; pass runs Godot's per-viewport colour pipeline (the shared environment's
; tonemap applies inside the target, then again on the consuming surface).
; Everything else is deliberately plain — one unshaded quad, one light-free
; setup — so a regression here is either the texture not resolving or the
; through-target pipeline drifting, and it is invisible in every other golden
; because no other golden consumes a ViewportTexture.
;
; Godot 4.6.3 draws the sphere (rendered by the SubViewport's own Camera3D)
; onto the quad. The sphere ALSO draws in the main view, because own_world_3d
; is unset and the world is shared — that is the ADR-0033 default, not a bug.
;
; The content is 3D on purpose: a Control-content viewport takes the DOM
; rasterization path instead, which is a different mechanism and gets its own
; browser-harness assertion rather than a golden.

[gd_scene format=3]

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(2, 2)

[sub_resource type="ViewportTexture" id="ViewportTexture_1"]
viewport_path = NodePath("SubViewport")

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_1"]
resource_local_to_scene = true
shading_mode = 0
albedo_texture = SubResource("ViewportTexture_1")

[sub_resource type="SphereMesh" id="SphereMesh_1"]
radius = 0.5
height = 1.0

[node name="Root" type="Node3D"]

[node name="SubViewport" type="SubViewport" parent="."]
size = Vector2i(256, 256)
render_target_update_mode = 4

[node name="Subject" type="MeshInstance3D" parent="SubViewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -4)
mesh = SubResource("SphereMesh_1")

[node name="Camera3D" type="Camera3D" parent="SubViewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -2)
fov = 75.0

[node name="Screen" type="MeshInstance3D" parent="."]
mesh = SubResource("QuadMesh_1")
surface_material_override/0 = SubResource("StandardMaterial3D_1")
