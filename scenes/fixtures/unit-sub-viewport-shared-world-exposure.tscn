; One variable: `tonemap_exposure` 1.5 under LINEAR inside a shared-world SubViewport's target,
; while glow mounts the compositor on the main view. Godot tonemaps the target with the environment
; of its `find_world_3d()`, so the exposure applies inside the target and again on the quad that
; samples it. `sub-viewport-texture` keeps the default exposure, and no other golden renders a
; shared-world target while the compositor holds the renderer.

[gd_scene format=3]

; Every exposed value stays under the glow threshold, so the glow adds nothing in either view.
[sub_resource type="Environment" id="Env_glow"]
background_mode = 1
background_color = Color(0.05, 0.06, 0.09, 1)
tonemap_exposure = 1.5
glow_enabled = true

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(1.6, 1.6)

[sub_resource type="ViewportTexture" id="ViewportTexture_1"]
viewport_path = NodePath("SubViewport")

[sub_resource type="StandardMaterial3D" id="Mat_screen"]
resource_local_to_scene = true
shading_mode = 0
albedo_texture = SubResource("ViewportTexture_1")

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(0.5, 0.5, 0.5)

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
shading_mode = 0
albedo_color = Color(0.12, 0.08, 0.05, 1)

[sub_resource type="StandardMaterial3D" id="Mat_bright"]
shading_mode = 0
albedo_color = Color(0.4, 0.3, 0.18, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_glow")

[node name="DarkBox" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.4, 0, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Mat_dark")

[node name="BrightBox" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.4, 0, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Mat_bright")

; The world is shared, so the target shows the boxes above. Its camera looks back at them from
; behind, and the quad sits behind that camera, so the target never samples itself.
[node name="SubViewport" type="SubViewport" parent="."]
size = Vector2i(256, 256)
render_target_update_mode = 4

[node name="Camera3D" type="Camera3D" parent="SubViewport"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -1.5)
fov = 70.0

[node name="Screen" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, -2.2)
mesh = SubResource("QuadMesh_1")
surface_material_override/0 = SubResource("Mat_screen")
