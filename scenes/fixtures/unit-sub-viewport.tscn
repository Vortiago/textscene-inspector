; SubViewport — a canvas boundary that is NOT a world boundary (ADR-0030).
;
; The one variable: what a sub-viewport does to its subtree in the DEFAULT
; (own_world_3d unset) case. Godot's Viewport resolves World3D by walking up to
; the parent viewport, so InsideSphere DOES draw beside OutsideBox; it always
; owns its World2D, so InsideRect draws nowhere. Verified against Godot 4.6.3.
;
; A regression here is invisible in every other scene: no other fixture places
; 3D content inside a SubViewport, and the failure mode — subtree silently
; dropped — leaves a scene that still renders, just missing a node.
; The own_world_3d arm lives in unit-sub-viewport-own-world.tscn.

[gd_scene format=3]

[sub_resource type="BoxMesh" id="1"]
size = Vector3(1, 1, 1)

[sub_resource type="SphereMesh" id="2"]
radius = 0.6
height = 1.2

[node name="Root" type="Node3D"]

[node name="OutsideBox" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.2, 0, 0)
mesh = SubResource("1")

[node name="Viewport" type="SubViewport" parent="."]
size = Vector2i(256, 256)
render_target_update_mode = 4

[node name="InsideSphere" type="MeshInstance3D" parent="Viewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.2, 0, 0)
mesh = SubResource("2")

[node name="InsideRect" type="ColorRect" parent="Viewport"]
offset_right = 128.0
offset_bottom = 128.0
color = Color(1, 0, 0, 1)
