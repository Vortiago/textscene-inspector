; The one variable: `top_level` on a Control. The placement climb stops at it (control.cpp:3876), so
; the Control is a canvas root anchored to the viewport. unit-node2d-top-level.tscn moves the flag in
; the Node2D walk, and every other Control fixture leaves it unset.

[gd_scene load_steps=1 format=3 uid="uid://unitctrltoplevel"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Holder" type="Node2D" parent="."]
position = Vector2(300, 200)

[node name="Floating" type="ColorRect" parent="Holder"]
top_level = true
offset_right = 160.0
offset_bottom = 80.0
color = Color(0.9, 0.2, 0.2, 1)

[node name="Nested" type="ColorRect" parent="Holder"]
offset_top = 120.0
offset_right = 160.0
offset_bottom = 200.0
color = Color(0.2, 0.5, 0.9, 1)
