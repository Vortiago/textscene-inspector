[gd_scene format=3]

; The one variable: the Content ColorRect, the child that makes the container's sort loop assign
; a rect. Against an empty container, a regression in ratio, stretch or alignment is invisible.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="MyAspectRatioContainer" type="AspectRatioContainer" parent="."]
layout_mode = 1
offset_left = 8.0
offset_top = 8.0
offset_right = 108.0
offset_bottom = 40.0
ratio = 1.5
stretch_mode = 3
alignment_horizontal = 0
alignment_vertical = 2

[node name="Content" type="ColorRect" parent="MyAspectRatioContainer"]
layout_mode = 2
custom_minimum_size = Vector2(10, 10)
color = Color(0.2, 0.6, 0.9, 1)
