; One variable: `tonemap_exposure` 1.6 under LINEAR, with no glow, no blended surface and no
; adjustment, so three draws the curve per material and the colour background through it. Godot
; multiplies by the exposure before every tone mapper, LINEAR included (`tonemap.glsl:868-874`).
; The other exposure goldens use FILMIC or mount the compositor, which applies the exposure itself.

[gd_scene format=3]

[sub_resource type="Environment" id="Env_linear"]
background_mode = 1
background_color = Color(0.1, 0.12, 0.18, 1)
tonemap_exposure = 1.6

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(0.5, 0.5, 0.5)

; Unshaded, so each box shows its albedo times the exposure. The brightest one clips at white.
[sub_resource type="StandardMaterial3D" id="Mat_dark"]
shading_mode = 0
albedo_color = Color(0.15, 0.1, 0.06, 1)

[sub_resource type="StandardMaterial3D" id="Mat_mid"]
shading_mode = 0
albedo_color = Color(0.4, 0.28, 0.16, 1)

[sub_resource type="StandardMaterial3D" id="Mat_bright"]
shading_mode = 0
albedo_color = Color(0.85, 0.6, 0.34, 1)

[node name="Root" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_linear")

[node name="DarkBox" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.7, 0, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Mat_dark")

[node name="MidBox" type="MeshInstance3D" parent="."]
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Mat_mid")

[node name="BrightBox" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.7, 0, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("Mat_bright")
