; A res:// root of its own, because `rendering/reflections/sky_reflections/fast_filter_high_quality`
; is a PROJECT setting and no .tscn can carry one. Kept in a subdirectory rather than at
; scenes/fixtures: a project.godot there would apply to every other fixture.

config_version=5

[application]

config/name="Sky fast filter high quality"
run/main_scene="res://unit-shader-sky-realtime-high-quality.tscn"
config/features=PackedStringArray("4.6")

[rendering]

reflections/sky_reflections/fast_filter_high_quality=true
