; One variable: `layout_direction = 3` on the SubViewportContainer, read by a container inside the
; sub-viewport. `Control::is_layout_rtl` casts each ancestor to `Control`, then `Window`, then
; takes `get_parent()` (control.cpp:3584-3598). A SubViewport is neither, so the climb steps onto
; the container and `BoxContainer::_resort` lays the bars from the other edge (box_container.cpp:48).

[gd_scene format=3 uid="uid://unitsvpinheritrtl"]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

; Every other RTL fixture sets the flag in the same canvas, crossing no viewport boundary, so a
; climb that stopped at one would pass them. The bars differ in width, so a reversal is not a
; mirror of equal blocks.
