[gd_scene format=3]

; One variable: the Polygon2D properties that change the vertices, the UV or the colour a canvas_item
; ShaderMaterial reads: the uv array, texture_offset, texture_scale, texture_rotation, color,
; vertex_colors, several polygons, invert_enabled, and a vertex() that moves the corners. The shader
; mixes TEXTURE with UV and the vertex colour, so a wrong UV, vertex or colour shows. The one other
; shaded Polygon2D golden draws a single quad with no UV transform, so none shows a regression in
; them. Each case sits at its own cell of a 4 by 3 grid, so a diff names the property that moved.

[ext_resource type="Texture2D" path="res://textures/sprite2d-marker.png" id="1_marker"]

[sub_resource type="Shader" id="Shader_mix"]
code = "shader_type canvas_item;

void fragment() {
	COLOR = mix(texture(TEXTURE, UV), vec4(UV, 0.5, 1.0), 0.5) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_mix"]
shader = SubResource("Shader_mix")

[sub_resource type="Shader" id="Shader_shift"]
code = "shader_type canvas_item;

void vertex() {
	VERTEX += vec2(sin(VERTEX.y * 0.1) * 14.0, -10.0);
}

void fragment() {
	COLOR = mix(texture(TEXTURE, UV), vec4(UV, 0.5, 1.0), 0.5) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_shift"]
shader = SubResource("Shader_shift")

