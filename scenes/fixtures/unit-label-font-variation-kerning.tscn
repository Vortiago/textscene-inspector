[gd_scene load_steps=3 format=3]

; The one variable: a `FontVariation` whose `variation_opentype` sets the `MONO` axis of Recursive to
; 0.5 (tag 1297043023). Its `GPOS` kerning moves with the axis: each pair kerns half as much as at the
; default instance. The top Label draws the font itself and the lower Label the instance, both at 64 px,
; with the same pairs.

[ext_resource type="FontFile" path="res://fonts/recursive-vf-subset.woff2" id="1_font"]

[sub_resource type="FontVariation" id="FontVariation_mono"]
base_font = ExtResource("1_font")
variation_opentype = {
1297043023: 0.5
}

[node name="Root" type="Control"]
