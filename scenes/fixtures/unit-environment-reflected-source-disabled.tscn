; The variable: reflected_light_source DISABLED over a ProceduralSkyMaterial background. The metal
; ball reflects nothing, so it is black but for the sun's highlight, while the ground still takes
; the sky as its ambient colour. The default source would reflect the sky in the ball.
[gd_scene format=3]

[sub_resource type="ProceduralSkyMaterial" id="SkyMat_1"]

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("SkyMat_1")

[sub_resource type="Environment" id="Env_1"]
background_mode = 2
sky = SubResource("Sky_1")
ambient_light_source = 2
ambient_light_color = Color(0.5, 0.5, 0.5, 1)
reflected_light_source = 1

[sub_resource type="PlaneMesh" id="Ground_1"]
size = Vector2(20, 20)

[sub_resource type="StandardMaterial3D" id="GroundMat_1"]
albedo_color = Color(0.5, 0.5, 0.5, 1)

[sub_resource type="SphereMesh" id="Ball_1"]

[sub_resource type="StandardMaterial3D" id="Metal_1"]
albedo_color = Color(0.9, 0.9, 0.9, 1)
metallic = 1.0
roughness = 0.2

[node name="EnvironmentReflectedSourceDisabled" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("Ground_1")
surface_material_override/0 = SubResource("GroundMat_1")

[node name="Ball" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
mesh = SubResource("Ball_1")
surface_material_override/0 = SubResource("Metal_1")
