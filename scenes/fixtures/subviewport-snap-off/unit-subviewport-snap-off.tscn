; The one variable: which viewport a Control lives in, under snap_controls_to_pixels = false.
; main/main.cpp hands the setting to the root window alone, and each viewport's flag starts true
; (scene/main/viewport.h), so the SubViewport arm keeps snapping: four 0.5 offsets put it 2 px off.
; Arbitrate with `pnpm ref:godot --mode 2d-root`. README.md has the measured positions.

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

[node name="RootArm" type="Control" parent="."]
offset_left = 100.5
offset_top = 60.5
offset_right = 300.5
offset_bottom = 200.5

[node name="Link1" type="Control" parent="RootArm"]
offset_left = 0.5
offset_top = 0.5
offset_right = 180.5
offset_bottom = 120.5

[node name="Link2" type="Control" parent="RootArm/Link1"]
offset_left = 0.5
offset_top = 0.5
offset_right = 160.5
offset_bottom = 100.5

[node name="Bar" type="ColorRect" parent="RootArm/Link1/Link2"]
offset_left = 0.5
offset_top = 0.5
offset_right = 40.5
offset_bottom = 40.5
color = Color(0, 1, 0, 1)

[node name="Booth" type="SubViewportContainer" parent="."]
offset_left = 400.0
offset_top = 300.0
offset_right = 700.0
offset_bottom = 480.0

[node name="SubViewport" type="SubViewport" parent="Booth"]
size = Vector2i(300, 180)
render_target_update_mode = 4

[node name="NestedArm" type="Control" parent="Booth/SubViewport"]
offset_left = 100.5
offset_top = 60.5
offset_right = 300.5
offset_bottom = 200.5

[node name="Link1" type="Control" parent="Booth/SubViewport/NestedArm"]
offset_left = 0.5
offset_top = 0.5
offset_right = 180.5
offset_bottom = 120.5

[node name="Link2" type="Control" parent="Booth/SubViewport/NestedArm/Link1"]
offset_left = 0.5
offset_top = 0.5
offset_right = 160.5
offset_bottom = 100.5

[node name="Bar" type="ColorRect" parent="Booth/SubViewport/NestedArm/Link1/Link2"]
offset_left = 0.5
offset_top = 0.5
offset_right = 40.5
offset_bottom = 40.5
color = Color(0, 1, 0, 1)
