; The variable: one ReflectionProbe that updates ONCE, so its capture bakes through the GGX
; importance-sample filter. It sets AMBIENT_COLOR red and box_projection, so the floor reads the
; probe's own ambient and the mirror sphere reads the box-projected capture. The ALWAYS golden uses
; the fast filter and no box projection, so only this golden shows a regression in either.
[gd_scene format=3]

[sub_resource type="Environment" id="Env_1"]
background_mode = 1
background_color = Color(0.3, 0.5, 0.8, 1)
ambient_light_source = 2
ambient_light_color = Color(0.6, 0.6, 0.6, 1)

[sub_resource type="PlaneMesh" id="Floor_1"]
size = Vector2(20, 20)

[sub_resource type="StandardMaterial3D" id="Glow_1"]
albedo_color = Color(0, 0, 0, 1)
emission_enabled = true
emission = Color(1, 0.6, 0.2, 1)
emission_energy_multiplier = 2.0

[sub_resource type="BoxMesh" id="Box_1"]
material = SubResource("Glow_1")
size = Vector3(4, 2, 0.5)

[sub_resource type="StandardMaterial3D" id="Mirror_1"]
metallic = 1.0
roughness = 0.0

[sub_resource type="SphereMesh" id="Sphere_1"]
material = SubResource("Mirror_1")

[node name="ReflectionProbeMirror" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

[node name="Floor" type="MeshInstance3D" parent="."]
mesh = SubResource("Floor_1")

[node name="Glow" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, -3)
mesh = SubResource("Box_1")

[node name="Mirror" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1, 0.6, 1)
mesh = SubResource("Sphere_1")

[node name="Probe" type="ReflectionProbe" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
size = Vector3(20, 6, 20)
box_projection = true
ambient_mode = 2
ambient_color = Color(1, 0, 0, 1)
