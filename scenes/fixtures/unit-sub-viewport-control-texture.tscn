; One variable: Control content, with a translucent fill, sampled by a 3D albedo. Controls only, so
; the Control pass paints the offscreen target, and the albedo samples its decoding view. No other
; golden puts Controls behind a ViewportTexture on a material.

[gd_scene format=3]

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(2, 2)

[sub_resource type="ViewportTexture" id="ViewportTexture_1"]
viewport_path = NodePath("SubViewport")

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_1"]
resource_local_to_scene = true
shading_mode = 0
albedo_texture = SubResource("ViewportTexture_1")

; The Panel's translucent fill is `style_normal_color`, Color(0.1, 0.1, 0.1, 0.6)
; (`default_theme.cpp:112,134`). The target blends it over the backdrop in sRGB numbers, as
; Godot's does, so (480,320) reads rgb(84, 84, 84) in Godot 4.6.3 and here.
[node name="Root" type="Node3D"]

[node name="SubViewport" type="SubViewport" parent="."]
size = Vector2i(256, 256)
render_target_update_mode = 4

; Measured through Godot 4.6.3 under the editor preview environment (FILMIC): the backdrop's
; Color(0.5, 0.5, 0.5) reaches the quad as rgb(162). Tonemapping the raster too would land it
; near rgb(196).
[node name="GUI" type="Control" parent="SubViewport"]
anchors_preset = 0
offset_right = 256.0
offset_bottom = 256.0

; Flat, opaque and mid-grey: the probe that separates one tonemap from two. Godot draws a
; viewport's canvas after its tonemap (`RendererViewport::_draw_viewport` runs `_draw_3d`, which
; ends in `_render_buffers_post_process_and_tonemap`, before the `render_canvas` loop), so the
; target holds untonemapped sRGB and the curve applies once, on the quad in the main viewport.
[node name="Backdrop" type="ColorRect" parent="SubViewport/GUI"]
anchors_preset = 0
offset_right = 256.0
offset_bottom = 256.0
color = Color(0.5, 0.5, 0.5, 1)

; Panel and Label carry default-theme chrome and a glyph run, so the target also meets a
; translucent StyleBox fill and shaped text, not one flat fill.
[node name="Panel" type="Panel" parent="SubViewport/GUI"]
anchors_preset = 0
offset_left = 32.0
offset_top = 32.0
offset_right = 224.0
offset_bottom = 112.0

[node name="Label" type="Label" parent="SubViewport/GUI"]
anchors_preset = 0
offset_left = 32.0
offset_top = 160.0
offset_right = 224.0
offset_bottom = 192.0
text = "VIEWPORT"
horizontal_alignment = 1

[node name="Screen" type="MeshInstance3D" parent="."]
mesh = SubResource("QuadMesh_1")
surface_material_override/0 = SubResource("StandardMaterial3D_1")
