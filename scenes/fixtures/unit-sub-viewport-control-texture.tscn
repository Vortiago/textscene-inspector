; A Control-only SubViewport consumed as a ViewportTexture.
;
; The one variable: where a sub-viewport's CONTROL pixels come from and what
; colour pipeline they go through. Its content is Controls only, so the source
; is the Control rect solve painting into the offscreen target, sampled back as
; a ViewportTexture. A regression here is invisible in every other scene because
; no other scene puts Controls behind a ViewportTexture.
;
; Backdrop is a flat, opaque, mid-grey ColorRect on purpose: it is the probe
; that separates ONE tonemap application from two. Godot draws a viewport's
; canvas AFTER that viewport's tonemap pass (`RendererViewport::_draw_viewport`
; runs `_draw_3d` — which ends in `_render_buffers_post_process_and_tonemap` —
; before the `render_canvas` loop), so the target stores the canvas's own sRGB
; values untonemapped, and the curve applies exactly once: on the quad, in the
; MAIN viewport's pass. Measured through Godot 4.6.3 under the editor preview
; environment (FILMIC): Color(0.5, 0.5, 0.5) reaches the quad as rgb(162);
; tonemapping the raster as well would land it near rgb(196).
;
; Panel and Label carry the default-theme chrome and a glyph run, so the target
; is also exercised on translucent StyleBox fill and shaped text rather than on
; one flat fill.
;
; NOT currently gated, and the reason is a live divergence rather than missing
; wiring. The backdrop measures rgb(162) against Godot 4.6.3, as above — but the
; Panel's translucent fill reads 110 where Godot reads 84. That fill is
; `style_normal_color`, Color(0.1, 0.1, 0.1, 0.6) (`default_theme.cpp:112,134`),
; and the SAME colour on the main canvas — a Button's `normal` box (`:138`) over
; the 2D clear colour — measures 45 against Godot's 46, one step of the
; reference rasterizer's blend rounding. So the alpha blend itself is right and
; the offscreen target is where the two part company: an sRGB-tagged attachment
; is linearised before blending, while Godot's viewport target holds ordinary
; sRGB canvas values and blends in them. A baseline taken today would pin that
; gap instead of gating against it.

[gd_scene format=3]

[sub_resource type="QuadMesh" id="QuadMesh_1"]
size = Vector2(2, 2)

[sub_resource type="ViewportTexture" id="ViewportTexture_1"]
viewport_path = NodePath("SubViewport")

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_1"]
resource_local_to_scene = true
shading_mode = 0
albedo_texture = SubResource("ViewportTexture_1")

[node name="Root" type="Node3D"]

[node name="SubViewport" type="SubViewport" parent="."]
size = Vector2i(256, 256)
render_target_update_mode = 4

[node name="GUI" type="Control" parent="SubViewport"]
anchors_preset = 0
offset_right = 256.0
offset_bottom = 256.0

[node name="Backdrop" type="ColorRect" parent="SubViewport/GUI"]
anchors_preset = 0
offset_right = 256.0
offset_bottom = 256.0
color = Color(0.5, 0.5, 0.5, 1)

[node name="Panel" type="Panel" parent="SubViewport/GUI"]
anchors_preset = 0
offset_left = 32.0
offset_top = 32.0
offset_right = 224.0
offset_bottom = 112.0

[node name="Label" type="Label" parent="SubViewport/GUI"]
anchors_preset = 0
offset_left = 32.0
offset_top = 160.0
offset_right = 224.0
offset_bottom = 192.0
text = "VIEWPORT"
horizontal_alignment = 1

[node name="Screen" type="MeshInstance3D" parent="."]
mesh = SubResource("QuadMesh_1")
surface_material_override/0 = SubResource("StandardMaterial3D_1")
