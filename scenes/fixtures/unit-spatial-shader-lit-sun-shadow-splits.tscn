[gd_scene format=3 uid="uid://unit_spatial_shader_lit_sun_shadow_splits"]

; The variables: a sun's two splits with blend, a max distance with its fade, and depth bias, beside
; an orthogonal sun with normal bias and opacity. They share the atlas, so each reads its own half.
; The other sun shadow golden has one sun at the defaults, so it shows no wrong half, blend or fade.

[sub_resource type="PlaneMesh" id="PlaneMesh_ground"]
size = Vector2(4, 4)

[sub_resource type="Shader" id="Shader_ground"]
code = "shader_type spatial;

void fragment() {
	ALBEDO = vec3(0.5);
	ROUGHNESS = 1.0;
}
"

