[gd_scene load_steps=4 format=3]

; The one variable: a precomposed character the font lacks, which HarfBuzz decomposes into a base
; and marks the font has (hb-ot-shape-normalize.cc) and so draws in that font. Montserrat holds basic
; Latin and the combining marks U+0300 to U+0308, U+030A and U+0323, and none of the precomposed
; characters of them. The Labels draw in Montserrat alone, so the line height is its own. The
; RichTextLabel falls back to Noto Sans, which holds Ç: that needs U+0327, which Montserrat lacks,
; so its whole cluster draws in Noto Sans.

[ext_resource type="FontFile" path="res://fonts/montserrat-semibold-marks-subset.ttf" id="2_plain"]
[ext_resource type="FontFile" path="res://fonts/noto-sans-regular-subset.ttf" id="3_noto"]

[sub_resource type="FontVariation" id="FontVariation_chain"]
base_font = ExtResource("2_plain")
fallbacks = Array[Font]([ExtResource("3_noto")])

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

