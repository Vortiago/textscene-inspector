[gd_scene format=3]

; `text_overrun_behavior` is the one variable. unit-label-2d.tscn never overruns a box, so no
; other scene reaches the cut-and-ellipsis path. The 80px box is too narrow for the sentence at
; either size, so each line is cut. TrimChar cuts at a character with no ellipsis, and
; TrimWordEllipsis cuts back to a word boundary and appends one.

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="TrimChar" type="Label" parent="."]
anchors_preset = 0
offset_left = 20.0
offset_top = 20.0
offset_right = 100.0
offset_bottom = 44.0
text = "This sentence is much wider than its box"
text_overrun_behavior = 1

[node name="TrimWordEllipsis" type="Label" parent="."]
anchors_preset = 0
offset_left = 20.0
offset_top = 60.0
offset_right = 100.0
offset_bottom = 84.0
text = "This sentence is much wider than its box"
text_overrun_behavior = 4

; `clip_text` alone, with `text_overrun_behavior` at NO_TRIMMING: its minimum width collapses to
; 1px, but the glyphs are not cut. Trimming this text too, or leaving the other two uncut, moves
; only this scene.
[node name="ClipOnly" type="Label" parent="."]
anchors_preset = 0
offset_left = 20.0
offset_top = 100.0
offset_right = 100.0
offset_bottom = 124.0
text = "This sentence is much wider than its box"
clip_text = true
