; One variable: `layout_direction = 3` on a ScrollContainer. The scrollbars are anchored
; children, so `Control::_size_changed` mirrors each whole (control.cpp:1785-1787) and the
; vertical bar moves to the left edge. The content goes through `fit_child_in_rect`, which does
; not mirror, so `_reposition_children` shifts it past the reserved strip (scroll_container.cpp:357-363).

[gd_scene format=3]

[node name="Root" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0.4, 1)

; The child overflows vertically only, so one bar shows and its strip is the whole horizontal
; move. unit-scroll-container.tscn moves overflow and offset at LTR, so neither half shows there.
[node name="Ltr" type="ScrollContainer" parent="."]
layout_mode = 1
offset_left = 40.0
offset_top = 40.0
offset_right = 240.0
offset_bottom = 160.0

[node name="Content" type="ColorRect" parent="Ltr"]
layout_mode = 2
custom_minimum_size = Vector2(60, 300)
color = Color(0.9, 0.2, 0.2, 1)

[node name="Rtl" type="ScrollContainer" parent="."]
layout_mode = 1
layout_direction = 3
offset_left = 40.0
offset_top = 180.0
offset_right = 240.0
offset_bottom = 300.0

[node name="Content" type="ColorRect" parent="Rtl"]
layout_mode = 2
custom_minimum_size = Vector2(60, 300)
color = Color(0.2, 0.7, 0.3, 1)
