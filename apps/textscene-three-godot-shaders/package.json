{
  "name": "@textscene/three-godot-shaders",
  "version": "0.0.0",
  "description": "Godot's scene shader as TSL node materials for a three.js WebGLRenderer, with no React. three.js is the only peer dependency.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.meta.json",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm --filter @textscene/core build",
    "build": "node scripts/build.mjs",
    "clean": "rimraf dist THIRD-PARTY-NOTICES.md",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "pretype-check": "pnpm --filter @textscene/core build && pnpm --filter @textscene/dev-kit build",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit"
  },
  "keywords": [
    "godot",
    "three.js",
    "tsl",
    "shaders",
    "node-materials",
    "godot4",
    "gamedev"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vortiago/textscene-inspector.git",
    "directory": "apps/textscene-three-godot-shaders"
  },
  "homepage": "https://github.com/Vortiago/textscene-inspector#readme",
  "bugs": {
    "url": "https://github.com/Vortiago/textscene-inspector/issues"
  },
  "peerDependencies": {
    "three": "catalog:"
  },
  "devDependencies": {
    "@textscene/core": "workspace:*",
    "@textscene/dev-kit": "workspace:*",
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "@typescript/native": "catalog:",
    "dts-bundle-generator": "catalog:",
    "esbuild": "catalog:",
    "rimraf": "catalog:",
    "three": "catalog:",
    "vitest": "catalog:"
  }
}
