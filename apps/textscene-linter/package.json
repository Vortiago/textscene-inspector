{
  "name": "@textscene/linter",
  "version": "1.0.0",
  "description": "Command-line linter for Godot .tscn scenes and .tres resources, with every check grounded in the Godot source.",
  "type": "module",
  "bin": {
    "tscn-lint": "./bin/tscn-lint.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.meta.json",
    "bin",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm --filter @textscene/core build",
    "build": "node scripts/build.mjs",
    "dev": "esbuild src/cli.ts src/index.ts --bundle --platform=node --format=esm --outdir=dist --external:commander --watch",
    "clean": "rimraf dist THIRD-PARTY-NOTICES.md",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "pretype-check": "pnpm --filter @textscene/core build && pnpm --filter @textscene/dev-kit build",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit"
  },
  "keywords": [
    "godot",
    "tscn",
    "tres",
    "linter",
    "validator",
    "cli",
    "godot4",
    "gamedev",
    "lint"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vortiago/textscene-inspector.git",
    "directory": "apps/textscene-linter"
  },
  "homepage": "https://github.com/Vortiago/textscene-inspector#readme",
  "bugs": {
    "url": "https://github.com/Vortiago/textscene-inspector/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "commander": "catalog:"
  },
  "devDependencies": {
    "@textscene/core": "workspace:*",
    "@textscene/dev-kit": "workspace:*",
    "@types/node": "catalog:",
    "dts-bundle-generator": "catalog:",
    "esbuild": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
