{
  "name": "@textscene/web-previewer",
  "version": "0.9.0",
  "private": true,
  "description": "Web-based text scene file inspector for development and debugging",
  "type": "module",
  "scripts": {
    "generate-fixtures": "node ../../scripts/generate-fixtures.js",
    "copy-fixtures": "node scripts/copy-fixtures.js",
    "stage-gallery": "node scripts/stage-gallery.mjs",
    "predev": "pnpm generate-fixtures && pnpm copy-fixtures && pnpm stage-gallery && pnpm --filter @textscene/core build",
    "dev": "vite",
    "prebuild": "pnpm generate-fixtures && pnpm copy-fixtures && pnpm stage-gallery && pnpm --filter @textscene/core build",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "pnpm generate-fixtures",
    "test": "vitest run",
    "pretype-check": "pnpm generate-fixtures && pnpm --filter @textscene/core build",
    "type-check": "tsc --noEmit",
    "pretype-check:tests": "pnpm generate-fixtures && pnpm --filter @textscene/core build",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "clean": "rimraf dist node_modules/.vite public/fixtures public/parity"
  },
  "keywords": [
    "tscn",
    "textscene",
    "text-scene",
    "inspector",
    "web",
    "3d"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vortiago/textscene-inspector.git",
    "directory": "apps/textscene-web"
  },
  "dependencies": {
    "@textscene/core": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "rimraf": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
