{
  "name": "@textscene/web-previewer",
  "version": "0.9.0",
  "private": true,
  "description": "Web-based text scene file inspector for development and debugging",
  "type": "module",
  "scripts": {
    "copy-fixtures": "node scripts/copy-fixtures.js",
    "predev": "pnpm copy-fixtures && pnpm --filter @textscene/core build",
    "dev": "vite",
    "prebuild": "pnpm copy-fixtures && pnpm --filter @textscene/core build",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pretype-check": "pnpm --filter @textscene/core build",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.vite public/fixtures"
  },
  "keywords": [
    "tscn",
    "textscene",
    "text-scene",
    "inspector",
    "web",
    "3d"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vortiago/textscene-inspector.git",
    "directory": "apps/textscene-web"
  },
  "dependencies": {
    "@textscene/core": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
