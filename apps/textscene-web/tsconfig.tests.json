{
  // The app tsconfig minus its test exclusions: vitest transpiles without
  // checking, so the suites need a project of their own to be typed at all.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "react", "react-dom"],
    // The manifest guard imports the fixture generator's category module, a repo-level `.mjs`.
    "allowJs": true
  },
  "exclude": ["node_modules", "dist"]
}
