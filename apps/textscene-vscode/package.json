{
  "name": "textscene-inspector",
  "displayName": "TextScene Inspector",
  "description": "Live 3D preview of Godot .tscn scene files in VS Code — no Godot install required. Renders meshes, PBR materials, lights and cameras via three.js, with a scene-tree inspector and a .tscn linter.",
  "version": "0.9.0",
  "publisher": "vortiago",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:tscn"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "contributes": {
    "languages": [
      {
        "id": "tscn",
        "extensions": [
          ".tscn"
        ],
        "aliases": [
          "TSCN"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tscn",
        "scopeName": "source.tscn",
        "path": "./syntaxes/tscn.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "textscene.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "TextScene",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "resourceExtname == .tscn",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "resourceExtname == .tscn",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "resourceExtname == .tscn",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "editorLangId == tscn || resourceExtname == .tscn"
        }
      ]
    },
    "keybindings": [
      {
        "command": "textscene.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == tscn"
      }
    ],
    "configuration": {
      "title": "TextScene Inspector",
      "properties": {
        "textscene.defaultViewportMode": {
          "type": "string",
          "enum": [
            "auto",
            "2D",
            "3D"
          ],
          "enumDescriptions": [
            "Match the Godot editor: pick 2D or 3D from the scene root's node type.",
            "Always open new previews in the 2D viewport.",
            "Always open new previews in the 3D viewport."
          ],
          "default": "auto",
          "description": "Viewport mode a newly-opened preview starts in. \"auto\" mirrors the Godot editor (a CanvasItem root opens 2D, a Node3D root opens 3D); an explicit mode overrides that for every newly-opened preview, though the viewport toolbar's 2D/3D toggle still works per-panel afterward. Already-open preview panels are unaffected until reopened."
        },
        "textscene.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Lint open .tscn files and report syntax and semantic issues in the Problems panel."
        },
        "textscene.diagnostics.lintDebounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Milliseconds to wait after the last edit before re-linting a .tscn document."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm --filter @textscene/core build && pnpm build -- --skip-tests",
    "prebuild": "pnpm --filter @textscene/core build",
    "build": "node esbuild.config.mjs --production --skip-tests",
    "build:dev": "node esbuild.config.mjs",
    "predev": "pnpm --filter @textscene/core build",
    "dev": "node esbuild.config.mjs --watch",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "pretest:integration": "pnpm --filter @textscene/core build && node esbuild.config.mjs && tsc -p tsconfig.test.json",
    "test:integration": "node ./dist/test/integration/runTests.js",
    "test:integration:debug": "node --inspect-brk ./dist/test/integration/runTests.js",
    "test:web": "vscode-test-web --browserType=chromium --headless --extensionDevelopmentPath=. .test-workspace-web",
    "pretype-check": "pnpm --filter @textscene/core build",
    "type-check": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish": "npx @vscode/vsce publish --no-dependencies",
    "clean": "rimraf dist out .test-workspace .vscode-test-web"
  },
  "keywords": [
    "godot",
    "godot tscn",
    "tscn",
    "tscn viewer",
    "tscn preview",
    "scene preview",
    "godot scene",
    "3d preview",
    "three.js",
    "textscene",
    "inspector",
    "viewer",
    "visualization"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vortiago/Text-Scene-.tscn-File-Previewer.git",
    "directory": "apps/textscene-vscode"
  },
  "homepage": "https://github.com/Vortiago/Text-Scene-.tscn-File-Previewer#readme",
  "bugs": {
    "url": "https://github.com/Vortiago/Text-Scene-.tscn-File-Previewer/issues"
  },
  "dependencies": {
    "@textscene/core": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@textscene/dev-kit": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "catalog:",
    "esbuild-css-modules-plugin": "^3.1.5",
    "glob": "^13.0.6",
    "happy-dom": "catalog:",
    "mocha": "^11.7.6",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
