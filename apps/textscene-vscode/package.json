{
  "name": "textscene-inspector",
  "displayName": "TextScene Inspector",
  "description": "Inspect and view text-based 3D scene files (.tscn) in VS Code with 3D rendering",
  "version": "0.0.1",
  "publisher": "vortiago",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:textscene.openPreviewToSide"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tscn",
        "extensions": [
          ".tscn"
        ],
        "aliases": [
          "TSCN",
          "Text Scene"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "textscene.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "TextScene",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "resourceExtname == .tscn",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "editorLangId == tscn || resourceExtname == .tscn"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm --filter @textscene/core build && pnpm build -- --skip-tests",
    "prebuild": "pnpm --filter @textscene/core build",
    "build": "node esbuild.config.mjs",
    "predev": "pnpm --filter @textscene/core build",
    "dev": "node esbuild.config.mjs --watch",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "pretest:integration": "pnpm build && tsc -p tsconfig.test.json",
    "test:integration": "node ./out/test/integration/runTests.js",
    "test:integration:debug": "node --inspect-brk ./out/test/integration/runTests.js",
    "pretype-check": "pnpm --filter @textscene/core build",
    "type-check": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish": "npx @vscode/vsce publish --no-dependencies",
    "clean": "rimraf dist out .test-workspace"
  },
  "keywords": [
    "tscn",
    "textscene",
    "text-scene",
    "inspector",
    "viewer",
    "3d",
    "visualization"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vortiago/tscn-file-previewer"
  },
  "dependencies": {
    "@textscene/core": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "catalog:",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "catalog:",
    "glob": "^11.0.3",
    "happy-dom": "catalog:",
    "mocha": "^11.7.5",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
