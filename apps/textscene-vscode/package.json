{
  "name": "textscene-inspector",
  "displayName": "TextScene Inspector: Godot .tscn Preview",
  "description": "Preview Godot .tscn scenes in 3D and 2D inside VS Code, without a Godot install. Renders meshes, PBR materials, lights and cameras with three.js, and adds a scene tree, an inspector and a .tscn linter.",
  "version": "1.0.0",
  "publisher": "vortiago",
  "keywords": [
    "godot",
    "godot engine",
    "godot4",
    "tscn",
    "scene",
    "3d",
    "preview",
    "gamedev",
    "linter",
    "three.js"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:tscn"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "contributes": {
    "languages": [
      {
        "id": "tscn",
        "extensions": [
          ".tscn",
          ".tres"
        ],
        "aliases": [
          "TSCN"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tscn",
        "scopeName": "source.tscn",
        "path": "./syntaxes/tscn.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "textscene.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "TextScene",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "resourceExtname == .tscn",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "resourceExtname == .tscn",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "resourceExtname == .tscn",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "resourceExtname == .tscn"
        }
      ]
    },
    "keybindings": [
      {
        "command": "textscene.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceExtname == .tscn"
      }
    ],
    "languageModelTools": [
      {
        "name": "textscene_lint",
        "displayName": "Lint a Godot .tscn scene",
        "toolReferenceName": "lintTscn",
        "modelDescription": "Lint a Godot .tscn scene and return its findings, each with a line, a severity, a message and a rule. Use after editing a scene, to check it without a Godot install.",
        "tags": [
          "godot",
          "tscn",
          "lint"
        ],
        "canBeReferencedInPrompt": true,
        "icon": "$(checklist)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The .tscn file: a workspace-relative path, or an absolute one."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "textscene_scene_tree",
        "displayName": "Read a Godot .tscn scene tree",
        "toolReferenceName": "tscnSceneTree",
        "modelDescription": "Return a Godot .tscn scene's node hierarchy as indented text, each node with its type. Use to understand a scene's structure without reading the raw file.",
        "tags": [
          "godot",
          "tscn",
          "scene tree"
        ],
        "canBeReferencedInPrompt": true,
        "icon": "$(list-tree)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The .tscn file: a workspace-relative path, or an absolute one."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "textscene_open_preview",
        "displayName": "Open the Godot .tscn preview",
        "toolReferenceName": "openTscnPreview",
        "modelDescription": "Open the TextScene 3D/2D preview for a Godot .tscn scene beside the editor, so the user sees the scene render.",
        "tags": [
          "godot",
          "tscn",
          "preview"
        ],
        "canBeReferencedInPrompt": true,
        "icon": "$(open-preview)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The .tscn file: a workspace-relative path, or an absolute one."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "textscene_missing_resources",
        "displayName": "List a Godot .tscn scene's missing resources",
        "toolReferenceName": "tscnMissingResources",
        "modelDescription": "List the res:// resources a Godot .tscn scene references that the project does not hold.",
        "tags": [
          "godot",
          "tscn",
          "resources"
        ],
        "canBeReferencedInPrompt": true,
        "icon": "$(warning)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The .tscn file: a workspace-relative path, or an absolute one."
            }
          },
          "required": [
            "path"
          ]
        }
      }
    ],
    "configuration": {
      "title": "TextScene Inspector",
      "properties": {
        "textscene.defaultViewportMode": {
          "type": "string",
          "enum": [
            "auto",
            "2D",
            "3D"
          ],
          "enumDescriptions": [
            "Match the Godot editor: pick 2D or 3D from the scene root's node type.",
            "Always open new previews in the 2D viewport.",
            "Always open new previews in the 3D viewport."
          ],
          "default": "auto",
          "description": "The viewport a new preview opens in. \"auto\" follows the Godot editor: a CanvasItem root opens in 2D, and a Node3D root in 3D. \"2D\" and \"3D\" force that viewport. The 2D/3D toggle in each preview still works, and open previews keep their viewport until you reopen them."
        },
        "textscene.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Lint open .tscn files and report syntax and semantic issues in the Problems panel."
        },
        "textscene.diagnostics.lintDebounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Milliseconds to wait after the last edit before re-linting a .tscn document."
        },
        "textscene.agentTools.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Register tools a coding agent in chat can call: lint a scene, read its node tree, open its preview, and list its missing resources. Turn off to keep the extension out of agent tool lists."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm --filter @textscene/core build && pnpm build -- --skip-tests",
    "prebuild": "pnpm --filter @textscene/core build",
    "build": "node esbuild.config.mjs --production --skip-tests",
    "build:dev": "node esbuild.config.mjs",
    "predev": "pnpm --filter @textscene/core build",
    "dev": "node esbuild.config.mjs --watch",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "pretest:integration": "pnpm --filter @textscene/core build && node esbuild.config.mjs && tsc -p tsconfig.test.json",
    "test:integration": "node ./dist/test/integration/runTests.js",
    "test:integration:debug": "node --inspect-brk ./dist/test/integration/runTests.js",
    "pretest:installed": "pnpm --filter @textscene/core build && node esbuild.config.mjs && tsc -p tsconfig.test.json",
    "test:installed": "node ./dist/test/installed/runInstalledTests.js",
    "pretest:web": "pnpm --filter @textscene/core build && node esbuild.config.mjs && tsc -p tsconfig.test.json",
    "test:web": "node ./dist/test/web/runWebTests.js",
    "pretype-check": "pnpm --filter @textscene/core build",
    "type-check": "tsc --noEmit",
    "pretype-check:tests": "pnpm --filter @textscene/core build",
    "type-check:tests": "tsc --noEmit -p tsconfig.unit-tests.json",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish": "npx @vscode/vsce publish --no-dependencies",
    "clean": "rimraf dist out .test-workspace .vscode-test-web"
  },
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vortiago/textscene-inspector.git",
    "directory": "apps/textscene-vscode"
  },
  "homepage": "https://github.com/Vortiago/textscene-inspector#readme",
  "bugs": {
    "url": "https://github.com/Vortiago/textscene-inspector/issues"
  },
  "dependencies": {
    "@textscene/core": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@textscene/dev-kit": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "catalog:",
    "@vscode/test-web": "catalog:",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "catalog:",
    "esbuild-css-modules-plugin": "^3.1.5",
    "glob": "^13.0.6",
    "happy-dom": "catalog:",
    "mocha": "^12.0.2",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
