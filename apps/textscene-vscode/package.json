{
  "name": "textscene-inspector",
  "displayName": "TextScene Inspector",
  "description": "Inspect and view text-based 3D scene files (.tscn) in VS Code with 3D rendering",
  "version": "0.9.0",
  "publisher": "vortiago",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:tscn"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "contributes": {
    "languages": [
      {
        "id": "tscn",
        "extensions": [
          ".tscn"
        ],
        "aliases": [
          "TSCN"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "textscene.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "TextScene",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "resourceExtname == .tscn",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "textscene.openPreviewToSide",
          "when": "editorLangId == tscn || resourceExtname == .tscn"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm --filter @textscene/core build && pnpm build -- --skip-tests",
    "prebuild": "pnpm --filter @textscene/core build",
    "build": "node esbuild.config.mjs --production --skip-tests",
    "build:dev": "node esbuild.config.mjs",
    "predev": "pnpm --filter @textscene/core build",
    "dev": "node esbuild.config.mjs --watch",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "pretest:integration": "pnpm build && tsc -p tsconfig.test.json",
    "test:integration": "node ./out/test/integration/runTests.js",
    "test:integration:debug": "node --inspect-brk ./out/test/integration/runTests.js",
    "test:web": "vscode-test-web --browserType=chromium --headless --extensionDevelopmentPath=. .test-workspace-web",
    "pretype-check": "pnpm --filter @textscene/core build",
    "type-check": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish": "npx @vscode/vsce publish --no-dependencies",
    "clean": "rimraf dist out .test-workspace .vscode-test-web"
  },
  "keywords": [
    "tscn",
    "textscene",
    "text-scene",
    "inspector",
    "viewer",
    "3d",
    "visualization"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vortiago/Text-Scene-.tscn-File-Previewer.git",
    "directory": "apps/textscene-vscode"
  },
  "homepage": "https://github.com/Vortiago/Text-Scene-.tscn-File-Previewer#readme",
  "bugs": {
    "url": "https://github.com/Vortiago/Text-Scene-.tscn-File-Previewer/issues"
  },
  "dependencies": {
    "@textscene/core": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "catalog:",
    "esbuild-css-modules-plugin": "^3.1.5",
    "glob": "^11.0.3",
    "happy-dom": "catalog:",
    "mocha": "^11.7.5",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
