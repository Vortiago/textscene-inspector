{
  "name": "@textscene/lsp",
  "version": "1.0.0",
  "description": "Language server for Godot .tscn scenes and .tres resources: diagnostics, hover, completion, quick fixes, go to definition, find all references, res:// links, document symbols, highlights and folding. Works in any LSP client, such as Neovim, Helix, Zed, Emacs and Sublime Text.",
  "type": "module",
  "bin": {
    "tscn-lsp": "./bin/tscn-lsp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.meta.json",
    "bin",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm --filter @textscene/core build",
    "build": "node scripts/build.mjs",
    "dev": "esbuild src/server.ts src/index.ts --bundle --platform=node --format=esm --outdir=dist --external:vscode-languageserver --external:vscode-languageserver-textdocument --watch",
    "clean": "rimraf dist THIRD-PARTY-NOTICES.md",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "pretype-check": "pnpm --filter @textscene/core build && pnpm --filter @textscene/dev-kit build",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit"
  },
  "keywords": [
    "godot",
    "tscn",
    "lsp",
    "language-server",
    "neovim",
    "helix",
    "zed",
    "tres",
    "godot4",
    "gamedev",
    "language-server-protocol",
    "vim",
    "emacs",
    "sublime-text",
    "diagnostics",
    "autocomplete"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vortiago/textscene-inspector.git",
    "directory": "apps/textscene-lsp"
  },
  "homepage": "https://github.com/Vortiago/textscene-inspector#readme",
  "bugs": {
    "url": "https://github.com/Vortiago/textscene-inspector/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "vscode-languageserver": "catalog:",
    "vscode-languageserver-textdocument": "catalog:"
  },
  "devDependencies": {
    "@textscene/core": "workspace:*",
    "@textscene/dev-kit": "workspace:*",
    "@types/node": "catalog:",
    "dts-bundle-generator": "catalog:",
    "esbuild": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
