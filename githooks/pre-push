#!/usr/bin/env sh
# Run the static checks and the tests beside the pushed changes. CI runs the full gate.
# `FULL_VALIDATE=1 git push` runs the full `pnpm validate` here too.

# HUSKY=0 skips the hook. Existing tools already set that name.
[ "${HUSKY-}" = "0" ] && exit 0

exec node "$(git rev-parse --show-toplevel)/scripts/githooks/prePush.mjs"
