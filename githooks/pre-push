#!/usr/bin/env sh
# Full validation gate before code leaves the machine: build, type-check, lint,
# all tests and bundle size. It mirrors CI, so nothing reaches a shared branch
# unvalidated. The fast per-file checks already ran on pre-commit.

# HUSKY=0 skips the hook: the switch that existing callers already set.
[ "${HUSKY-}" = "0" ] && exit 0

pnpm validate
