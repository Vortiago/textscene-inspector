# On-demand open-source games corpus — fetched locally with `pnpm vendor:games`,
# never committed (keeps the repo lean). The generated games manifest is written
# alongside the base manifest and merged at runtime by fixturesAll.ts.
/scenes/games/
apps/textscene-web/src/fixtures.games.ts

# Optional ld-58 corpus — vendored locally with `pnpm vendor:ld58`, never
# committed. Its manifest is generated alongside the base one and merged at
# runtime by fixturesAll.ts.
/scenes/ld58/
apps/textscene-web/src/fixtures.ld58.ts

