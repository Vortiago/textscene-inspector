{
  "name": "textscene-inspector",
  "version": "0.0.1",
  "private": true,
  "description": "A monorepo for TextScene Inspector - view and navigate text-based 3D scene files",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @textscene/core build && pnpm -r build",
    "build:linter": "pnpm --filter @textscene/linter build",
    "dev:web": "pnpm --filter @textscene/web-previewer dev",
    "dev:vscode": "pnpm --filter textscene-inspector dev",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "preview:test": "pnpm --filter @textscene/web-previewer preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:tscn": "node apps/textscene-linter/bin/tscn-lint.js",
    "type-check": "pnpm -r type-check",
    "type-check:all": "pnpm --filter @textscene/core build && pnpm -r type-check",
    "validate": "pnpm build && pnpm type-check && pnpm lint && pnpm test:unit",
    "generate:fixtures": "node scripts/generate-fixtures.js",
    "clean": "pnpm -r clean && rimraf node_modules",
    "vsc:package": "pnpm --filter textscene-inspector package",
    "vsc:install": "pnpm vsc:package && code --install-extension apps/textscene-vscode/textscene-inspector-0.0.1.vsix --force",
    "vsc:publish": "pnpm --filter textscene-inspector publish",
    "prepare": "husky"
  },
  "keywords": [
    "tscn",
    "textscene",
    "text-scene",
    "3d",
    "inspector",
    "viewer",
    "vscode",
    "three.js"
  ],
  "author": "Vortiago",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "^9.18.0",
    "globals": "^16.4.0",
    "happy-dom": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "vitest related --run"
    ],
    "*.tscn": [
      "pnpm build:linter",
      "node apps/textscene-linter/dist/cli.js"
    ]
  }
}
