
# Vendored game and demo corpora: exclude them from language stats and diffs by default.
scenes/demos/** linguist-vendored
scenes/isometric/** linguist-vendored

# answers.json gives each expected position as a line and a character, so a CRLF checkout would move them.
scenes/language-features/**/*.tscn text eol=lf
scenes/language-features/**/*.godot text eol=lf
scenes/language-features/**/*.tres text eol=lf
scenes/language-features/**/*.json text eol=lf
